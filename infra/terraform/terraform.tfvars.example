# Copy to terraform.tfvars and fill in from your OCI account (never commit the real file).
tenancy_ocid     = "ocid1.tenancy.oc1..aaaa..."
user_ocid        = "ocid1.user.oc1..aaaa..."
fingerprint      = "aa:bb:cc:..."
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"
compartment_ocid = "ocid1.tenancy.oc1..aaaa..." # root compartment is fine for a personal account
ssh_public_key   = "ssh-ed25519 AAAA... you@machine"
