# ResearchScout configuration. Copy to `.env` and adjust. Env var prefix: RS_
RS_DATABASE_URL=postgresql+psycopg://researchscout:researchscout@localhost:5432/researchscout
RS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RS_LLM_BASE_URL=http://localhost:11434/v1
RS_LLM_MODEL=qwen2.5:3b-instruct
# Any OpenAI-compatible provider key; Ollama ignores it, cloud providers require theirs.
RS_LLM_API_KEY=ollama
RS_FRESHNESS_DAYS=30
# OIDC resource-server validation (Keycloak). The jwks override is for container networks
# where the browser-facing issuer host is not reachable from inside.
RS_OIDC_ISSUER=http://localhost:8080/realms/researchscout
RS_OIDC_AUDIENCE=api
#RS_OIDC_JWKS_URL=http://keycloak:8080/realms/researchscout/protocol/openid-connect/certs
