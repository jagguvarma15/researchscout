# ResearchScout configuration. Copy to `.env` and adjust. Env var prefix: RS_
RS_DATABASE_URL=postgresql+psycopg://researchscout:researchscout@localhost:5432/researchscout
RS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RS_LLM_BASE_URL=http://localhost:11434/v1
RS_LLM_MODEL=qwen2.5:3b-instruct
# Containers can't reach the host's localhost — compose uses this for the api service instead
# (defaults to host.docker.internal for host Ollama). Set it when using a cloud provider.
#RS_LLM_BASE_URL_DOCKER=https://api.openai.com/v1
# Any OpenAI-compatible provider key; Ollama ignores it, cloud providers require theirs.
RS_LLM_API_KEY=ollama
RS_FRESHNESS_DAYS=30
# OIDC resource-server validation (Keycloak). The jwks override is for container networks
# where the browser-facing issuer host is not reachable from inside.
RS_OIDC_ISSUER=http://localhost:8080/realms/researchscout
RS_OIDC_AUDIENCE=api
#RS_OIDC_JWKS_URL=http://keycloak:8080/realms/researchscout/protocol/openid-connect/certs
# Rate limiting / caching
RS_REDIS_URL=redis://localhost:6379
RS_CHAT_RATE_LIMIT=20
RS_CHAT_RATE_WINDOW_SECONDS=600
# Event plane (compose publishes Kafka on 29092 for the host; containers use kafka:9092)
RS_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Airtable reading-list sync (worker refuses to start without these)
#RS_AIRTABLE_API_KEY=pat...
#RS_AIRTABLE_BASE_ID=app...
RS_AIRTABLE_SAVED_TABLE=Saved papers
RS_AIRTABLE_WATCHLIST_TABLE=Watchlist
RS_AIRTABLE_DIGEST_TABLE=Digest archive
# Digest defaults
RS_DIGEST_DAYS=7
RS_DIGEST_TOP_K=10
# Background refresh loop (`scout serve scheduler`, opt-in `scheduler` compose profile).
# Intervals are in seconds; the ingest/signals look-back window is in days.
RS_SCHEDULER_INGEST_WINDOW_DAYS=2
RS_SCHEDULER_INGEST_INTERVAL_SEC=3600
RS_SCHEDULER_INDEX_INTERVAL_SEC=900
RS_SCHEDULER_SIGNALS_INTERVAL_SEC=21600
RS_SCHEDULER_DIGEST_INTERVAL_SEC=86400
RS_SCHEDULER_TICK_SEC=30
# Optional cross-encoder reranking of search results (off by default; adds a small CPU model).
#RS_RERANK_ENABLED=true
RS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RS_RERANK_TOP_N=40
# Emerging-topic clustering (rebuilt daily by the scheduler; also `scout topics build`).
RS_CLUSTER_WINDOW_DAYS=30
RS_CLUSTER_DISTANCE_THRESHOLD=0.5
RS_SCHEDULER_TOPICS_INTERVAL_SEC=86400
# Agentic ask: decompose the question into sub-questions and follow one hop of references (slower).
#RS_AGENTIC_ASK=true
# Observability: `make start-obs` runs the obs profile and flips this to true. With the
# obs profile down, keep it false — services log export errors against a missing collector.
RS_OTEL_ENABLED=false
RS_OTLP_ENDPOINT=http://localhost:4317
# LangSmith LLM tracing (standard LangSmith env vars)
#LANGSMITH_TRACING=true
#LANGSMITH_API_KEY=lsv2_...
#LANGSMITH_PROJECT=researchscout
