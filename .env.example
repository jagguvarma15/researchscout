# ResearchScout configuration. Copy to `.env` and adjust. Env var prefix: RS_
RS_DATABASE_URL=postgresql+psycopg://researchscout:researchscout@localhost:5432/researchscout
RS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RS_LLM_BASE_URL=http://localhost:11434/v1
RS_LLM_MODEL=qwen2.5:3b-instruct
# Any OpenAI-compatible provider key; Ollama ignores it, cloud providers require theirs.
RS_LLM_API_KEY=ollama
RS_FRESHNESS_DAYS=30
# Pause between arXiv API pages during ingest (arXiv asks for ~3s; 0 disables)
RS_ARXIV_PAGE_DELAY_SEC=3.0
# Auth. Unset (the default) = local no-auth mode with a built-in user. Set an issuer to turn
# the API into an OIDC resource server that requires Bearer tokens.
#RS_OIDC_ISSUER=https://your-tenant.us.auth0.com/
#RS_OIDC_AUDIENCE=api
#RS_OIDC_JWKS_URL=
# The terms version people are asked to accept. Bumping it sends every account back through
# the acceptance dialog on their next visit, so change it only when the terms change.
RS_TERMS_VERSION=2026-08-01
# Deleting an account must also delete the login at the provider. These are an Auth0
# machine-to-machine application with the delete:users scope; with an issuer set but these
# empty, DELETE /v1/me refuses rather than leaving the identity behind.
#RS_AUTH0_DOMAIN=your-tenant.us.auth0.com
#RS_AUTH0_MGMT_CLIENT_ID=
#RS_AUTH0_MGMT_CLIENT_SECRET=
# Chat rate limiting (in-process fixed window)
RS_CHAT_RATE_LIMIT=20
RS_CHAT_RATE_WINDOW_SECONDS=600
# Signed-out callers get the extractive answer only, on a tighter budget keyed by address.
RS_CHAT_RATE_LIMIT_ANONYMOUS=5
# Concurrent model generations, and how long to wait for a slot before answering 503. The
# model shares this machine with Postgres and the API.
RS_LLM_MAX_CONCURRENCY=2
RS_LLM_QUEUE_TIMEOUT_SECONDS=20
# LLM scope pre-check for /v1/chat (fails open; set false to skip the extra LLM round-trip)
RS_CHAT_GUARDRAIL=true
# Web-search fallback on not-found chat answers (default on; kill switch). S2_API_KEY helps.
#RS_WEB_SEARCH_ENABLED=true
#RS_WEB_SEARCH_RATE_LIMIT=10
#RS_WEB_SEARCH_RATE_WINDOW_SECONDS=60
# Digest defaults
RS_DIGEST_DAYS=7
RS_DIGEST_TOP_K=10
# Background refresh loop (`scout serve scheduler`, or `make scheduler`).
# Intervals are in seconds; the ingest/signals look-back window is in days.
#
# Wall-clock scheduling, as comma-separated HH:MM times in RS_SCHEDULER_TIMEZONE. Empty (the
# default) leaves every task on its interval, which is what a local checkout wants. Set them and
# the named tasks run at those times instead. A named zone rather than a fixed offset, so the
# runs stay put on the local clock across daylight saving. No catch-up for a slot missed while
# the process was down: the ingest window covers it, and firing on start-up would mean a restart
# loop hammering arXiv.
#RS_SCHEDULER_PIPELINE_AT=05:00,10:00,14:00,17:00
#RS_SCHEDULER_DAILY_AT=17:00
RS_SCHEDULER_TIMEZONE=America/New_York
# Ingest, embedding, full text and signals normally come from the streaming pipeline
# (`make start` runs it). Turn this on for an install that does not run the stream -
# without it, such an install never sees another paper. Never both: two processes
# fetching from the same upstreams on one address is what arXiv's floor cannot survive.
RS_SCHEDULER_BATCH_PIPELINE=false
RS_SCHEDULER_INGEST_WINDOW_DAYS=2
RS_SCHEDULER_INGEST_INTERVAL_SEC=3600
RS_SCHEDULER_INDEX_INTERVAL_SEC=900
RS_SCHEDULER_SIGNALS_INTERVAL_SEC=21600
RS_SCHEDULER_DIGEST_INTERVAL_SEC=86400
# Model and benchmark catalogue refresh (also `scout catalog`). Both upstreams are keyless.
RS_SCHEDULER_CATALOG_INTERVAL_SEC=86400
RS_SCHEDULER_TICK_SEC=30
# Optional cross-encoder reranking of search results (off by default; adds a small CPU model).
#RS_RERANK_ENABLED=true
RS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RS_RERANK_TOP_N=40
# Fast-answer found floor on the cross-encoder sigmoid scale (rerank scored the hits).
#RS_ASK_MIN_RELEVANCE=0.30
# The same floor on the cosine scale (rerank off or skipped): bge-small off-topic tops out
# near 0.62, on-topic starts near 0.76.
#RS_ASK_MIN_SIMILARITY=0.68
# Cross-encoder inside fast extractive answers. false cuts most of a fast answer's latency
# (about 600ms warm, seconds under memory pressure) and leans on the cosine floor instead;
# LLM answers keep following RS_RERANK_ENABLED either way.
#RS_ASK_FAST_RERANK=true
# Emerging-topic clustering (rebuilt daily by the scheduler; also `scout topics build`).
# Algo "hdbscan" needs no fixed cluster count and leaves outliers unclustered (excluded from
# topics); the distance threshold applies to the default agglomerative algo only.
RS_CLUSTER_WINDOW_DAYS=30
RS_CLUSTER_DISTANCE_THRESHOLD=0.5
RS_CLUSTER_ALGO=agglomerative
RS_SCHEDULER_TOPICS_INTERVAL_SEC=86400
# Agentic ask: decompose the question into sub-questions and follow one hop of references (slower).
#RS_AGENTIC_ASK=true
# Chunk-level retrieval: a third search leg over full-text chunks plus quoted excerpts in
# answers. Needs `scout fulltext` and `scout index --chunks` first.
#RS_CHUNK_RETRIEVAL=true
# For You v2 (0 = legacy interests-only feed). Centroids cluster saved papers + interests and
# name the "why this paper" reason; MMR lambda under 1.0 trades relevance for diversity;
# explore slots surface high-momentum papers outside the profile.
#RS_FORYOU_CENTROIDS=3
#RS_FORYOU_MMR_LAMBDA=0.75
#RS_FORYOU_EXPLORE_SLOTS=2
#RS_FORYOU_HALF_LIFE_DAYS=75

# Streaming pipeline (Kafka + Bytewax). The broker is a brew-installed host process managed by
# make (kafka-start / kafka-stop; data in .local/kafka-logs, config rendered by make setup).
# Topics: rs.raw.v1 (7 day retention), rs.parsed.v1 / rs.enriched.v1 (3 day observability taps).
# RS_KAFKA_* and RS_STREAM_* knobs are documented here as the stream stages land; the manual
# batch fallback stays: scout ingest / scout index / scout fulltext.
#RS_KAFKA_BOOTSTRAP=localhost:9092
#RS_KAFKA_TOPIC_PREFIX=rs
#RS_STREAM_CONSUMER_GROUP=rs-stream
#RS_STREAM_RECOVERY_DIR=.local/stream-recovery
#RS_STREAM_CONSUMER_BATCH=100
# false skips the parsed/enriched tap topics (scout stream tail goes dark while off).
#RS_STREAM_TAPS_ENABLED=true
# Producer cadence: content polls hourly; fulltext fetches modest batches every 15 minutes
# (signal sources reuse RS_SCHEDULER_SIGNALS_INTERVAL_SEC).
#RS_STREAM_POLL_INTERVAL_SEC=3600
#RS_STREAM_FULLTEXT_INTERVAL_SEC=900
#RS_STREAM_FULLTEXT_BATCH=25
# Producer dedup (default on): skip re-publishing papers the stream already enriched;
# false restores the republish-the-whole-window behavior (idempotent but slow).
#RS_STREAM_PUBLISH_DEDUP=true
#RS_STREAM_DEDUP_OVERLAP_DAYS=1
# Categorize stage: topic-match floor, keyword extraction floor, LLM fallback for weak
# extractions, and the custom-label classifier over config/labels.yaml (off by default).
#RS_STREAM_TOPIC_MATCH_MIN=0.55
#RS_STREAM_KEYWORD_MIN_SIMILARITY=0.35
#RS_STREAM_KEYWORD_CANDIDATES=80
# static scores keyword candidates with model2vec potion-base-8M (uv sync --extra static-embed).
#RS_STREAM_KEYWORD_EMBEDDER=bge
#RS_STREAM_KEYWORDS_LLM_FALLBACK=true
#RS_STREAM_LABELS_ENABLED=true
#RS_LABELS_CONFIG_PATH=config/labels.yaml
# Daily report task interval (the report itself needs no LLM).
#RS_SCHEDULER_REPORT_INTERVAL_SEC=86400

# A shared secret the site's own server sends with every API call. Empty (the default)
# leaves the API open, which is what a local install wants; set it once the API has a
# public hostname, and anything arriving without it gets a 404 rather than a 403.
RS_SERVICE_TOKEN=
