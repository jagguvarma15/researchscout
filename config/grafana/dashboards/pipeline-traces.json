{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Trace detail",
      "description": "All lineage stamps for the selected event, in execution order",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": false}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "outcome"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {"color": "green", "index": 0},
                      "error": {"color": "red", "index": 1},
                      "skipped": {"color": "yellow", "index": 2}
                    }
                  }
                ]
              },
              {"id": "custom.cellOptions", "value": {"type": "color-background"}}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "sortBy": []},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT stage, kind, source, outcome, entered_at, exited_at, round(extract(epoch FROM exited_at - entered_at)::numeric, 3) AS seconds, category, topic, paper_id, error FROM pipeline_lineage WHERE event_id = '$event_id' ORDER BY entered_at"
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Stage durations",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {"mode": "continuous-GrYlRd"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": true, "calcs": ["lastNotNull"], "fields": "/^seconds$/"},
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT stage, extract(epoch FROM exited_at - entered_at) AS seconds FROM pipeline_lineage WHERE event_id = '$event_id' ORDER BY entered_at"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Recent traces",
      "description": "One row per event with the outcome of each stage; click an event id to open its trace",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true}
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": "^(produce|parse|categorize|inject)$"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {"color": "green", "index": 0},
                      "error": {"color": "red", "index": 1},
                      "skipped": {"color": "yellow", "index": 2}
                    }
                  }
                ]
              },
              {"id": "custom.cellOptions", "value": {"type": "color-background"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "event_id"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "/d/rs-pipeline-traces/traces?var-event_id=${__data.fields.event_id}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {"showHeader": true, "sortBy": []},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT event_id, min(entered_at) AS started_at, max(kind) AS kind, max(source) AS source, max(CASE WHEN stage = 'produce' THEN outcome END) AS produce, max(CASE WHEN stage = 'parse' THEN outcome END) AS parse, max(CASE WHEN stage = 'categorize' THEN outcome END) AS categorize, max(CASE WHEN stage = 'inject' THEN outcome END) AS inject, round(extract(epoch FROM max(coalesce(exited_at, entered_at)) - min(entered_at))::numeric, 3) AS total_seconds, max(paper_id) AS paper_id FROM pipeline_lineage WHERE $__timeFilter(entered_at) GROUP BY event_id HAVING bool_or(outcome LIKE '$outcome') ORDER BY started_at DESC LIMIT 100"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent errors",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "event_id"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "/d/rs-pipeline-traces/traces?var-event_id=${__data.fields.event_id}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {"showHeader": true, "sortBy": []},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT event_id, stage, kind, source, coalesce(exited_at, entered_at) AS at, error FROM pipeline_lineage WHERE outcome = 'error' AND $__timeFilter(coalesce(exited_at, entered_at)) ORDER BY at DESC LIMIT 50"
        }
      ]
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
