            "barAlignment": 0,
            "stacking": {"mode": "normal", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT $__timeGroup(observed_at, '1d') AS \"time\", type AS metric, count(*) AS observations FROM signals WHERE $__timeFilter(observed_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
