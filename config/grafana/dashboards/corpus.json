    {
      "id": 7,
      "type": "timeseries",
      "title": "Papers per day",
      "description": "Published is the arXiv publication date; ingested is when the paper first landed here",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {"mode": "none", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT $__timeGroup(published_at, '1d') AS \"time\", count(*) AS published FROM papers WHERE $__timeFilter(published_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT $__timeGroup(created_at, '1d') AS \"time\", count(*) AS ingested FROM papers WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
