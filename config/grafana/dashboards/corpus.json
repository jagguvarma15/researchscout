    {
      "id": 9,
      "type": "bargauge",
      "title": "Enrichment coverage",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 25},
              {"color": "green", "value": 60}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": true, "calcs": ["lastNotNull"], "fields": "/^pct$/"},
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT 'keywords' AS what, 100.0 * count(*) FILTER (WHERE keywords IS NOT NULL AND jsonb_array_length(keywords) > 0) / nullif(count(*), 0) AS pct FROM papers UNION ALL SELECT 'full text', 100.0 * count(*) FILTER (WHERE full_text IS NOT NULL AND full_text <> '') / nullif(count(*), 0) FROM papers UNION ALL SELECT 'embeddings', 100.0 * (SELECT count(DISTINCT paper_id) FROM paper_embeddings) / nullif(count(*), 0) FROM papers"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Topics by size",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 13},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": false}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "trend"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "new": {"color": "blue", "index": 0},
                      "rising": {"color": "green", "index": 1},
                      "steady": {"color": "text", "index": 2},
                      "fading": {"color": "orange", "index": 3}
                    }
                  }
                ]
              },
              {"id": "custom.cellOptions", "value": {"type": "color-text"}}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "sortBy": []},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT label, size, trend, round(score::numeric, 3) AS score, built_at FROM topics ORDER BY size DESC LIMIT 15"
        }
      ]
    }
