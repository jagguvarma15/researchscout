{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL",
      "description": "The ResearchScout database, reached through Private Data Source Connect.",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Is anything still arriving, and how enriched is it once it does. The staleness stat at the top left is the one to watch: a deployment whose scheduler has no fetch tasks looks entirely healthy everywhere else.",
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Hours since the newest paper",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 72
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT round(EXTRACT(EPOCH FROM (now() - max(published_at))) / 3600.0) AS hours\nFROM papers\n"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Last ingest wrote a row",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT max(created_at) AS last_row FROM papers"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Papers in range",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT count(*) AS papers FROM papers WHERE $__timeFilter(created_at)"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Out of scope",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT count(*) AS out_of_scope FROM papers\nWHERE NOT (paper_archives(categories) && ARRAY['cs','eess','math','math-ph','stat'])\n"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Papers ingested per day",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT $__timeGroup(created_at, '1d') AS \"time\", count(*) AS ingested\nFROM papers WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1\n"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Papers published per day, by archive",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT $__timeGroup(published_at, '1d') AS \"time\",\n       archive AS metric, count(*) AS papers\nFROM papers, LATERAL unnest(paper_archives(categories)) AS archive\nWHERE $__timeFilter(published_at) AND archive IN ('cs','stat','eess','math')\nGROUP BY 1, 2 ORDER BY 1\n"
        }
      ],
      "id": 6
    },
    {
      "type": "bargauge",
      "title": "Enrichment coverage",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 40
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT 'embedded' AS what,\n       100.0 * count(*) FILTER (WHERE e.paper_id IS NOT NULL) / greatest(count(*), 1) AS pct\nFROM papers p LEFT JOIN (SELECT DISTINCT paper_id FROM paper_embeddings) e ON e.paper_id = p.id\nUNION ALL\nSELECT 'full text',\n       100.0 * count(*) FILTER (WHERE full_text IS NOT NULL AND full_text <> '')\n       / greatest(count(*), 1) FROM papers\nUNION ALL\nSELECT 'keywords',\n       100.0 * count(*) FILTER (WHERE keywords IS NOT NULL) / greatest(count(*), 1) FROM papers\nUNION ALL\nSELECT 'chunked',\n       100.0 * count(*) FILTER (WHERE c.paper_id IS NOT NULL) / greatest(count(*), 1)\nFROM papers p LEFT JOIN (SELECT DISTINCT paper_id FROM paper_chunks) c ON c.paper_id = p.id\n"
        }
      ],
      "id": 7
    },
    {
      "type": "table",
      "title": "Days with nothing ingested",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT day::date AS day\nFROM generate_series(now() - interval '21 days', now(), interval '1 day') AS day\nWHERE NOT EXISTS (\n  SELECT 1 FROM papers WHERE date_trunc('day', created_at) = date_trunc('day', day)\n)\nORDER BY day DESC\n"
        }
      ],
      "id": 8
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "researchscout",
    "ingest"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Ingest health",
  "uid": "rs-ingest",
  "version": 1,
  "weekStart": ""
}
