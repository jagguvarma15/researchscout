          "rawSql": "SELECT bucket AS \"time\", outcome AS metric, sum(packets) AS packets FROM pipeline_rollups_hourly WHERE $__timeFilter(bucket) AND kind LIKE '$kind' AND source LIKE '$source' GROUP BY 1, 2 ORDER BY 1"
