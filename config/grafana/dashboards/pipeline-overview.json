        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "researchscout-pg"
          },
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE outcome = 'error') / nullif(count(*), 0) AS error_pct FROM pipeline_lineage WHERE $__timeFilter(coalesce(exited_at, entered_at)) AND kind LIKE '$kind' AND source LIKE '$source'"
        }
      ]
    },
