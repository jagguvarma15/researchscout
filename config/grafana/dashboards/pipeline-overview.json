      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "researchscout-pg"
          },
          "rawSql": "SELECT date_trunc('hour', p.entered_at) AS \"time\", percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM p.entered_at - pr.exited_at)) AS \"p50\", percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM p.entered_at - pr.exited_at)) AS \"p95\" FROM pipeline_lineage p JOIN pipeline_lineage pr ON pr.event_id = p.event_id AND pr.stage = 'produce' WHERE p.stage = 'parse' AND $__timeFilter(p.entered_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "description": "Produce exit to parse entry: the time packets sit in Kafka behind the backlog"
    },
