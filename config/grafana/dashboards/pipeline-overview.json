    {
      "id": 1,
      "type": "stat",
      "title": "Packets by stage",
      "datasource": {
        "type": "postgres",
        "uid": "researchscout-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^packets$/"
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "researchscout-pg"
          },
          "rawSql": "SELECT stage, count(*) AS packets FROM pipeline_lineage WHERE $__timeFilter(coalesce(exited_at, entered_at)) AND kind LIKE '$kind' AND source LIKE '$source' GROUP BY stage ORDER BY array_position(ARRAY['produce','parse','categorize','inject'], stage)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "datasource": {
        "type": "postgres",
