{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Packets by stage",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": true, "calcs": ["lastNotNull"], "fields": "/^packets$/"},
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT stage, count(*) AS packets FROM pipeline_lineage WHERE $__timeFilter(coalesce(exited_at, entered_at)) AND kind LIKE '$kind' AND source LIKE '$source' GROUP BY stage ORDER BY array_position(ARRAY['produce','parse','categorize','inject'], stage)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE outcome = 'error') / nullif(count(*), 0) AS error_pct FROM pipeline_lineage WHERE $__timeFilter(coalesce(exited_at, entered_at)) AND kind LIKE '$kind' AND source LIKE '$source'"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Backlog",
      "description": "Events with a produce stamp but no inject stamp yet in the selected range",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 50}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT count(*) AS backlog FROM pipeline_lineage p WHERE p.stage = 'produce' AND $__timeFilter(p.entered_at) AND p.kind LIKE '$kind' AND p.source LIKE '$source' AND NOT EXISTS (SELECT 1 FROM pipeline_lineage i WHERE i.event_id = p.event_id AND i.stage = 'inject')"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Since last inject",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 7200},
              {"color": "red", "value": 21600}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT extract(epoch FROM now() - max(coalesce(exited_at, entered_at))) AS seconds FROM pipeline_lineage WHERE stage = 'inject' AND outcome = 'ok'"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput by stage",
      "datasource": {"type": "postgres", "uid": "researchscout-pg"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {"mode": "normal", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {"type": "postgres", "uid": "researchscout-pg"},
          "rawSql": "SELECT bucket AS \"time\", stage AS metric, sum(packets) AS packets FROM pipeline_rollups_hourly WHERE $__timeFilter(bucket) AND kind LIKE '$kind' AND source LIKE '$source' GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
