      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "researchscout-pg"
          },
          "rawSql": "WITH produced AS (SELECT paper_id, entered_at, min(entered_at) OVER (PARTITION BY paper_id) AS first_at FROM pipeline_lineage WHERE stage = 'produce' AND kind = 'paper' AND $__timeFilter(entered_at)) SELECT date_trunc('hour', entered_at) AS \"time\", count(*) AS \"packets\", count(*) FILTER (WHERE entered_at = first_at) AS \"new_papers\" FROM produced GROUP BY 1 ORDER BY 1"
        }
      ],
      "description": "Produce packets per hour against papers first seen that hour; the gap is re-publish waste the dedup skip removes"
    },
