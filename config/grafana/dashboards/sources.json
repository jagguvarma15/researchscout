{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL",
      "description": "The ResearchScout database, reached through Private Data Source Connect.",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Where the momentum numbers come from, and whether each upstream is still answering.",
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "table",
      "title": "When each source was last heard from",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT source,\n       max(observed_at) AS last_observation,\n       round(EXTRACT(EPOCH FROM (now() - max(observed_at))) / 3600.0) AS hours_ago,\n       count(*) AS observations\nFROM signals GROUP BY source ORDER BY hours_ago DESC\n"
        }
      ],
      "id": 1
    },
    {
      "type": "bargauge",
      "title": "Papers carrying each signal",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 40
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT type AS what,\n       100.0 * count(DISTINCT paper_id) / greatest((SELECT count(*) FROM papers), 1) AS pct\nFROM signals GROUP BY type ORDER BY pct DESC\n"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Observations per day, by source",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT $__timeGroup(observed_at, '1d') AS \"time\", source AS metric, count(*) AS observations\nFROM signals WHERE $__timeFilter(observed_at) GROUP BY 1, 2 ORDER BY 1\n"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Observations per day, by kind",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT $__timeGroup(observed_at, '1d') AS \"time\", type AS metric, count(*) AS observations\nFROM signals WHERE $__timeFilter(observed_at) GROUP BY 1, 2 ORDER BY 1\n"
        }
      ],
      "id": 4
    },
    {
      "type": "table",
      "title": "Papers with the most momentum behind them",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT p.title, count(*) AS observations, max(s.observed_at) AS latest\nFROM signals s JOIN papers p ON p.id = s.paper_id\nWHERE $__timeFilter(s.observed_at)\nGROUP BY p.title ORDER BY observations DESC LIMIT 20\n"
        }
      ],
      "id": 5
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "researchscout",
    "sources"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Signals and sources",
  "uid": "rs-sources",
  "version": 1,
  "weekStart": ""
}
