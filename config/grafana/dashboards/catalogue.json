{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL",
      "description": "The ResearchScout database, reached through Private Data Source Connect.",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "The AI landscape beside the corpus: models, benchmarks, and the join between them.",
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Models",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT count(*) AS n FROM ai_models"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Benchmarks",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT count(*) AS n FROM benchmarks"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Scores",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT count(*) AS n FROM benchmark_results"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Reaching a paper here",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT count(*) AS n FROM ai_models WHERE paper_id IS NOT NULL"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Scores linked to a model",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT 100.0 * count(*) FILTER (WHERE model_id IS NOT NULL) / greatest(count(*), 1) AS pct\nFROM benchmark_results\n"
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Catalogue last refreshed",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT max(refreshed_at) AS refreshed FROM ai_models"
        }
      ],
      "id": 6
    },
    {
      "type": "barchart",
      "title": "Models by organisation",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT organization, count(*) AS models\nFROM ai_models WHERE organization IS NOT NULL\nGROUP BY organization ORDER BY models DESC LIMIT 20\n"
        }
      ],
      "id": 7
    },
    {
      "type": "barchart",
      "title": "Benchmarks by how much has been measured",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT name, result_count FROM benchmarks ORDER BY result_count DESC LIMIT 20\n"
        }
      ],
      "id": 8
    },
    {
      "type": "table",
      "title": "Benchmarks whose scores are not percentages",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT name, result_count, score_scale, refreshed_at\nFROM benchmarks WHERE score_scale <> 'fraction' ORDER BY result_count DESC\n"
        }
      ],
      "id": 9
    },
    {
      "type": "table",
      "title": "Models that came out of a paper in this corpus",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "\nSELECT m.name AS model, m.organization, p.title AS paper\nFROM ai_models m JOIN papers p ON p.id = m.paper_id\nORDER BY m.publication_date DESC NULLS LAST LIMIT 25\n"
        }
      ],
      "id": 10
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "researchscout",
    "catalogue"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Catalogue",
  "uid": "rs-catalogue",
  "version": 1,
  "weekStart": ""
}
