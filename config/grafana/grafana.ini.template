; Grafana config template. make setup renders this into .local/grafana/grafana.ini,
; replacing @GRAFANA_DATA@ with <repo>/.local/grafana and @REPO@ with the repo root.
; Do not edit the rendered copy; edit this template and rerun make setup.
; Anonymous Admin is safe only because the server binds to 127.0.0.1 — never loosen http_addr.

[paths]
data = @GRAFANA_DATA@/data
logs = @GRAFANA_DATA@/data/log
plugins = @GRAFANA_DATA@/plugins
provisioning = @GRAFANA_DATA@/provisioning

[server]
http_addr = 127.0.0.1
http_port = 3000

[auth]
disable_login_form = true

[auth.anonymous]
enabled = true
org_name = Main Org.
org_role = Admin

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false
feedback_links_enabled = false

[news]
news_feed_enabled = false

[security]
disable_gravatar = true

[snapshots]
external_enabled = false

[dashboards]
default_home_dashboard_path = @REPO@/config/grafana/dashboards/pipeline-overview.json

[log]
mode = console
level = warn
