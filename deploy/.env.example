# The backend runs on Railway; its configuration lives in the Railway service's Variables
# tab, not in a file. This file documents two things:
#
#   1. The few values deploy/verify.sh and deploy/backup.sh read from a local deploy/.env
#      (copy this file there and fill them in; deploy/.env is gitignored).
#   2. A reference list of every variable the Railway api service needs, so setting up a
#      new environment is a copy-through rather than an archaeology dig.

# ---- Read locally by the deploy scripts -------------------------------------------------

# The api service's public https URL (Settings -> Networking on the service), no trailing
# slash. verify.sh checks the deployment through it - the same path the site's proxy uses.
RAILWAY_API_URL=

# The front door. This shared secret is what separates the site's own server from everyone
# else who finds the public URL: requests without it get a 404 (only /healthz is open).
# Generate with `openssl rand -base64 36` and set the SAME value in three places: here (for
# verify.sh), the Railway api service, and Vercel's API_SERVICE_TOKEN.
RS_SERVICE_TOKEN=

# The Postgres service's public connection string (the TCP proxy; Railway prints it on the
# service as DATABASE_PUBLIC_URL). backup.sh dumps through it; it is also the restore path.
DATABASE_PUBLIC_URL=

# ---- Set on the Railway api service (reference; not read from this file) ----------------
#
# Database - Railway's own DATABASE_URL lacks the +psycopg driver marker SQLAlchemy needs,
# so build the URL from the Postgres service's parts with a reference variable:
#   RS_DATABASE_URL=postgresql+psycopg://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.PGDATABASE}}
#
# Build identity - /v1/system/status serves it and verify.sh compares it to origin/main.
# Nothing to set: the app reads Railway's own RAILWAY_GIT_COMMIT_SHA stamp directly
# (template references cannot reach per-deploy variables). RS_BUILD_SHA overrides if set.
#
# The model. Any OpenAI-compatible endpoint works; these three knobs are the whole contract.
#   RS_LLM_BASE_URL=https://openrouter.ai/api/v1
#   RS_LLM_MODEL=meta-llama/llama-3.1-8b-instruct
#   RS_LLM_API_KEY=<the provider key>
#   RS_LLM_MAX_CONCURRENCY=2
#
# Sign-in. Leave the issuer empty to run in no-auth mode (single built-in user). The issuer
# needs its trailing slash - it is compared against the token's iss claim, which Auth0
# writes with one. The management credentials are what DELETE /v1/me needs to remove the
# Auth0 login along with the rows; the domain is bare (no scheme, no slash).
#   RS_OIDC_ISSUER=https://your-tenant.us.auth0.com/
#   RS_OIDC_AUDIENCE=https://researchscout.api
#   RS_AUTH0_DOMAIN=your-tenant.us.auth0.com
#   RS_AUTH0_MGMT_CLIENT_ID=
#   RS_AUTH0_MGMT_CLIENT_SECRET=
#   RS_TERMS_VERSION=2026-08-01   (keep in step with apps/web/src/lib/legal.ts)
#
# The front door token again - same value as above:
#   RS_SERVICE_TOKEN=
#
# Scheduling. Comma-separated HH:MM in the zone below, shaped around the day arXiv actually
# has: announcements land Sun-Thu 20:00 ET and the search API refreshes once around
# midnight ET, so one early slot sees everything a day brings (Saturday and Sunday mornings
# legitimately find nothing). The citation walker runs before the morning report so it
# carries fresh counts; the fast signal proxies (HF trending, HN, Bluesky) poll morning and
# evening. A named zone rather than a fixed offset, so half past midnight stays put in New
# York when daylight saving moves. A slot missed while the service was down is not caught
# up: the watermark window covers it on the next run.
#   RS_SCHEDULER_BATCH_PIPELINE=true
#   RS_SCHEDULER_INGEST_WINDOW_DAYS=4
#   RS_SCHEDULER_INGEST_EARLY_STOP_PAGES=2
#   RS_SCHEDULER_FULLTEXT_BATCH=100
#   RS_SCHEDULER_PIPELINE_AT=00:30
#   RS_SCHEDULER_CITATIONS_AT=06:00
#   RS_SCHEDULER_REPORT_AT=07:00
#   RS_SCHEDULER_SIGNALS_AT=08:00,18:00
#   RS_SCHEDULER_DAILY_AT=17:00
#   RS_SCHEDULER_TIMEZONE=America/New_York
#
# Retrieval behaviour, matching what the local stack runs with:
#   RS_RERANK_ENABLED=true
#   RS_ASK_FAST_RERANK=false
#   RS_CHUNK_RETRIEVAL=true
#   RS_CLUSTER_ALGO=hdbscan
#
# Answer budgets: per account, and the tighter one for signed-out visitors:
#   RS_CHAT_RATE_LIMIT=20
#   RS_CHAT_RATE_LIMIT_ANONYMOUS=5
#
# Optional upstream credentials. A Semantic Scholar key moves the citation walker off the
# shared throttled pool; an OpenAlex key is what its fallback lane requires to run at all
# (keys are mandatory there); a GitHub token is what the code-adoption source needs.
#   S2_API_KEY=
#   OPENALEX_API_KEY=
#   GITHUB_TOKEN=
