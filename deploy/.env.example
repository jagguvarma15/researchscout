# Settings for the deployed backend. Copy to deploy/.env and fill in; compose reads it
# automatically. This file is separate from the repo-root .env on purpose: that one describes
# the development stack on the host, and several values (the database host, the LLM base URL)
# are wrong inside a container.
#
# Everything here is a secret or a deployment choice. deploy/.env is gitignored.

# Database. Generate with `openssl rand -hex 24` - hex, not base64: this value is substituted
# into a connection URL, and a / or @ in it would break the URL rather than fail cleanly.
#
# It is chosen once. Postgres reads it only when it initializes the volume on the very first
# `make deploy-up`; editing it later changes nothing but the password the API tries, which
# then cannot connect. To rotate it afterwards, change it in the database first:
#   docker compose -f deploy/docker-compose.yml exec postgres \
#     psql -U researchscout -c "ALTER USER researchscout PASSWORD 'the-new-one'"
POSTGRES_PASSWORD=

# Sign-in. Leave the issuer empty to run the deployment in no-auth mode (single built-in user),
# which is useful for a first smoke test before the Auth0 tenant exists.
# The issuer needs its trailing slash: it is compared against the `iss` claim in the token,
# which Auth0 writes with one. The signing keys are found through the issuer's discovery
# document, so there is nothing else to configure.
RS_OIDC_ISSUER=https://your-tenant.us.auth0.com/
# The API identifier from the Auth0 dashboard, character for character. It is a name, not a
# URL that has to resolve.
RS_OIDC_AUDIENCE=https://researchscout.api

# Account deletion has to remove the login as well as the rows, so the API needs an Auth0
# machine-to-machine application with the delete:users scope. Without these, DELETE /v1/me
# refuses rather than half-deleting. The domain here is bare - no scheme, no trailing slash -
# unlike the issuer above.
RS_AUTH0_DOMAIN=your-tenant.us.auth0.com
RS_AUTH0_MGMT_CLIENT_ID=
RS_AUTH0_MGMT_CLIENT_SECRET=

# The terms version people must accept. Bump it when the documents change; every account is
# asked again on their next visit. Keep it in step with apps/web/src/lib/legal.ts.
RS_TERMS_VERSION=2026-08-01

# The model. Ollama stays on the host, so this address is the host as a container sees it.
RS_LLM_BASE_URL=http://host.docker.internal:11434/v1
RS_LLM_MODEL=qwen2.5:3b-instruct
RS_LLM_API_KEY=ollama
# Concurrent generations. Two is about what an 8 GB machine will carry alongside Postgres.
RS_LLM_MAX_CONCURRENCY=2

# Answer budgets: per account, and the tighter one for signed-out visitors (keyed by address).
RS_CHAT_RATE_LIMIT=20
RS_CHAT_RATE_LIMIT_ANONYMOUS=5

# The five below are the compose file's defaults as well, so a deploy/.env that predates them
# still behaves correctly. That is not belt and braces: this file gained them in one release
# and the real deploy/.env did not, which left the deployed scheduler with no fetch tasks at
# all for weeks. Setting them here is now an override rather than a requirement, and the values
# match what compose already does.
#
# Without the stream profile, nothing fetches papers unless the scheduler does it in batches.
# Leave this on for a deployment that does not run `--profile stream`; turn it off if you do,
# because two ingesters on one address is what gets an address rate limited. `make
# deploy-up-stream` sets it to false for you.
RS_SCHEDULER_BATCH_PIPELINE=true
# How far back each ingest looks. Two days is enough while the machine never stops, but arXiv
# submits nothing over a weekend, so on a Monday a two-day window reaches back only to
# Saturday and Friday's papers are already outside it. Four days covers that gap, and covers a
# weekend outage - which a machine at home will have. It costs proportionally more paging at
# three seconds a page, so widen it further only if you have been away.
RS_SCHEDULER_INGEST_WINDOW_DAYS=4

# When the pipeline runs. Comma-separated HH:MM in the zone below; the fetch-and-enrich tasks
# run at each of these, and the once-a-day products (model catalogue, digest, topics, report)
# at the daily one. Set either to an empty string to go back to interval scheduling - an empty
# value is respected rather than falling back to the default, which is the one case where the
# difference matters.
#
# A named zone rather than a fixed offset, so 5pm stays 5pm in New York when daylight saving
# moves. A slot missed while the stack was down is not caught up: the ingest window is four days
# wide, so the next run covers it.
RS_SCHEDULER_PIPELINE_AT=05:00,10:00,14:00,17:00
RS_SCHEDULER_DAILY_AT=17:00
RS_SCHEDULER_TIMEZONE=America/New_York

# Retrieval behaviour, matching what the local stack runs with.
RS_RERANK_ENABLED=true
RS_ASK_FAST_RERANK=false
RS_CHUNK_RETRIEVAL=true
RS_CLUSTER_ALGO=hdbscan

# Optional upstream credentials. A Semantic Scholar key raises that source's rate limit; a
# GitHub token is what the code-adoption source needs to be worth enabling at all.
S2_API_KEY=
GITHUB_TOKEN=

# The front door. Once the API has a public hostname, this shared secret is what separates the
# site's own server from everyone else who learns it: requests without it get a 404. Generate
# with `openssl rand -base64 36` (any characters are fine here - it is only ever a header),
# and set the same value as API_SERVICE_TOKEN in Vercel.
# Leave empty to keep the API open, which is fine while it is only on localhost.
RS_SERVICE_TOKEN=

# Grafana Cloud private data source connect, so the hosted dashboards can query this Postgres
# without it being reachable from anywhere else. All three come from Connections -> Private
# data source connections -> Configuration Details in your Grafana Cloud stack, and are only
# needed with `--profile monitoring`.
GCLOUD_PDC_SIGNING_TOKEN=
GCLOUD_PDC_CLUSTER=
GCLOUD_HOSTED_GRAFANA_ID=
# The password for the read-only database role the dashboards log in as. Created by
# `make grafana-db-role`; hex, because it goes into a connection field.
GRAFANA_DB_PASSWORD=
