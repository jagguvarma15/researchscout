# Helm values carrying only secret material. Copy to secrets.prod.yaml, fill in, then
# `sops encrypt -i deploy/secrets/secrets.prod.yaml` before committing — the .sops.yaml rule
# covers this path, and deploys read it via the helm-secrets plugin.
postgres:
  password: change-me

keycloak:
  adminPassword: change-me

# Read by deploy/scripts/bootstrap.sh (not the chart) when it installs the Grafana that
# ships inside kube-prometheus-stack.
grafana:
  adminPassword: change-me

oidc:
  clientSecret: change-me

llm:
  apiKey: sk-change-me

workers:
  airtable:
    enabled: false
    apiKey: ""
    baseId: ""

backup:
  s3:
    # OCI Object Storage S3 endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
    endpoint: ""
    accessKey: ""
    secretKey: ""
