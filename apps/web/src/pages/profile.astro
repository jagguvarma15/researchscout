---
import AccountSettings from '../components/AccountSettings.svelte';
import AvatarArt from '../components/AvatarArt.svelte';
import AvatarPicker from '../components/AvatarPicker.svelte';
import EmptyState from '../components/EmptyState.astro';
import InterestsEditor from '../components/InterestsEditor.svelte';
import Base from '../layouts/Base.astro';
import { fetchAccount, fetchInterests } from '../lib/api';
import { isAvatarSlug } from '../lib/avatars';

const user = Astro.locals.user;
const token = Astro.locals.accessToken;
const [interests, account] = user
  ? await Promise.all([fetchInterests(token), fetchAccount(token)])
  : [null, null];
// Deleting an account only means anything when there is an identity provider behind it; a
// local install has one built-in user that other rows point at.
const canDelete = account !== null && account.sub !== 'local';
const avatarSlug = account?.avatar && isAvatarSlug(account.avatar) ? account.avatar : null;
// The picker's fallback tile shows what "no avatar" looks like: the header's initials
// recipe, over the name the site would use.
const initials =
  (account?.display_name || user?.username || '')
    .split(/[\s._@-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase() || '?';
---

{/* The account fetched here doubles as the shell's: passing it down is what keeps this the
    one page that does not ask the API for the account twice per request. */}
<Base title="Profile" account={account}>
  <div class="prose-page profile">
    <header class="hero">
      <h1 class="page-title">Profile</h1>
      {
        user === null ? (
          <p class="who">
            <a href="/login?next=/profile">Sign in</a> to keep interests, a reading list and a
            feed that learns what you care about.
          </p>
        ) : (
          <>
            {avatarSlug && (
              <div class="hero-owl">
                <AvatarArt slug={avatarSlug} size={72} />
              </div>
            )}
            <p class="who">
              Browsing as <strong>{account?.display_name || user.username}</strong>
              {account?.email && <span class="email">{account.email}</span>}
            </p>
          </>
        )
      }
    </header>

    {
      user !== null && (
        <>
          <section class="block panel">
            <h2>Research interests</h2>
            <p class="blurb">
              Topics you care about - up to 20, each a short phrase. Changes save as you go and
              shape your <a href="/for-you">For You feed</a>.
            </p>
            <div class="panel-body">
              {interests === null ? (
                <EmptyState
                  kind="error"
                  icon="lucide:cloud-off"
                  message="Your interests could not be loaded - the API did not answer."
                  action={{ href: '/profile', label: 'Retry' }}
                />
              ) : (
                <InterestsEditor client:load initial={interests} />
              )}
            </div>
          </section>

          <section class="block panel">
            <h2>Avatar</h2>
            <p class="blurb">
              Pick the crew member the site shows for you - in the header here, nowhere
              else. Choices save as you click.
            </p>
            <div class="panel-body">
              {account === null ? (
                <EmptyState
                  kind="error"
                  icon="lucide:cloud-off"
                  message="Your account could not be loaded - the API did not answer."
                  action={{ href: '/profile', label: 'Retry' }}
                />
              ) : (
                <AvatarPicker client:load current={account.avatar} initials={initials} />
              )}
            </div>
          </section>

          <section class="block panel">
            <h2>Account</h2>
            <p class="blurb">
              Your display name, a copy of everything stored about you, and the way out. Your
              email address is not among it - your sign-in provider holds that, not this site.
              What each of these means is spelled out in the <a href="/privacy">privacy
              notice</a>.
            </p>
            <div class="panel-body">
              {account === null ? (
                <EmptyState
                  kind="error"
                  icon="lucide:cloud-off"
                  message="Your account could not be loaded - the API did not answer."
                  action={{ href: '/profile', label: 'Retry' }}
                />
              ) : (
                <AccountSettings
                  client:load
                  displayName={account.display_name ?? ''}
                  termsVersion={account.terms_accepted_version}
                  canDelete={canDelete}
                />
              )}
            </div>
          </section>
        </>
      )
    }
  </div>
</Base>

<style>
  /* The shared document column, one size narrower: controls in a comfortable measure
     rather than stretched across the window. */
  .profile {
    max-width: 46rem;
  }
  /* One element type deeper than the .prose-page rules they override, so they win on
     specificity rather than on bundle order. */
  .profile header.hero .page-title {
    margin-bottom: 0.5rem;
  }
  .hero-owl {
    display: flex;
    justify-content: center;
    margin-bottom: 0.6rem;
  }
  .who {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .who strong {
    color: var(--ink);
    font-weight: 600;
  }
  .email {
    margin-left: 0.5rem;
  }
  /* On top of the shared .block: the profile's sections center their prose. */
  .panel {
    text-align: center;
  }
  .profile section.panel h2 {
    margin-bottom: 0.35rem;
  }
  .blurb {
    max-width: 62ch;
    margin: 0 auto 1.2rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  /* The controls themselves read left to right; only the block is centered. */
  .panel-body {
    display: inline-block;
    width: 100%;
    max-width: 34rem;
    text-align: left;
  }
</style>
