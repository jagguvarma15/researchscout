---
import AccountSettings from '../components/AccountSettings.svelte';
import AvatarArt from '../components/AvatarArt.svelte';
import AvatarPicker from '../components/AvatarPicker.svelte';
import InterestsEditor from '../components/InterestsEditor.svelte';
import Base from '../layouts/Base.astro';
import { fetchAccount, fetchInterests } from '../lib/api';
import { isAvatarSlug } from '../lib/avatars';

const user = Astro.locals.user;
const token = Astro.locals.accessToken;
const interests = user ? await fetchInterests(token) : null;
const account = user ? await fetchAccount(token) : null;
// Deleting an account only means anything when there is an identity provider behind it; a
// local install has one built-in user that other rows point at.
const canDelete = account !== null && account.sub !== 'local';
const avatarSlug = account?.avatar && isAvatarSlug(account.avatar) ? account.avatar : null;
// The picker's fallback tile shows what "no avatar" looks like: the header's initials
// recipe, over the name the site would use.
const initials =
  (account?.display_name || user?.username || '')
    .split(/[\s._@-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase() || '?';
---

<Base title="Profile">
  <div class="profile">
    <header class="hero">
      <h1 class="page-title">Profile</h1>
      {
        user === null ? (
          <p class="who">
            <a href="/login?next=/profile">Sign in</a> to keep interests, a reading list and a
            feed that learns what you care about.
          </p>
        ) : (
          <>
            {avatarSlug && (
              <div class="hero-owl">
                <AvatarArt slug={avatarSlug} size={72} />
              </div>
            )}
            <p class="who">
              Browsing as <strong>{account?.display_name || user.username}</strong>
              {account?.email && <span class="email">{account.email}</span>}
            </p>
          </>
        )
      }
    </header>

    {
      user !== null && (
        <>
          <section class="panel">
            <h2>Research interests</h2>
            <p class="blurb">
              Topics you care about - up to 20, each a short phrase. Changes save as you go.
            </p>
            <div class="panel-body">
              <InterestsEditor client:load initial={interests} />
            </div>
          </section>

          <section class="panel">
            <h2>Avatar</h2>
            <p class="blurb">
              Pick the crew member the site shows for you - in the header here, nowhere
              else. Choices save as you click.
            </p>
            <div class="panel-body">
              <AvatarPicker client:load current={account?.avatar ?? null} initials={initials} />
            </div>
          </section>

          <section class="panel">
            <h2>Account</h2>
            <p class="blurb">
              Your display name, a copy of everything stored about you, and the way out. Your
              email address is not among it - your sign-in provider holds that, not this site.
              What each of these means is spelled out in the <a href="/privacy">privacy
              notice</a>.
            </p>
            <div class="panel-body">
              <AccountSettings
                client:load
                displayName={account?.display_name ?? ''}
                termsVersion={account?.terms_accepted_version ?? null}
                canDelete={canDelete}
              />
            </div>
          </section>
        </>
      )
    }
  </div>
</Base>

<style>
  /* Centered column, like the about and legal pages: headings and prose center, the controls
     sit in a comfortable measure rather than stretching across the window. */
  .profile {
    max-width: 46rem;
    margin: 0 auto;
  }
  .hero {
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .hero .page-title {
    margin-bottom: 0.5rem;
  }
  .hero-owl {
    display: flex;
    justify-content: center;
    margin-bottom: 0.6rem;
  }
  .who {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .who strong {
    color: var(--ink);
    font-weight: 600;
  }
  .email {
    margin-left: 0.5rem;
  }
  .panel {
    margin-bottom: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .panel h2 {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    margin: 0 0 0.35rem;
  }
  .blurb {
    max-width: 62ch;
    margin: 0 auto 1.2rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  /* The controls themselves read left to right; only the block is centered. */
  .panel-body {
    display: inline-block;
    width: 100%;
    max-width: 34rem;
    text-align: left;
  }
</style>
