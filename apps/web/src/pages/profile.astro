---
import InterestsEditor from '../components/InterestsEditor.svelte';
import Base from '../layouts/Base.astro';
import { fetchInterests } from '../lib/api';

const user = Astro.locals.user;
const interests = await fetchInterests();
---

<Base title="Profile">
  <h1 class="page-title">Profile</h1>

  <p class="who">
    Browsing as <strong>{user.username}</strong>.
  </p>
  <section class="interests">
    <h2>Research interests</h2>
    <p class="blurb">
      Topics you care about — up to 20, each a short phrase. Changes save as you go.
    </p>
    <InterestsEditor client:load initial={interests} />
  </section>
</Base>

<style>
  .who {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .who strong {
    color: var(--ink);
    font-weight: 600;
  }
  .interests {
    margin-top: var(--space-6);
  }
  .interests h2 {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    margin: 0 0 0.35rem;
  }
  .blurb {
    max-width: 70ch;
    margin: 0 0 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
