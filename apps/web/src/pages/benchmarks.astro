---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import {
  catalogMessage,
  fetchBenchmark,
  fetchBenchmarks,
  fetchHeadlineBenchmarks,
  fetchProviders,
  formatScore,
} from '../lib/api';

const selected = Astro.url.searchParams.get('b') ?? '';

// Neither the headline strip nor the provider comparison depends on which benchmark is open,
// so all three fetches run together.
const [listed, providerResult, headlineResult] = await Promise.all([
  fetchBenchmarks(),
  fetchProviders(),
  fetchHeadlineBenchmarks(),
]);
const benchmarks = listed.ok ? listed.data : null;
const listFailure = listed.ok ? null : listed.failure;
const providers = providerResult.ok ? providerResult.data : null;
// Best-effort like the provider table: it renders when it has rows, and the list's own error
// card already reports catalogue trouble.
const headline = headlineResult.ok ? headlineResult.data : [];

// The first one is the most measured, which is the most useful thing to open on.
const current = benchmarks?.length ? selected || benchmarks[0].id : '';
const detailResult = current ? await fetchBenchmark(current) : null;
const detail = detailResult?.ok ? detailResult.data : null;
// Distinguished from a benchmark that is simply not in the catalogue: a failed fetch and an
// unknown id want different things said about them.
const detailFailure = detailResult && !detailResult.ok ? detailResult.failure : null;

function benchmarkLink(id: string): string {
  return `/benchmarks?b=${encodeURIComponent(id)}`;
}

// How a score reads depends on the benchmark, which is why the server sends the scale: most
// are accuracies shown as percentage points, and eleven of the hub's are a ratio, an Elo or an
// amount of money that would be nonsense multiplied by a hundred.
---

<Base title="Benchmarks">
  <h1 class="page-title">Benchmarks</h1>
  <p class="lede">
    How the models on the <a href="/models">Models</a> page score on the tests the field actually
    uses. Pick a benchmark to see its leaderboard; a model this catalogue knows links back to its
    entry.
  </p>

  {
    listFailure && (
      <div class="card empty is-error">
        <Icon name="lucide:cloud-off" aria-hidden="true" />
        <p>{catalogMessage(listFailure, 'benchmarks')}</p>
      </div>
    )
  }
  {
    benchmarks !== null && benchmarks.length === 0 && (
      <div class="card empty">
        <Icon name="lucide:gauge" aria-hidden="true" />
        <p>
          No benchmarks yet — they arrive with the daily catalogue refresh, or run{' '}
          <code>scout catalog</code>.
        </p>
      </div>
    )
  }

  {
    headline.length > 0 && (
      <section class="providers">
        <h2>Headline benchmarks</h2>
        <p class="lede-sm">
          The industry-standard tests, each with the best score from the major labs and the
          model holding it. Pick a row to open that benchmark's full leaderboard below.
        </p>
        <div class="table-scroll">
          <table class="data-table strip-table">
            <thead>
              <tr>
                <th scope="col" class="cell-name">Benchmark</th>
                <th scope="col" class="cell-num">Best score</th>
                <th scope="col">Model</th>
                <th scope="col">Lab</th>
                <th scope="col" class="cell-num">Scores held</th>
              </tr>
            </thead>
            <tbody>
              {headline.map((row) => (
                <tr>
                  <th scope="row" class="cell-name">
                    <a href={benchmarkLink(row.id)}>{row.name}</a>
                  </th>
                  <td class="cell-num">{formatScore(row.best_score, row.scale)}</td>
                  <td class="cell-clip" title={row.model_name}>
                    <a href={`/models/${row.model_id}`}>{row.model_name}</a>
                  </td>
                  <td class="cell-muted">{row.provider}</td>
                  <td class="cell-num cell-muted">{row.result_count}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    providers && providers.items.length > 0 && (
      <section class="providers">
        <h2>Where the major labs stand</h2>
        <p class="lede-sm">
          Each lab's best-covered model on the benchmarks the field leans on - the one with the
          most of these measured, so the rows can actually be compared. A blank is "not
          measured" rather than zero, and each column is shown on whatever scale its benchmark
          uses.
        </p>
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Provider</th>
                <th scope="col">Model</th>
                {providers.columns.map((column) => (
                  <th scope="col" class="cell-num">
                    {column.name}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {providers.items.map((row) => (
                <tr>
                  <th scope="row" class="cell-name">
                    {row.provider}
                    {row.country && <span class="country">{row.country}</span>}
                  </th>
                  <td class="cell-clip" title={row.model_name}>
                    <a href={`/models/${row.model_id}`}>{row.model_name}</a>
                  </td>
                  {providers.columns.map((column) => (
                    <td class="cell-num">
                      {column.id in row.scores ? formatScore(row.scores[column.id], column.scale) : ''}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    benchmarks !== null && benchmarks.length > 0 && (
      <div class="layout">
        <nav class="picker" aria-label="Benchmarks">
          <ul>
            {benchmarks.map((benchmark) => (
              <li>
                <a
                  href={benchmarkLink(benchmark.id)}
                  aria-current={benchmark.id === current ? 'page' : undefined}
                >
                  <span class="name">{benchmark.name}</span>
                  <span class="n">{benchmark.result_count}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <section class="board">
          {detail === null ? (
            <div class:list={['card', 'empty', { 'is-error': detailFailure }]}>
              <Icon
                name={detailFailure ? 'lucide:cloud-off' : 'lucide:search-x'}
                aria-hidden="true"
              />
              <p>
                {detailFailure
                  ? catalogMessage(detailFailure, 'benchmarks')
                  : 'That benchmark is not in the catalogue.'}
              </p>
            </div>
          ) : (
            <Fragment>
              <header class="board-head">
                <h2>{detail.name}</h2>
                <p class="board-meta">
                  {detail.result_count} score{detail.result_count === 1 ? '' : 's'}
                  {detail.score_scale === 'fraction' ? ' · percentage points' : ' · not a percentage'}
                  {detail.released_on && ` · released ${detail.released_on}`}
                </p>
              </header>
              <div class="table-scroll">
                <table class="data-table board-table">
                  <thead>
                    <tr>
                      <th scope="col" class="cell-num rank">
                        #
                      </th>
                      <th scope="col">Model</th>
                      <th scope="col" class="cell-num">
                        Score
                      </th>
                      <th scope="col">Measured</th>
                      <th scope="col">From</th>
                    </tr>
                  </thead>
                  <tbody>
                    {detail.results.map((result, index) => (
                      <tr>
                        <td class="cell-num cell-muted rank">{index + 1}</td>
                        <th scope="row" class="cell-name">
                          {/* Roughly half the models with scores are not in the catalogue at
                              all - a leaderboard covers what has been measured, the catalogue
                              what somebody judged notable. The ones that match now have a page
                              to go to; the ones that do not say so rather than looking broken. */}
                          {result.model_id === null ? (
                            <>
                              {result.model}
                              <span class="unlisted" title="Not in the model catalogue">
                                unlisted
                              </span>
                            </>
                          ) : (
                            <a href={`/models/${result.model_id}`}>{result.model}</a>
                          )}
                        </th>
                        <td class="cell-num score">{formatScore(result.score, detail.score_scale)}</td>
                        <td class="cell-muted">{result.measured_on ?? ''}</td>
                        <td class="cell-muted cell-clip" title={result.origin ?? undefined}>
                          {result.origin ?? ''}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </Fragment>
          )}
        </section>
      </div>
    )
  }

  <p class="credit">
    Benchmark data from <a href="https://epoch.ai" rel="noopener noreferrer">Epoch AI</a> under
    CC BY. Scores are collected from published evaluations and are not run here; see
    <a href="https://epoch.ai/benchmarks/about" rel="noopener noreferrer">their methodology</a>
    for what each one measures.
  </p>
</Base>

<style>
  /* A picker beside the board on a wide window, stacked below one. The picker scrolls on its
     own so a long benchmark list never pushes the leaderboard off the screen. */
  .layout {
    display: grid;
    grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  .picker ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 32rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .picker a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .picker a:hover {
    background: var(--surface-2);
  }
  .picker a[aria-current] {
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .picker .n {
    color: var(--muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
  .picker a[aria-current] .n {
    color: var(--accent-ink);
  }
  /* The comparison sits above the picker: it is the question most people arrive with, and the
     per-benchmark leaderboard is the follow-up. */
  .providers {
    margin-bottom: var(--space-6);
  }
  .providers h2 {
    margin: 0 0 0.2rem;
    font-size: var(--text-lg);
  }
  .lede-sm {
    margin: 0 0 var(--space-3);
    max-width: 60ch;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  /* Under the lab rather than beside it: a second column for one word of context would push
     the scores off a narrow screen. */
  .country {
    display: block;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 400;
  }
  .board-head {
    margin-bottom: var(--space-3);
  }
  .board-head h2 {
    margin: 0;
    font-size: var(--text-lg);
  }
  .board-meta {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .rank {
    width: 2.5rem;
  }
  .score {
    font-weight: 650;
  }
  .unlisted {
    margin-left: 0.4rem;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 400;
  }
  .credit {
    margin-top: var(--space-5);
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  @media (max-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .picker ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      max-height: 9rem;
    }
    .picker a {
      border: 1px solid var(--line);
      border-radius: var(--radius-full);
    }
    .picker a[aria-current] {
      border-color: transparent;
    }
  }
  /* Scoped by table: the ordinals mean different columns in each. The leaderboard drops
     "measured" and "from" on a phone; the headline strip drops the lab and the score count;
     the provider comparison keeps everything and scrolls. */
  @media (max-width: 42rem) {
    .board-table :global(td:nth-child(4)),
    .board-table :global(th:nth-child(4)),
    .board-table :global(td:nth-child(5)),
    .board-table :global(th:nth-child(5)),
    .strip-table :global(td:nth-child(4)),
    .strip-table :global(th:nth-child(4)),
    .strip-table :global(td:nth-child(5)),
    .strip-table :global(th:nth-child(5)) {
      display: none;
    }
  }
</style>
