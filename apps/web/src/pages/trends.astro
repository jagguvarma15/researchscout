---
import DataAsOf from '../components/DataAsOf.astro';
import EmptyState from '../components/EmptyState.astro';
import PageIntro from '../components/PageIntro.astro';
import TrendChart from '../components/TrendChart.astro';
import Base from '../layouts/Base.astro';
import { catalogMessage, fetchCatalogFreshness, fetchTrends, formatDate, formatScore } from '../lib/api';
import { withMonthHeaders } from '../lib/timeline';

// The movement page: where the headline benchmarks' state of the art went, and what the
// major labs shipped - the catalogue's tables arranged along time instead of rank.
const [result, freshness] = await Promise.all([fetchTrends(), fetchCatalogFreshness()]);
const asOf = freshness.ok ? freshness.data.as_of : null;

// Only benchmarks with at least two advances have a line to draw; a single reading is dropped.
const series = result.ok
  ? result.data.sota
      .filter((entry) => entry.points.length >= 2)
      .map((entry) => ({
        ...entry,
        first: entry.points[0],
        leader: entry.points[entry.points.length - 1],
      }))
  : [];
const releases = result.ok ? result.data.releases : [];
const timeline = withMonthHeaders(releases);

// A fraction reads as a percentage; every other scale reads as its own number (Elo, dollars).
function readScore(scale: string, value: number): string {
  return scale === 'fraction' ? `${formatScore(value, scale)}%` : formatScore(value, scale);
}
---

<Base title="Frontier">
  <PageIntro
    title="Frontier"
    lede="Where the headline benchmarks' state of the art moved, and what the major labs shipped."
  />

  <p class="cross-link">
    <a href="/topics">See emerging research topics</a>
  </p>
  <DataAsOf date={asOf} label="Catalogue data as of" />

  {
    !result.ok ? (
      <EmptyState
        kind="error"
        icon="lucide:cloud-off"
        message={catalogMessage(result.failure, 'frontier data')}
        action={{ href: '/trends', label: 'Retry' }}
      />
    ) : series.length === 0 && releases.length === 0 ? (
      <EmptyState
        icon="lucide:hourglass"
        message="No frontier data yet."
        hint="Charts appear once the catalogue refresh has recorded dated benchmark scores."
      />
    ) : (
      <Fragment>
        {series.length > 0 && (
          <section class="charts">
            <h2 class="s-label">State of the art over time</h2>
            <ul class="chart-grid">
              {series.map((entry) => (
                <li class="card bench">
                  <div class="bench-head">
                    <h3 class="bench-name">
                      <a href={`/benchmarks?b=${entry.id}`}>{entry.name}</a>
                    </h3>
                    <span class="bench-now">{readScore(entry.scale, entry.leader.score)}</span>
                  </div>
                  <TrendChart
                    mode="step"
                    values={entry.points.map((point) => point.score)}
                    width={640}
                    height={120}
                    pad={8}
                    baseline
                    endDot={false}
                    points={entry.points.map((point) => ({
                      title: `${point.model_name} - ${readScore(entry.scale, point.score)} - ${formatDate(point.on)}`,
                    }))}
                    label={`${entry.name} state of the art across ${entry.points.length} advances`}
                  />
                  <p class="bench-caption">
                    <span>{formatDate(entry.first.on)}</span>
                    <span>
                      {entry.leader.model_id ? (
                        <a href={`/models/${entry.leader.model_id}`}>{entry.leader.model_name}</a>
                      ) : (
                        entry.leader.model_name
                      )}{' '}
                      leads as of {formatDate(entry.leader.on)}
                    </span>
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )}

        {releases.length > 0 && (
          <section class="releases">
            <h2 class="s-label">Notable releases</h2>
            <ol class="timeline">
              {timeline.map((model) => (
                <Fragment>
                  {model.monthHeader && <li class="month">{model.monthHeader}</li>}
                  <li class="release">
                    <span class="when">
                      {model.published_on ? formatDate(model.published_on) : ''}
                    </span>
                    <a class="what" href={`/models/${model.id}`}>
                      {model.name}
                    </a>
                    <a class="who" href={`/models?organization=${encodeURIComponent(model.provider)}`}>
                      {model.provider}
                    </a>
                  </li>
                </Fragment>
              ))}
            </ol>
          </section>
        )}
      </Fragment>
    )
  }
</Base>

<style>
  .s-label {
    margin: var(--space-6) 0 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-caps-wide);
    text-transform: uppercase;
  }
  .chart-grid {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(24rem, 1fr));
  }
  @media (max-width: 40rem) {
    .chart-grid {
      grid-template-columns: 1fr;
    }
    .bench-name a,
    .bench-caption a {
      display: inline-block;
      padding: 0.15rem 0;
    }
  }
  .cross-link {
    margin: 0.2rem 0 0;
    font-size: var(--text-sm);
  }
  .cross-link a {
    color: var(--muted);
    text-decoration: none;
  }
  .cross-link a:hover {
    color: var(--accent);
  }
  .bench {
    padding: 1.1rem 1.25rem;
    min-width: 0;
  }
  .bench-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .bench-name {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-tight);
  }
  .bench-name a {
    color: var(--ink);
    text-decoration: none;
  }
  .bench-name a:hover {
    color: var(--accent);
  }
  /* The current frontier reading, in the tabular register numbers share here. */
  .bench-now {
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-semibold);
    color: var(--accent-ink);
  }
  .bench :global(.trend-chart) {
    margin-top: 0.6rem;
  }
  .bench-caption {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .bench-caption a {
    color: inherit;
    text-decoration: none;
  }
  .bench-caption a:hover {
    color: var(--accent);
  }
  .timeline {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    max-width: 44rem;
  }
  .month {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }
  .release {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--line);
  }
  .release:last-child {
    border-bottom: none;
  }
  .when {
    flex: none;
    width: 5.5rem;
    color: var(--muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
  .what {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  .what:hover {
    color: var(--accent);
  }
  .who {
    flex: none;
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .who:hover {
    color: var(--accent);
  }
</style>
