---
import DismissNotice from '../components/DismissNotice.svelte';
import EmptyState from '../components/EmptyState.astro';
import PageIntro from '../components/PageIntro.astro';
import PaperRow from '../components/PaperRow.astro';
import Telemetry from '../components/Telemetry.svelte';
import Base from '../layouts/Base.astro';
import { catalogMessage, fetchForYou, fetchSaved } from '../lib/api';

const [result, savedResult] = await Promise.all([
  fetchForYou(Astro.locals.accessToken),
  fetchSaved(Astro.locals.accessToken),
]);
const savedIds = new Set(savedResult.ok ? savedResult.data.map((paper) => paper.id) : []);

// Meters read relative within this list; the personalization scores are not on a 0-1 scale.
const signalMax = result.ok
  ? Math.max(...result.data.map((paper) => paper.score ?? 0), 0) || 1
  : 1;
---

<Base title="For you">
  <PageIntro title="For you" lede="Recent papers ranked by your research interests." />

  {
    !result.ok ? (
      <EmptyState
        kind="error"
        icon="lucide:cloud-off"
        message={catalogMessage(result.failure, 'personalized feed')}
        action={{ href: '/for-you', label: 'Retry' }}
      />
    ) : result.data.length === 0 ? (
      <EmptyState
        icon="lucide:sparkles"
        message="No personalized picks yet."
        hint="Add research interests to your profile and recent papers get ranked against them."
        action={{ href: '/profile', label: 'Open your profile' }}
      />
    ) : (
      <ul class="feed">
        {result.data.map((paper, index) => (
          <PaperRow
            paper={paper}
            signalMax={signalMax}
            rank={index}
            saved={savedIds.has(paper.id)}
            dismissible={true}
          >
            <Fragment slot="extra">
              {paper.reason && <span class="pill reason">{paper.reason}</span>}
            </Fragment>
          </PaperRow>
        ))}
      </ul>
    )
  }

  <Telemetry client:idle surface="for-you" enabled={Astro.locals.user !== null} />
  <DismissNotice client:idle />
</Base>

<style>
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Why this paper is here - the personalized feed's one extra fact, as an accent chip
     on the shared pill shape. */
  .reason {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
</style>
