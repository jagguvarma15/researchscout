---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { fetchForYou } from '../lib/api';
import { renderMathHTML } from '../lib/math';

const items = await fetchForYou(Astro.locals.accessToken);
---

<Base title="For you">
  <h1 class="page-title">For you</h1>
  <p class="lede">Recent papers ranked by your research interests.</p>

  {
    items === null && (
      <div class="card empty is-error">
        <Icon name="lucide:cloud-off" aria-hidden="true" />
        <p>The API is unreachable — try again in a moment.</p>
      </div>
    )
  }
  {
    items !== null && items.length === 0 && (
      <div class="card empty">
        <Icon name="lucide:sparkles" aria-hidden="true" />
        <p>
          Add research interests in your <a href="/profile">profile</a> to see personalized picks.
        </p>
      </div>
    )
  }
  {
    items !== null && items.length > 0 && (
      <ul class="feed">
        {items.map((paper) => (
          <li class="row">
            <a class="title" href={`/papers/${paper.id}`} set:html={renderMathHTML(paper.title)} />
            <p class="meta">
              {paper.authors
                .slice(0, 3)
                .map((author) => author.name)
                .join(', ')}
            </p>
            {paper.reason && <p class="reason">{paper.reason}</p>}
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: none;
  }
  .title {
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.35rem 0 0;
  }
  .reason {
    display: inline-block;
    margin: 0.45rem 0 0;
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 0.78rem;
  }
</style>
