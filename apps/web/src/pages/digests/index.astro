---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import { fetchDigests, formatDate } from '../../lib/api';

const digests = await fetchDigests();
---

<Base title="Digests">
  <h1 class="page-title">Digests</h1>

  {
    digests === null && (
      <div class="card empty">
        <Icon name="lucide:cloud-off" aria-hidden="true" />
        <p>The API is unreachable — try again in a moment.</p>
      </div>
    )
  }
  {
    digests !== null && digests.length === 0 && (
      <div class="card empty">
        <Icon name="lucide:hourglass" aria-hidden="true" />
        <p>No digests published yet — the first one lands after the next scheduled sweep.</p>
      </div>
    )
  }

  {
    digests !== null && (
      <ul class="list">
        {digests.map((digest) => (
          <li>
            <a class="entry" href={`/digests/${digest.slug}`}>
              <span class="text">
                <span class="title">{digest.title}</span>
                <span class="meta">
                  {formatDate(digest.period_start)} to {formatDate(digest.period_end)}
                </span>
              </span>
              <Icon class="chevron" name="lucide:chevron-right" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .empty p {
    margin: 0;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    border-bottom: 1px solid var(--line);
  }
  .entry {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 0;
    color: var(--ink);
    text-decoration: none;
  }
  .text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .title {
    font-weight: 600;
    line-height: 1.4;
  }
  .entry:hover .title {
    color: var(--accent);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .entry :global(.chevron) {
    color: var(--muted);
  }
</style>
