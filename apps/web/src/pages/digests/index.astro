---
import { Icon } from 'astro-icon/components';
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import Base from '../../layouts/Base.astro';
import { catalogMessage, fetchDigests, formatDate } from '../../lib/api';
import { morphName } from '../../lib/morph';

const result = await fetchDigests();
---

<Base title="Digests">
  <PageIntro title="Digests" />

  {
    !result.ok ? (
      <EmptyState
        kind="error"
        icon="lucide:cloud-off"
        message={catalogMessage(result.failure, 'digests')}
        action={{ href: '/digests', label: 'Retry' }}
      />
    ) : result.data.length === 0 ? (
      <EmptyState
        icon="lucide:hourglass"
        message="No digests published yet."
        hint="The first one lands after the next scheduled sweep."
      />
    ) : (
      <ul class="list">
        {result.data.map((digest) => (
          <li>
            <a class="entry" href={`/digests/${digest.slug}`}>
              <span class="text">
                <span class="title" transition:name={morphName('digest', digest.slug)}>
                  {digest.title}
                </span>
                <span class="meta">
                  {formatDate(digest.period_start)} to {formatDate(digest.period_end)}
                </span>
              </span>
              <Icon class="chevron" name="lucide:chevron-right" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    border-bottom: 1px solid var(--line);
  }
  .entry {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 0;
    color: var(--ink);
    text-decoration: none;
  }
  .text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .title {
    font-weight: 600;
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .entry:hover .title {
    color: var(--accent);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .entry :global(.chevron) {
    color: var(--muted);
  }
</style>
