---
import { Icon } from 'astro-icon/components';
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import Base from '../../layouts/Base.astro';
import { fetchDigest, formatDate, renderDigestBody } from '../../lib/api';
import { renderMathHTML } from '../../lib/math';
import { morphName } from '../../lib/morph';

const slug = Astro.params.slug ?? '';
const digest = await fetchDigest(slug);
if (digest === null) {
  Astro.response.status = 404;
}
---

<Base title={digest?.title ?? 'Not found'}>
  {
    digest === null ? (
      <Fragment>
        <PageIntro title="Digest not found" />
        <EmptyState
          icon="lucide:file-question"
          message={`Nothing published under ${slug}.`}
          action={{ href: '/digests', label: 'Back to the archive' }}
        />
      </Fragment>
    ) : (
      <article>
        <header class="intro">
          <h1 transition:name={morphName('digest', digest.slug)}>{digest.title}</h1>
          <p class="meta">
            {formatDate(digest.period_start)} to {formatDate(digest.period_end)}
          </p>
          <div
            class="digest-body"
            set:html={renderDigestBody(digest.body, new Set(digest.items.map((i) => i.paper_id)))}
          />
        </header>
        <h2 class="ranked-title">Ranked papers</h2>
        <ol class="ranked">
          {digest.items.map((item) => (
            <li>
              <a href={`/papers/${item.paper_id}`} set:html={renderMathHTML(item.title)} />
              <span class="scores">
                <span class="badge badge-score">score {item.score.toFixed(3)}</span>
                {item.citations > 0 && <span class="badge">{item.citations} citations</span>}
              </span>
            </li>
          ))}
        </ol>
        <p class="back">
          <a class="btn btn-ghost" href="/digests">
            <Icon name="lucide:chevron-left" aria-hidden="true" />
            Back to the archive
          </a>
        </p>
      </article>
    )
  }
</Base>

<style>
  h1 {
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.45rem 0 1.2rem;
  }
  .ranked-title {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    margin: var(--space-6) 0 var(--space-2);
  }
  .ranked {
    list-style: none;
    counter-reset: rank;
    margin: 0;
    padding: 0;
  }
  .ranked li {
    counter-increment: rank;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ranked li::before {
    content: counter(rank);
    min-width: 1.4rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .ranked a {
    flex: 1;
    min-width: 12rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .ranked a:hover {
    color: var(--accent);
  }
  .scores {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .back {
    margin: var(--space-5) 0 0;
  }
</style>
