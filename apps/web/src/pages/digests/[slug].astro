---
import { Icon } from 'astro-icon/components';
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import SignalMark from '../../components/SignalMark.astro';
import Base from '../../layouts/Base.astro';
import { fetchDigest, formatDate, renderDigestBody } from '../../lib/api';
import { issueNumber } from '../../lib/format';
import { renderMathHTML } from '../../lib/math';
import { morphName } from '../../lib/morph';

const slug = Astro.params.slug ?? '';
const digest = await fetchDigest(slug);
if (digest === null) {
  Astro.response.status = 404;
}

const issue = issueNumber(slug);
const kicker = issue === null ? 'Daily report' : `Weekly digest · No. ${issue}`;
---

<Base title={digest?.title ?? 'Not found'}>
  {
    digest === null ? (
      <Fragment>
        <PageIntro title="Digest not found" />
        <EmptyState
          icon="lucide:file-question"
          message={`Nothing published under ${slug}.`}
          action={{ href: '/digests', label: 'Back to the archive' }}
        />
      </Fragment>
    ) : (
      <article class="issue">
        <header class="intro">
          <p class="kicker">{kicker}</p>
          <h1 transition:name={morphName('digest', digest.slug)}>{digest.title}</h1>
          <p class="meta">
            {formatDate(digest.period_start)} to {formatDate(digest.period_end)}
            {digest.items.length > 0 &&
              ` · ${digest.items.length} paper${digest.items.length === 1 ? '' : 's'}`}
          </p>
        </header>
        <div
          class="digest-body"
          set:html={renderDigestBody(digest.body, new Set(digest.items.map((i) => i.paper_id)))}
        />
        <h2 class="ranked-title">Must read</h2>
        <ol class="ranked">
          {digest.items.map((item) => (
            <li>
              <div class="ranked-text">
                <a href={`/papers/${item.paper_id}`} set:html={renderMathHTML(item.title)} />
                <span class="scores">
                  <SignalMark score={item.score} />
                  {item.citations > 0 && (
                    <span class="cites">
                      · {item.citations} citation{item.citations === 1 ? '' : 's'}
                    </span>
                  )}
                </span>
              </div>
            </li>
          ))}
        </ol>
        <p class="back">
          <a class="btn btn-ghost" href="/digests">
            <Icon name="lucide:chevron-left" aria-hidden="true" />
            Back to the archive
          </a>
        </p>
      </article>
    )
  }
</Base>

<style>
  /* The digest joins the centered prose family: it is an issue of a publication, read
     top to bottom, not a working list. Body and ranked block stay left-aligned inside
     the centered column. */
  .issue {
    max-width: 42rem;
    margin: 0 auto;
  }
  .intro {
    text-align: center;
  }
  .kicker {
    margin: 0 0 var(--space-2);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-caps-wide);
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-tight);
    text-wrap: balance;
  }
  .meta {
    color: var(--muted);
    font-size: var(--text-sm);
    margin: 0.45rem 0 var(--space-6);
  }
  /* The prose reads in the serif; the accent paper-link chips inside it stay as shipped. */
  .issue :global(.digest-body) {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    max-width: 65ch;
  }
  .ranked-title {
    margin: var(--space-6) 0 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-caps-wide);
    text-transform: uppercase;
  }
  .ranked {
    list-style: none;
    counter-reset: rank;
    margin: 0;
    padding: 0;
  }
  .ranked li {
    counter-increment: rank;
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }
  /* Oversized serif numerals; the top three read in accent - the issue's own ranking is
     the one place the rank number carries real information. */
  .ranked li::before {
    content: counter(rank);
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .ranked li:nth-child(-n + 3)::before {
    color: var(--accent);
  }
  .ranked-text {
    min-width: 0;
  }
  .ranked a {
    display: block;
    margin-bottom: 0.3rem;
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
    letter-spacing: var(--track-tight);
    line-height: var(--leading-snug);
    color: var(--ink);
    text-decoration: none;
  }
  .ranked a:hover {
    color: var(--accent);
  }
  .scores {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .cites {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .back {
    margin: var(--space-5) 0 0;
    text-align: center;
  }
</style>
