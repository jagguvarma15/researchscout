---
import { Icon } from 'astro-icon/components';
import SaveButton from '../components/SaveButton.svelte';
import Base from '../layouts/Base.astro';
import { fetchPapers, fetchSaved, formatDate, PAGE_SIZE } from '../lib/api';
import { getAccessToken, SESSION_COOKIE } from '../lib/auth';

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const days = params.get('days') ?? '';
const category = params.get('category') ?? '';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

const items = await fetchPapers({ q, days, category, page });

const authenticated = Astro.locals.user !== null;
let savedIds = new Set<string>();
if (authenticated) {
  const sid = Astro.cookies.get(SESSION_COOKIE)?.value;
  const token = sid ? await getAccessToken(sid) : null;
  if (token) savedIds = new Set(((await fetchSaved(token)) ?? []).map((p) => p.id));
}

function pageLink(target: number): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.set('page', String(target));
  return `/?${next}`;
}
---

<Base>
  <form class="card searchbar" method="get" action="/">
    <input
      class="input search"
      type="search"
      name="q"
      placeholder="Search papers semantically…"
      aria-label="Search papers"
      value={q}
    />
    <input
      class="input filter"
      type="text"
      name="category"
      placeholder="cs.LG"
      aria-label="Category"
      value={category}
      size="8"
    />
    <input
      class="input filter"
      type="number"
      name="days"
      placeholder="days"
      aria-label="Days back"
      value={days}
      min="1"
      max="365"
      size="5"
    />
    <button class="btn btn-primary" type="submit">Search</button>
  </form>

  {
    items === null && (
      <div class="card empty">
        <Icon name="lucide:cloud-off" aria-hidden="true" />
        <p>The API is unreachable — try again in a moment.</p>
      </div>
    )
  }
  {
    items !== null && items.length === 0 && (
      <div class="card empty">
        <Icon name="lucide:search-x" aria-hidden="true" />
        <p>No papers match that search — widen the filters and scan again.</p>
      </div>
    )
  }

  {
    items !== null && (
      <ul class="feed">
        {items.map((paper) => (
          <li class="row">
            <div class="row-head">
              <a class="title" href={`/papers/${paper.id}`}>
                {paper.title}
              </a>
              <SaveButton
                client:visible
                paperId={paper.id}
                saved={savedIds.has(paper.id)}
                {authenticated}
              />
            </div>
            <p class="meta">
              {formatDate(paper.published_at)}
              {' · '}
              {paper.authors
                .slice(0, 3)
                .map((author) => author.name)
                .join(', ')}
              {paper.authors.length > 3 && ' et al.'}
              {paper.categories.map((cat) => (
                <span class="badge">{cat}</span>
              ))}
              {paper.score !== null && <span class="badge badge-score">{paper.score.toFixed(3)}</span>}
            </p>
            <p class="abstract">{paper.abstract}</p>
          </li>
        ))}
      </ul>
    )
  }

  {
    items !== null && !q && (
      <nav class="pager" aria-label="Pagination">
        {page > 1 && (
          <a class="btn btn-ghost" href={pageLink(page - 1)}>
            <Icon name="lucide:chevron-left" aria-hidden="true" />
            Newer
          </a>
        )}
        {items.length === PAGE_SIZE && (
          <a class="btn btn-ghost older" href={pageLink(page + 1)}>
            Older
            <Icon name="lucide:chevron-right" aria-hidden="true" />
          </a>
        )}
      </nav>
    )
  }
</Base>

<style>
  .searchbar {
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem;
    margin-bottom: var(--space-6);
    box-shadow: none;
  }
  .search {
    flex: 1;
    min-width: 0;
    border-color: transparent;
    font-size: var(--text-md);
  }
  .search:hover {
    border-color: var(--line);
  }
  .filter {
    width: 6.5rem;
    padding: 0.55rem 0.6rem;
    color: var(--muted);
    font-size: var(--text-xs);
    border-color: transparent;
    background: var(--surface-2);
  }
  .filter:focus-visible {
    color: var(--ink);
  }
  .empty p {
    margin: 0;
  }
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }
  .row:first-child {
    padding-top: 0;
  }
  .row-head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .title {
    flex: 1;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.4rem 0 0;
  }
  .meta .badge {
    margin-left: 0.5rem;
    vertical-align: 0.1em;
  }
  .abstract {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: var(--space-5);
  }
  .pager .older {
    margin-left: auto;
  }
  @media (max-width: 40rem) {
    .searchbar {
      flex-wrap: wrap;
    }
    .search {
      flex-basis: 100%;
    }
    .filter {
      flex: 1;
    }
  }
</style>
