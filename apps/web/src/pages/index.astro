---
import { Icon } from 'astro-icon/components';
import DismissNotice from '../components/DismissNotice.svelte';
import FilterSidebar from '../components/FilterSidebar.svelte';
import SaveButton from '../components/SaveButton.svelte';
import Telemetry from '../components/Telemetry.svelte';
import Base from '../layouts/Base.astro';
import {
  fetchPapers,
  fetchSaved,
  fetchSavedFilters,
  formatDate,
  PAGE_SIZE,
  type PaperSummary,
} from '../lib/api';
import { renderMathHTML } from '../lib/math';
import { morphName } from '../lib/morph';
import { categoryName, subjectLabel, TOPICS, topicLabel } from '../lib/taxonomy';

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const daysParam = params.get('days') ?? '';
const year = params.get('year') ?? '';
const month = params.get('month') ?? '';
const author = params.get('author') ?? '';
const venue = params.get('venue') ?? '';
const minCitations = params.get('min_citations') ?? '';
const sort = params.get('sort') ?? '';
const category = params.getAll('category');
const subject = params.getAll('subject');
const topic = params.getAll('topic');
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

// The feed is a radar, so it opens on the last week. A default rather than a cap: an explicit
// ?days= or ?year= wins, the filters can widen it, and every link ever shared still resolves.
// A search is not the feed and is never windowed.
const DEFAULT_DAYS = '7';
const days = daysParam || (q || year ? '' : DEFAULT_DAYS);

// Topic toggles: the same URL with one technique added or removed (page reset).
function withTopic(value: string): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  const current = next.getAll('topic');
  next.delete('topic');
  for (const item of current) {
    if (item !== value) next.append('topic', item);
  }
  if (!current.includes(value)) next.append('topic', value);
  next.delete('page');
  const query = next.toString();
  return query ? `/?${query}` : '/';
}

// Per-chip removal links: the same URL minus one param (or one value of a repeated param).
function withoutParams(names: [string, string?][]): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  for (const [name, value] of names) {
    if (value === undefined) {
      next.delete(name);
    } else {
      const rest = next.getAll(name).filter((v) => v !== value);
      next.delete(name);
      for (const v of rest) next.append(name, v);
    }
  }
  next.delete('page');
  const s = next.toString();
  return s ? `/?${s}` : '/';
}

interface Chip {
  label: string;
  href: string;
}
const chips: Chip[] = [];
if (q) chips.push({ label: `“${q}”`, href: withoutParams([['q']]) });
for (const s of subject) {
  chips.push({ label: subjectLabel(s), href: withoutParams([['subject', s]]) });
}
for (const t of topic) chips.push({ label: topicLabel(t), href: withTopic(t) });
for (const c of category) chips.push({ label: c, href: withoutParams([['category', c]]) });
// Only an explicit window gets a removable chip; the seven-day default shows in the heading.
if (daysParam) chips.push({ label: `Last ${daysParam} days`, href: withoutParams([['days']]) });
if (year) {
  chips.push({
    label: month ? `${year}-${month.padStart(2, '0')}` : year,
    href: withoutParams([['year'], ['month']]),
  });
}
if (author) chips.push({ label: `author: ${author}`, href: withoutParams([['author']]) });
if (venue) chips.push({ label: `venue: ${venue}`, href: withoutParams([['venue']]) });
if (minCitations) {
  chips.push({
    label: `min ${minCitations} citations`,
    href: withoutParams([['min_citations']]),
  });
}
if (sort && sort !== 'newest') {
  chips.push({
    label: sort === 'citations' ? 'Most cited' : 'Most active',
    href: withoutParams([['sort']]),
  });
}
const activeCount = chips.length - (q ? 1 : 0);

// Offered, never applied automatically. A bare "/" that redirected to the saved filters would
// be a trap: pressing back lands on "/", which redirects again, so the unfiltered feed becomes
// unreachable. One link costs a click and surprises nobody.
function describeSaved(query: string): string {
  const saved = new URLSearchParams(query);
  const parts = [
    ...saved.getAll('subject').map(subjectLabel),
    ...saved.getAll('topic').map(topicLabel),
    ...saved.getAll('category'),
  ];
  const days = saved.get('days');
  if (days) parts.push(`last ${days} days`);
  if (saved.get('year')) parts.push(saved.get('year') as string);
  if (saved.get('author')) parts.push(`author: ${saved.get('author')}`);
  return parts.slice(0, 4).join(', ') || 'your filters';
}

// Together rather than one after the other. These were three serial round trips before the
// first byte of the page, which is two full API latencies spent waiting for answers that do
// not depend on each other. Dismissals are the third: the feed endpoint applies them itself
// now, so the page neither fetches nor reasons about them.
const [result, savedPapers, savedFilters] = await Promise.all([
  fetchPapers({
    q,
    days,
    year,
    month,
    author,
    venue,
    minCitations,
    sort,
    category,
    subject,
    topic,
    page,
  }),
  fetchSaved(Astro.locals.accessToken).then((saved) => saved ?? []),
  // Only worth asking on a bare feed: with filters already in the URL there is nothing to
  // resume to.
  Astro.url.search ? Promise.resolve(null) : fetchSavedFilters(Astro.locals.accessToken),
]);
const items = result === null ? null : result.items;
const total = result?.total ?? null;

// The API returns papers newest-first; fold them into one group per publication
// day so the feed reads as a timeline.
const groups: { date: string; papers: PaperSummary[] }[] = [];
for (const paper of items ?? []) {
  const date = formatDate(paper.published_at);
  const last = groups[groups.length - 1];
  if (last && last.date === date) last.papers.push(paper);
  else groups.push({ date, papers: [paper] });
}

function formatDayHeading(iso: string): string {
  return new Date(`${iso}T00:00:00Z`)
    .toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    .toUpperCase();
}

const savedIds = new Set(savedPapers.map((p) => p.id));

// Feed position per paper id for impression telemetry (stable across the day groups).
const rankOf = new Map((items ?? []).map((paper, index) => [paper.id, index]));

// Venue when known, otherwise the arXiv comment ("14 pages, accepted at ...").
function sourceNote(paper: PaperSummary): string | null {
  return paper.venue ?? paper.comment;
}

function truncate(text: string, max = 60): string {
  return text.length > max ? `${text.slice(0, max - 1)}…` : text;
}

function badgesFor(paper: PaperSummary): { primary: string | null; rest: string[]; more: number } {
  const primary = paper.primary_category;
  const rest = paper.categories.filter((cat) => cat !== primary);
  return { primary, rest: rest.slice(0, 3), more: Math.max(0, rest.length - 3) };
}

const pageCount =
  total !== null
    ? Math.max(1, Math.ceil(total / PAGE_SIZE))
    : items?.length === PAGE_SIZE
      ? page + 1
      : page;
const showingFrom = (page - 1) * PAGE_SIZE + 1;
const showingTo = showingFrom + (items?.length ?? 0) - 1;

// Endpoints plus a window around the current page; null marks a gap.
function pageNumbers(current: number, count: number): (number | null)[] {
  const wanted = new Set([1, count, current - 1, current, current + 1]);
  const pages = [...wanted].filter((p) => p >= 1 && p <= count).sort((a, b) => a - b);
  const out: (number | null)[] = [];
  let prev = 0;
  for (const p of pages) {
    if (p - prev > 1) out.push(null);
    out.push(p);
    prev = p;
  }
  return out;
}

function pageLink(target: number): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.set('page', String(target));
  return `/?${next}`;
}
---

<Base>
  <div class="toolbar">
    <button class="btn btn-ghost" type="button" data-open-filters aria-haspopup="dialog">
      <Icon name="lucide:sliders-horizontal" aria-hidden="true" />
      Filters
      {activeCount > 0 && <span class="filter-count">{activeCount}</span>}
    </button>
    <div class="kind-quick" role="group" aria-label="Filter by technique">
      {
        TOPICS.map((option) => (
          /* aria-current, not aria-pressed: these are links to a filtered URL, and
             aria-pressed is only meaningful on something with a button role. */
          <a
            class:list={['kt', { on: topic.includes(option.key) }]}
            href={withTopic(option.key)}
            title={option.label}
            aria-current={topic.includes(option.key) ? 'true' : undefined}
          >
            {option.short}
          </a>
        ))
      }
    </div>
    {
      q && (
        <p class="toolbar-summary">
          Results for <strong>“{q}”</strong>
        </p>
      )
    }
    {
      items !== null && (
        <span class="toolbar-total">
          {total ?? items.length} paper{(total ?? items.length) === 1 ? '' : 's'}
        </span>
      )
    }
  </div>
  {
    savedFilters && (
      <p class="resume">
        <a href={`/?${savedFilters}`}>
          <Icon name="lucide:rotate-ccw" aria-hidden="true" />
          Pick up where you left off: {describeSaved(savedFilters)}
        </a>
      </p>
    )
  }
  {
    chips.length > 0 && (
      <div class="chips">
        {chips.map((chip) => (
          <a class="chip" href={chip.href}>
            {chip.label}
            <Icon name="lucide:x" aria-hidden="true" />
          </a>
        ))}
      </div>
    )
  }

  {
    savedPapers.length > 0 && (
      <section class="reading">
        <div class="reading-head">
          <h2 class="day-heading">Reading list</h2>
          <a class="reading-all" href="/saved">View all</a>
        </div>
        <ul class="reading-items">
          {savedPapers.slice(0, 5).map((paper) => (
            <li>
              <a
                class="reading-title"
                href={`/papers/${paper.id}`}
                set:html={renderMathHTML(paper.title)}
              />
              <SaveButton client:visible paperId={paper.id} saved={true} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    items === null && (
      <div class="card empty is-error">
        <Icon name="lucide:cloud-off" aria-hidden="true" />
        <p>The API is unreachable — try again in a moment.</p>
      </div>
    )
  }
  {
    items !== null && items.length === 0 && (
      <div class="card empty">
        <Icon name="lucide:search-x" aria-hidden="true" />
        <p>No papers match that search — widen the filters and scan again.</p>
      </div>
    )
  }

  {
    items !== null &&
      groups.map((group) => (
        <section class="day">
          <h2 class="day-heading">{formatDayHeading(group.date)}</h2>
          <ul class="feed">
            {group.papers.map((paper) => {
              const note = sourceNote(paper);
              const badges = badgesFor(paper);
              return (
                <li class="row" data-paper-id={paper.id} data-rank={rankOf.get(paper.id)}>
                  <div class="row-head">
                    {/* The name is what lets this title morph into the paper page's heading
                        during navigation. The reading-list preview above deliberately has
                        none: a saved paper can also be in today's feed, and duplicate names
                        on one page cancel the morph. */}
                    <a
                      class="title"
                      href={`/papers/${paper.id}`}
                      transition:name={morphName('paper-title', paper.id)}
                      set:html={renderMathHTML(paper.title)}
                    />
                    <SaveButton client:visible paperId={paper.id} saved={savedIds.has(paper.id)} />
                  </div>
                  <p class="meta">
                    {paper.authors
                      .slice(0, 3)
                      .map((author) => author.name)
                      .join(', ')}
                    {paper.authors.length > 3 && ' et al.'}
                    {note && (
                      <span class="note" title={note}>
                        {' · '}
                        {truncate(note)}
                      </span>
                    )}
                    {paper.citation_count > 0 && (
                      <span class="badge badge-cite">
                        {paper.citation_count} citation{paper.citation_count === 1 ? '' : 's'}
                      </span>
                    )}
                  </p>
                  <p class="tags">
                    {badges.primary && (
                      <span class="badge badge-primary" title={categoryName(badges.primary)}>
                        {badges.primary}
                      </span>
                    )}
                    {badges.rest.map((cat) => (
                      <span class="badge" title={categoryName(cat)}>
                        {cat}
                      </span>
                    ))}
                    {badges.more > 0 && <span class="badge">+{badges.more}</span>}
                    {paper.score !== null && (
                      <span class="badge badge-score">{paper.score.toFixed(3)}</span>
                    )}
                    {paper.pdf_url && (
                      <a class="quick" href={`/papers/${paper.id}?read=1`}>
                        <Icon name="lucide:book-open" aria-hidden="true" />
                        Read
                      </a>
                    )}
                    <button class="dismiss" type="button" data-dismiss aria-label="Dismiss">
                      Dismiss
                    </button>
                  </p>
                  <p class="abstract" set:html={renderMathHTML(paper.abstract)} />
                </li>
              );
            })}
          </ul>
        </section>
      ))
  }

  {
    items !== null && !q && pageCount > 1 && (
      <nav class="pager" aria-label="Pagination">
        {total !== null && items.length > 0 && (
          <span class="showing">
            Showing {showingFrom}–{showingTo} of {total}
          </span>
        )}
        <div class="pages">
          {page > 1 && (
            <a class="btn btn-ghost" href={pageLink(page - 1)}>
              <Icon name="lucide:chevron-left" aria-hidden="true" />
              Newer
            </a>
          )}
          {pageNumbers(page, pageCount).map((p) =>
            p === null ? (
              <span class="gap">…</span>
            ) : p === page ? (
              <span class="current" aria-current="page">
                {p}
              </span>
            ) : (
              <a class="page-num" href={pageLink(p)}>
                {p}
              </a>
            ),
          )}
          {page < pageCount && (
            <a class="btn btn-ghost" href={pageLink(page + 1)}>
              Older
              <Icon name="lucide:chevron-right" aria-hidden="true" />
            </a>
          )}
        </div>
      </nav>
    )
  }

  <Telemetry client:idle surface={q ? 'search' : 'feed'} enabled={Astro.locals.user !== null} />
  <DismissNotice client:idle />
  <FilterSidebar
    client:load
    initial={{
      subjects: subject,
      topics: topic,
      categories: category,
      days: daysParam,
      year,
      month,
      sort,
      minCitations,
      author,
      venue,
    }}
  />
</Base>

<style>
  /* Feed toolbar: the sidebar trigger and the live result count, always visible. */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-4);
  }
  .toolbar .btn {
    padding: 0.4rem 0.9rem;
  }
  .kind-quick {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    /* Scrolls rather than clips if the topic set ever outgrows the row. */
    overflow-x: auto;
    overflow-y: hidden;
  }
  .kind-quick .kt {
    padding: 0.35rem 0.8rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .kind-quick .kt:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .kind-quick .kt.on {
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 0.72rem;
    font-weight: 650;
  }
  .toolbar-summary {
    margin: 0;
    font-size: var(--text-md);
  }
  .toolbar-total {
    margin-left: auto;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  /* Above the chips because it is an offer rather than a state: nothing is filtered yet. */
  .resume {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
  }
  .resume a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    text-decoration: none;
  }
  .resume a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .resume :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-5);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .chip:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
  }
  .chip :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--muted);
  }
  .reading {
    margin-bottom: var(--space-6);
  }
  .reading-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .reading-head .day-heading {
    border-bottom: none;
    padding-bottom: 0;
    text-transform: uppercase;
  }
  .reading-all {
    font-size: 0.8rem;
    text-decoration: none;
  }
  .reading-all:hover {
    text-decoration: underline;
  }
  .reading-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reading-items li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }
  .reading-items li:last-child {
    border-bottom: none;
  }
  .reading-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--ink);
    text-decoration: none;
  }
  .reading-title:hover {
    color: var(--accent);
  }
  .day {
    margin-bottom: var(--space-6);
  }
  /* The date follows you down its own run of papers, so a long day never leaves you
     wondering what you are looking at. Sticks under the header, not the top of the window,
     and carries the same bleed as the rows so nothing scrolls through beside it. */
  .day .day-heading {
    position: sticky;
    top: var(--nav-height);
    z-index: 1;
    margin: 0 -0.75rem;
    padding: 0.35rem 0.75rem 0.5rem;
    background: var(--bg);
  }
  .day-heading {
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Bled slightly into the gutter so the hover fill reads as the row, not as a box drawn
     inside it. The separator is a pseudo-element rather than a border because a border
     would follow the rounded corners of that fill. */
  .row {
    position: relative;
    padding: 0.85rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: var(--radius-sm);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .row:hover {
    background: var(--surface-2);
  }
  .row::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0;
    height: 1px;
    background: var(--line);
  }
  .row:last-child::after {
    display: none;
  }
  /* Leaving slides and collapses, so the list closes over the gap instead of jumping.
     Telemetry fixes the row's height inline before this class lands - which is what lets
     height transition to zero - and detaches the node only once the collapse has run.
     Under reduced motion the removal is synchronous and none of this plays. */
  .row.going {
    opacity: 0;
    transform: translateX(1.5rem);
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      height var(--dur-slow) var(--ease-out),
      padding var(--dur-slow) var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .row.going {
      transition: none;
    }
  }
  .row-head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .title {
    flex: 1;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.4rem 0 0;
  }
  .note {
    color: var(--muted);
  }
  .meta .badge {
    margin-left: 0.5rem;
    vertical-align: 0.1em;
  }
  .badge-cite {
    background: var(--surface-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0.45rem 0 0;
  }
  .badge-primary {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  /* Pushed to the far end of the tag row, away from the category badges, with the two
     actions spaced enough not to read as one control. */
  .quick {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    padding-right: 0.4rem;
    color: var(--muted);
    font-size: 0.8rem;
    white-space: nowrap;
    text-decoration: none;
  }
  .quick:hover {
    color: var(--accent);
  }
  .quick :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }
  .dismiss {
    border: none;
    background: none;
    padding: 0;
    color: var(--muted);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .dismiss:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  /* Capped measure, per the layout rule that long-form text caps its own: at a wide window
     the column runs past 1100px, and a two-line abstract that wide is a scan, not a read. */
  .abstract {
    margin: 0.4rem 0 0;
    max-width: 105ch;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: var(--space-5);
  }
