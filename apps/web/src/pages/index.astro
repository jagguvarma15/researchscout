---
import { Icon } from 'astro-icon/components';
import DismissNotice from '../components/DismissNotice.svelte';
import EmptyState from '../components/EmptyState.astro';
import FilterSidebar from '../components/FilterSidebar.svelte';
import Pager from '../components/Pager.astro';
import PaperList from '../components/PaperList.astro';
import SaveButton from '../components/SaveButton.svelte';
import Telemetry from '../components/Telemetry.svelte';
import Base from '../layouts/Base.astro';
import { catalogMessage, fetchPapers, fetchSaved, fetchSavedFilters, PAGE_SIZE } from '../lib/api';
import { renderMathHTML } from '../lib/math';
import { pageLink } from '../lib/paging';
import { FEED_DEFAULTS_COOKIE, parseFeedDefaults } from '../lib/prefs';
import { subjectLabel, TOPICS, topicLabel } from '../lib/taxonomy';

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const daysParam = params.get('days') ?? '';
const year = params.get('year') ?? '';
const month = params.get('month') ?? '';
const author = params.get('author') ?? '';
const venue = params.get('venue') ?? '';
const minCitations = params.get('min_citations') ?? '';
const sortParam = params.get('sort') ?? '';
const category = params.getAll('category');
const subject = params.getAll('subject');
const topicParam = params.getAll('topic');
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

// The feed is a radar, so it opens on the last week. A default rather than a cap: an explicit
// ?days= or ?year= wins, the filters can widen it, and every link ever shared still resolves.
// A search is not the feed and is never windowed.
const DEFAULT_DAYS = '7';

// The settings drawer can choose how the front page opens (sort, window, technique); those
// ride a cookie because this render is where they apply. Only a URL that asks for nothing
// gets them - page is deliberately absent from the list, so paging keeps the defaults - and
// the chip below links to an explicit ?days=7, which reproduces the stock radar and
// suppresses the merge. Nothing redirects, so every state stays reachable (same stance as
// the saved-filters offer further down). The 'all' window is internal only: the API takes
// numeric days or none, so it becomes "no window" here and is never sent or linked.
const FILTER_PARAMS = ['q', 'days', 'year', 'month', 'author', 'venue', 'min_citations', 'sort', 'category', 'subject', 'topic'];
const defaults = FILTER_PARAMS.some((name) => params.has(name))
  ? null
  : parseFeedDefaults(Astro.cookies.get(FEED_DEFAULTS_COOKIE)?.value);
const sort = defaults?.sort ?? sortParam;
const topic = defaults?.topic ? [defaults.topic] : topicParam;
const days = defaults?.days
  ? defaults.days === 'all'
    ? ''
    : defaults.days
  : daysParam || (q || year ? '' : DEFAULT_DAYS);

// Topic toggles: the same URL with one technique added or removed (page reset).
function withTopic(value: string): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  const current = next.getAll('topic');
  next.delete('topic');
  for (const item of current) {
    if (item !== value) next.append('topic', item);
  }
  if (!current.includes(value)) next.append('topic', value);
  next.delete('page');
  const query = next.toString();
  return query ? `/?${query}` : '/';
}

// Per-chip removal links: the same URL minus one param (or one value of a repeated param).
function withoutParams(names: [string, string?][]): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  for (const [name, value] of names) {
    if (value === undefined) {
      next.delete(name);
    } else {
      const rest = next.getAll(name).filter((v) => v !== value);
      next.delete(name);
      for (const v of rest) next.append(name, v);
    }
  }
  next.delete('page');
  const s = next.toString();
  return s ? `/?${s}` : '/';
}

interface Chip {
  label: string;
  href: string;
}
const chips: Chip[] = [];
// First, because it explains the state of everything after it. Its clear link is explicit
// rather than bare, which is what suppresses the merge above.
if (defaults) chips.push({ label: 'Your defaults', href: '/?days=7' });
if (q) chips.push({ label: `“${q}”`, href: withoutParams([['q']]) });
for (const s of subject) {
  chips.push({ label: subjectLabel(s), href: withoutParams([['subject', s]]) });
}
for (const t of topic) chips.push({ label: topicLabel(t), href: withTopic(t) });
for (const c of category) chips.push({ label: c, href: withoutParams([['category', c]]) });
// Only an explicit window gets a removable chip; the seven-day default shows in the heading.
if (daysParam) chips.push({ label: `Last ${daysParam} days`, href: withoutParams([['days']]) });
if (year) {
  chips.push({
    label: month ? `${year}-${month.padStart(2, '0')}` : year,
    href: withoutParams([['year'], ['month']]),
  });
}
if (author) chips.push({ label: `author: ${author}`, href: withoutParams([['author']]) });
if (venue) chips.push({ label: `venue: ${venue}`, href: withoutParams([['venue']]) });
if (minCitations) {
  chips.push({
    label: `min ${minCitations} citations`,
    href: withoutParams([['min_citations']]),
  });
}
if (sort && sort !== 'newest') {
  chips.push({
    label: sort === 'citations' ? 'Most cited' : 'Most active',
    href: withoutParams([['sort']]),
  });
}
const activeCount = chips.length - (q ? 1 : 0);

// Offered, never applied automatically. A bare "/" that redirected to the saved filters would
// be a trap: pressing back lands on "/", which redirects again, so the unfiltered feed becomes
// unreachable. One link costs a click and surprises nobody.
function describeSaved(query: string): string {
  const saved = new URLSearchParams(query);
  const parts = [
    ...saved.getAll('subject').map(subjectLabel),
    ...saved.getAll('topic').map(topicLabel),
    ...saved.getAll('category'),
  ];
  const days = saved.get('days');
  if (days) parts.push(`last ${days} days`);
  if (saved.get('year')) parts.push(saved.get('year') as string);
  if (saved.get('author')) parts.push(`author: ${saved.get('author')}`);
  return parts.slice(0, 4).join(', ') || 'your filters';
}

// Together rather than one after the other. These were three serial round trips before the
// first byte of the page, which is two full API latencies spent waiting for answers that do
// not depend on each other. Dismissals are the third: the feed endpoint applies them itself
// now, so the page neither fetches nor reasons about them.
const [result, savedResult, savedFilters] = await Promise.all([
  fetchPapers({
    q,
    days,
    year,
    month,
    author,
    venue,
    minCitations,
    sort,
    category,
    subject,
    topic,
    page,
  }),
  fetchSaved(Astro.locals.accessToken),
  // Only worth asking on a bare feed: with filters already in the URL there is nothing to
  // resume to.
  Astro.url.search ? Promise.resolve(null) : fetchSavedFilters(Astro.locals.accessToken),
]);
// The reading-list preview is auxiliary: when its read fails the preview simply stays off,
// while the main list's failure below is reported in full.
const savedPapers = savedResult.ok ? savedResult.data : [];
const items = result.ok ? result.data.items : null;
const total = result.ok ? result.data.total : null;

const savedIds = new Set(savedPapers.map((p) => p.id));

// Feed position per paper id for impression telemetry (stable across the day groups).
const rankOf = new Map((items ?? []).map((paper, index) => [paper.id, index]));

const pageCount =
  total !== null
    ? Math.max(1, Math.ceil(total / PAGE_SIZE))
    : items?.length === PAGE_SIZE
      ? page + 1
      : page;
const showingFrom = (page - 1) * PAGE_SIZE + 1;
const showingTo = showingFrom + (items?.length ?? 0) - 1;
---

<Base>
  <div class="toolbar">
    <button class="btn btn-ghost" type="button" data-open-filters aria-haspopup="dialog">
      <Icon name="lucide:sliders-horizontal" aria-hidden="true" />
      Filters
      {activeCount > 0 && <span class="filter-count">{activeCount}</span>}
    </button>
    <div class="kind-quick" role="group" aria-label="Filter by technique">
      {
        TOPICS.map((option) => (
          /* aria-current, not aria-pressed: these are links to a filtered URL, and
             aria-pressed is only meaningful on something with a button role. */
          <a
            class:list={['kt', { on: topic.includes(option.key) }]}
            href={defaults?.topic === option.key ? '/?days=7' : withTopic(option.key)}
            title={option.label}
            aria-current={topic.includes(option.key) ? 'true' : undefined}
          >
            {/* The pill lit by a cookie default toggles off through the same explicit
                clear as the chip - withTopic would add the param and light it harder. */}
            {option.short}
          </a>
        ))
      }
    </div>
    {/* The page's one h1 is the summary line the toolbar already carried: it names what
        the list below is, for everyone, and for a screen reader it replaces landing on a
        bare date. */}
    <h1 class="toolbar-summary">
      {q ? (
        <Fragment>
          Results for <strong>“{q}”</strong>
        </Fragment>
      ) : (
        'Latest papers'
      )}
    </h1>
    {
      items !== null && (
        <span class="toolbar-total">
          {total ?? items.length} paper{(total ?? items.length) === 1 ? '' : 's'}
        </span>
      )
    }
  </div>
  {
    savedFilters && (
      <p class="resume">
        <a href={`/?${savedFilters}`}>
          <Icon name="lucide:rotate-ccw" aria-hidden="true" />
          Pick up where you left off: {describeSaved(savedFilters)}
        </a>
      </p>
    )
  }
  {
    chips.length > 0 && (
      <div class="chips">
        {chips.map((chip) => (
          <a class="chip" href={chip.href}>
            {chip.label}
            <Icon name="lucide:x" aria-hidden="true" />
          </a>
        ))}
      </div>
    )
  }

  {
    savedPapers.length > 0 && (
      <section class="reading">
        <div class="reading-head">
          <h2 class="reading-heading">Reading list</h2>
          <a class="reading-all" href="/saved">View all</a>
        </div>
        <ul class="reading-items">
          {savedPapers.slice(0, 5).map((paper) => (
            <li>
              {/* No morph name here on purpose: a saved paper can also be in today's
                  feed, and duplicate names on one page cancel the morph. */}
              <a
                class="reading-title"
                href={`/papers/${paper.id}`}
                set:html={renderMathHTML(paper.title)}
              />
              <SaveButton client:visible paperId={paper.id} saved={true} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    !result.ok && (
      <EmptyState
        kind="error"
        icon="lucide:cloud-off"
        message={catalogMessage(result.failure, 'papers')}
        action={{ href: Astro.url.pathname + Astro.url.search, label: 'Retry' }}
      />
    )
  }
  {
    result.ok && result.data.items.length === 0 && (
      <EmptyState
        icon="lucide:search-x"
        message="No papers match that search - widen the filters and scan again."
      />
    )
  }

  {
    items !== null && items.length > 0 && (
      <PaperList papers={items} savedIds={savedIds} rankOf={rankOf} dismissible={true} />
    )
  }

  {
    items !== null && !q && pageCount > 1 && (
      <Pager
        page={page}
        pageCount={pageCount}
        link={(target) => pageLink(Astro.url.searchParams, target)}
        total={total}
        showingFrom={showingFrom}
        showingTo={showingTo}
        directional={true}
      />
    )
  }

  <Telemetry client:idle surface={q ? 'search' : 'feed'} enabled={Astro.locals.user !== null} />
  <DismissNotice client:idle />
  <FilterSidebar
    client:load
    initial={{
      subjects: subject,
      topics: topicParam,
      categories: category,
      days: daysParam,
      year,
      month,
      sort: sortParam,
      minCitations,
      author,
      venue,
    }}
  />
</Base>

<style>
  /* Feed toolbar: the sidebar trigger and the live result count, always visible. */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-4);
  }
  .toolbar .btn {
    padding: 0.4rem 0.9rem;
  }
  .kind-quick {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    /* Scrolls rather than clips if the topic set ever outgrows the row. */
    overflow-x: auto;
    overflow-y: hidden;
  }
  .kind-quick .kt {
    padding: 0.35rem 0.8rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .kind-quick .kt:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .kind-quick .kt.on {
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 0.72rem;
    font-weight: 650;
  }
  /* An h1 in a toolbar's clothing: the size and weight of the summary line it replaced,
     because the heading's job here is naming the list, not dominating it. */
  .toolbar-summary {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 500;
  }
  .toolbar-total {
    margin-left: auto;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  /* Above the chips because it is an offer rather than a state: nothing is filtered yet. */
  .resume {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
  }
  .resume a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    text-decoration: none;
  }
  .resume a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .resume :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-5);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .chip:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
  }
  .chip :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--muted);
  }
  .reading {
    margin-bottom: var(--space-6);
  }
  .reading-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  /* The day headings' register (their styles live with PaperList now), uppercased, minus
     the border the .reading-head already draws. */
  .reading-heading {
    margin: 0;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .reading-all {
    font-size: 0.8rem;
    text-decoration: none;
  }
  .reading-all:hover {
    text-decoration: underline;
  }
  .reading-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reading-items li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }
  .reading-items li:last-child {
    border-bottom: none;
  }
  .reading-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--ink);
    text-decoration: none;
  }
  .reading-title:hover {
    color: var(--accent);
  }
  @media (max-width: 40rem) {
    /* At this width the toolbar wraps; the count reads better under it than squeezed
       against the right edge of a wrapped row. */
    .toolbar-total {
      margin-left: 0;
    }
    .chip {
      padding: 0.4rem 0.8rem;
    }
    .kind-quick .kt {
      padding: 0.5rem 0.9rem;
    }
  }
  /* Pointer polish: the pills and links above declare hover colors that used to snap, and
     nothing on the page acknowledged a press. One block, so the feed's controls share the
     buttons' timing. */
  .chip,
  .kt {
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .chip:active,
  .kt:active {
    transform: scale(0.96);
  }
  .reading-title,
  .reading-all {
    transition: color var(--dur-fast) var(--ease-out);
  }
</style>
