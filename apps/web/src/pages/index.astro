---
import { Icon } from 'astro-icon/components';
import FilterSidebar from '../components/FilterSidebar.svelte';
import SaveButton from '../components/SaveButton.svelte';
import Telemetry from '../components/Telemetry.svelte';
import Base from '../layouts/Base.astro';
import { fetchPapers, fetchSaved, formatDate, PAGE_SIZE, type PaperSummary } from '../lib/api';
import { renderMathHTML } from '../lib/math';
import { categoryName, groupLabel } from '../lib/taxonomy';

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const days = params.get('days') ?? '';
const year = params.get('year') ?? '';
const month = params.get('month') ?? '';
const kindParam = params.get('kind') ?? '';
const author = params.get('author') ?? '';
const venue = params.get('venue') ?? '';
const minCitations = params.get('min_citations') ?? '';
const sort = params.get('sort') ?? '';
const category = params.getAll('category');
const group = params.getAll('group');
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

// Web-level AI default: a bare feed reads as kind=ai, explicit off is ?kind=all (treated as
// unfiltered and never forwarded), and searches stay unfiltered. The API keeps no default.
const kind = kindParam || (q ? 'all' : 'ai');

// Toggle/chip links: the same URL with kind replaced (page reset). Setting kind=all rather
// than deleting the param is what keeps the ai default from resurrecting.
function withKind(value: string): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.set('kind', value);
  next.delete('page');
  return `/?${next}`;
}

// Per-chip removal links: the same URL minus one param (or one value of a repeated param).
function withoutParams(names: [string, string?][]): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  for (const [name, value] of names) {
    if (value === undefined) {
      next.delete(name);
    } else {
      const rest = next.getAll(name).filter((v) => v !== value);
      next.delete(name);
      for (const v of rest) next.append(name, v);
    }
  }
  next.delete('page');
  const s = next.toString();
  return s ? `/?${s}` : '/';
}

interface Chip {
  label: string;
  href: string;
}
const chips: Chip[] = [];
if (q) chips.push({ label: `“${q}”`, href: withoutParams([['q']]) });
const kindLabels: Record<string, string> = { ai: 'AI', tech: 'Tech', non_tech: 'Non-tech' };
// Only an explicit kind gets a removable chip; the implicit ai default shows through the
// active toolbar toggle alone. kind=all never gets a chip.
if (kindParam && kindParam in kindLabels) {
  chips.push({ label: kindLabels[kindParam], href: withKind('all') });
}
for (const g of group) chips.push({ label: groupLabel(g), href: withoutParams([['group', g]]) });
for (const c of category) chips.push({ label: c, href: withoutParams([['category', c]]) });
if (days) chips.push({ label: `Last ${days} days`, href: withoutParams([['days']]) });
if (year) {
  chips.push({
    label: month ? `${year}-${month.padStart(2, '0')}` : year,
    href: withoutParams([['year'], ['month']]),
  });
}
if (author) chips.push({ label: `author: ${author}`, href: withoutParams([['author']]) });
if (venue) chips.push({ label: `venue: ${venue}`, href: withoutParams([['venue']]) });
if (minCitations) {
  chips.push({
    label: `min ${minCitations} citations`,
    href: withoutParams([['min_citations']]),
  });
}
if (sort && sort !== 'newest') {
  chips.push({
    label: sort === 'citations' ? 'Most cited' : 'Most active',
    href: withoutParams([['sort']]),
  });
}
const activeCount = chips.length - (q ? 1 : 0);

const result = await fetchPapers({
  q,
  days,
  year,
  month,
  kind: kind === 'all' ? '' : kind,
  author,
  venue,
  minCitations,
  sort,
  category,
  group,
  page,
});
const items = result === null ? null : result.items;
const total = result?.total ?? null;

// The API returns papers newest-first; fold them into one group per publication
// day so the feed reads as a timeline.
const groups: { date: string; papers: PaperSummary[] }[] = [];
for (const paper of items ?? []) {
  const date = formatDate(paper.published_at);
  const last = groups[groups.length - 1];
  if (last && last.date === date) last.papers.push(paper);
  else groups.push({ date, papers: [paper] });
}

function formatDayHeading(iso: string): string {
  return new Date(`${iso}T00:00:00Z`)
    .toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    .toUpperCase();
}

const savedPapers: PaperSummary[] = (await fetchSaved(Astro.locals.accessToken)) ?? [];
const savedIds = new Set(savedPapers.map((p) => p.id));

// Feed position per paper id for impression telemetry (stable across the day groups).
const rankOf = new Map((items ?? []).map((paper, index) => [paper.id, index]));

// Venue when known, otherwise the arXiv comment ("14 pages, accepted at ...").
function sourceNote(paper: PaperSummary): string | null {
  return paper.venue ?? paper.comment;
}

function truncate(text: string, max = 60): string {
  return text.length > max ? `${text.slice(0, max - 1)}…` : text;
}

function badgesFor(paper: PaperSummary): { primary: string | null; rest: string[]; more: number } {
  const primary = paper.primary_category;
  const rest = paper.categories.filter((cat) => cat !== primary);
  return { primary, rest: rest.slice(0, 3), more: Math.max(0, rest.length - 3) };
}

const pageCount =
  total !== null
    ? Math.max(1, Math.ceil(total / PAGE_SIZE))
    : items?.length === PAGE_SIZE
      ? page + 1
      : page;
const showingFrom = (page - 1) * PAGE_SIZE + 1;
const showingTo = showingFrom + (items?.length ?? 0) - 1;

// Endpoints plus a window around the current page; null marks a gap.
function pageNumbers(current: number, count: number): (number | null)[] {
  const wanted = new Set([1, count, current - 1, current, current + 1]);
  const pages = [...wanted].filter((p) => p >= 1 && p <= count).sort((a, b) => a - b);
  const out: (number | null)[] = [];
  let prev = 0;
  for (const p of pages) {
    if (p - prev > 1) out.push(null);
    out.push(p);
    prev = p;
  }
  return out;
}

function pageLink(target: number): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.set('page', String(target));
  return `/?${next}`;
}
---

<Base>
  <div class="toolbar">
    <button class="btn btn-ghost" type="button" data-open-filters aria-haspopup="dialog">
      <Icon name="lucide:sliders-horizontal" aria-hidden="true" />
      Filters
      {activeCount > 0 && <span class="filter-count">{activeCount}</span>}
    </button>
    <div class="kind-quick" role="group" aria-label="Quick kind filter">
      <a
        class:list={['kt', { on: kind === 'ai' }]}
        href={withKind(kind === 'ai' ? 'all' : 'ai')}
        aria-current={kind === 'ai' ? 'true' : undefined}
      >
        AI
      </a>
      <a
        class:list={['kt', { on: kind === 'tech' }]}
        href={withKind(kind === 'tech' ? 'all' : 'tech')}
        aria-current={kind === 'tech' ? 'true' : undefined}
      >
        Tech
      </a>
    </div>
    {
      q && (
        <p class="toolbar-summary">
          Results for <strong>“{q}”</strong>
        </p>
      )
    }
    {
      items !== null && (
        <span class="toolbar-total">
          {total ?? items.length} paper{(total ?? items.length) === 1 ? '' : 's'}
        </span>
      )
    }
  </div>
  {
    chips.length > 0 && (
      <div class="chips">
        {chips.map((chip) => (
          <a class="chip" href={chip.href}>
            {chip.label}
            <Icon name="lucide:x" aria-hidden="true" />
          </a>
        ))}
      </div>
    )
  }

  {
    savedPapers.length > 0 && (
      <section class="reading">
        <div class="reading-head">
          <h2 class="day-heading">Reading list</h2>
          <a class="reading-all" href="/saved">View all</a>
        </div>
        <ul class="reading-items">
          {savedPapers.slice(0, 5).map((paper) => (
            <li>
              <a
                class="reading-title"
                href={`/papers/${paper.id}`}
                set:html={renderMathHTML(paper.title)}
              />
              <SaveButton client:visible paperId={paper.id} saved={true} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    items === null && (
      <div class="card empty">
        <Icon name="lucide:cloud-off" aria-hidden="true" />
        <p>The API is unreachable — try again in a moment.</p>
      </div>
    )
  }
  {
    items !== null && items.length === 0 && (
      <div class="card empty">
        <Icon name="lucide:search-x" aria-hidden="true" />
        <p>No papers match that search — widen the filters and scan again.</p>
      </div>
    )
  }

  {
    items !== null &&
      groups.map((group) => (
        <section class="day">
          <h2 class="day-heading">{formatDayHeading(group.date)}</h2>
          <ul class="feed">
            {group.papers.map((paper) => {
              const note = sourceNote(paper);
              const badges = badgesFor(paper);
              return (
                <li class="row" data-paper-id={paper.id} data-rank={rankOf.get(paper.id)}>
                  <div class="row-head">
                    <a
                      class="title"
                      href={`/papers/${paper.id}`}
                      set:html={renderMathHTML(paper.title)}
                    />
                    <SaveButton client:visible paperId={paper.id} saved={savedIds.has(paper.id)} />
                  </div>
                  <p class="meta">
                    {paper.authors
                      .slice(0, 3)
                      .map((author) => author.name)
                      .join(', ')}
                    {paper.authors.length > 3 && ' et al.'}
                    {note && (
                      <span class="note" title={note}>
                        {' · '}
                        {truncate(note)}
                      </span>
                    )}
                    {paper.citation_count > 0 && (
                      <span class="badge badge-cite">
                        {paper.citation_count} citation{paper.citation_count === 1 ? '' : 's'}
                      </span>
                    )}
                  </p>
                  <p class="tags">
                    {badges.primary && (
                      <span class="badge badge-primary" title={categoryName(badges.primary)}>
                        {badges.primary}
                      </span>
                    )}
                    {badges.rest.map((cat) => (
                      <span class="badge" title={categoryName(cat)}>
                        {cat}
                      </span>
                    ))}
                    {badges.more > 0 && <span class="badge">+{badges.more}</span>}
                    {paper.score !== null && (
                      <span class="badge badge-score">{paper.score.toFixed(3)}</span>
                    )}
                    {paper.pdf_url && (
                      <span class="quick">
                        <a href={`/papers/${paper.id}?read=1`}>Read</a>
                        {' · '}
                        <a href={`/papers/${paper.id}?read=1`}>PDF</a>
                      </span>
                    )}
                    <button class="dismiss" type="button" data-dismiss aria-label="Not interested">
                      Dismiss
                    </button>
                  </p>
                  <p class="abstract" set:html={renderMathHTML(paper.abstract)} />
                </li>
              );
            })}
          </ul>
        </section>
      ))
  }

  {
    items !== null && !q && pageCount > 1 && (
      <nav class="pager" aria-label="Pagination">
        {total !== null && items.length > 0 && (
          <span class="showing">
            Showing {showingFrom}–{showingTo} of {total}
          </span>
        )}
        <div class="pages">
          {page > 1 && (
            <a class="btn btn-ghost" href={pageLink(page - 1)}>
              <Icon name="lucide:chevron-left" aria-hidden="true" />
              Newer
            </a>
          )}
          {pageNumbers(page, pageCount).map((p) =>
            p === null ? (
              <span class="gap">…</span>
            ) : p === page ? (
              <span class="current" aria-current="page">
                {p}
              </span>
            ) : (
              <a class="page-num" href={pageLink(p)}>
                {p}
              </a>
            ),
          )}
          {page < pageCount && (
            <a class="btn btn-ghost" href={pageLink(page + 1)}>
              Older
              <Icon name="lucide:chevron-right" aria-hidden="true" />
            </a>
          )}
        </div>
      </nav>
    )
  }

  <Telemetry client:idle surface={q ? 'search' : 'feed'} enabled={Astro.locals.user !== null} />
  <FilterSidebar
    client:load
    initial={{
      kind,
      groups: group,
      categories: category,
      days,
      year,
      month,
      sort,
      minCitations,
      author,
      venue,
    }}
  />
</Base>

<style>
  /* Feed toolbar: the sidebar trigger and the live result count, always visible. */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-4);
  }
  .toolbar .btn {
    padding: 0.4rem 0.9rem;
  }
  .kind-quick {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .kind-quick .kt {
    padding: 0.35rem 0.8rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .kind-quick .kt:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .kind-quick .kt.on {
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 0.72rem;
    font-weight: 650;
  }
  .toolbar-summary {
    margin: 0;
    font-size: var(--text-md);
  }
  .toolbar-total {
    margin-left: auto;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-5);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .chip:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
  }
  .chip :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--muted);
  }
  .empty p {
    margin: 0;
  }
  .reading {
    margin-bottom: var(--space-6);
  }
  .reading-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .reading-head .day-heading {
    border-bottom: none;
    padding-bottom: 0;
    text-transform: uppercase;
  }
  .reading-all {
    font-size: 0.8rem;
    text-decoration: none;
  }
  .reading-all:hover {
    text-decoration: underline;
  }
  .reading-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reading-items li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }
  .reading-items li:last-child {
    border-bottom: none;
  }
  .reading-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--ink);
    text-decoration: none;
  }
  .reading-title:hover {
    color: var(--accent);
  }
  .day {
    margin-bottom: var(--space-6);
  }
  .day-heading {
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: none;
  }
  .row-head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .title {
    flex: 1;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.4rem 0 0;
  }
  .note {
    color: var(--muted);
  }
  .meta .badge {
    margin-left: 0.5rem;
    vertical-align: 0.1em;
  }
  .badge-cite {
    background: var(--surface-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0.45rem 0 0;
  }
  .badge-primary {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .quick {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .quick a {
    color: var(--muted);
    text-decoration: none;
  }
  .quick a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .dismiss {
    border: none;
    background: none;
    padding: 0;
    color: var(--muted);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .dismiss:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .abstract {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: var(--space-5);
  }
  .showing {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .pages {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }
  .page-num,
  .current,
  .gap {
    min-width: 2rem;
    padding: 0.35rem 0.5rem;
    text-align: center;
    font-size: 0.88rem;
    border-radius: var(--radius-sm);
  }
  .page-num {
    color: var(--ink);
    text-decoration: none;
  }
  .page-num:hover {
    background: var(--surface-2);
  }
  .current {
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .gap {
    color: var(--muted);
  }
  @media (max-width: 40rem) {
    .filter {
      flex: 1;
    }
    .pages {
      margin-left: 0;
    }
  }
</style>
