---
import Base from '../layouts/Base.astro';
import { fetchPapers, formatDate, PAGE_SIZE } from '../lib/api';

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const days = params.get('days') ?? '';
const category = params.get('category') ?? '';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

const items = await fetchPapers({ q, days, category, page });

function pageLink(target: number): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.set('page', String(target));
  return `/?${next}`;
}
---

<Base>
  <form method="get" action="/">
    <input type="search" name="q" placeholder="Search papers semantically…" value={q} />
    <input type="text" name="category" placeholder="cs.LG" value={category} size="8" />
    <input type="number" name="days" placeholder="days" value={days} min="1" max="365" size="5" />
    <button type="submit">Search</button>
  </form>

  {items === null && <p class="empty">The API is unreachable — try again in a moment.</p>}
  {items !== null && items.length === 0 && <p class="empty">No papers found.</p>}

  {
    items !== null && (
      <ul class="feed">
        {items.map((paper) => (
          <li>
            <a class="title" href={`/papers/${paper.id}`}>
              {paper.title}
            </a>
            <p class="meta">
              {formatDate(paper.published_at)}
              {' · '}
              {paper.authors
                .slice(0, 3)
                .map((author) => author.name)
                .join(', ')}
              {paper.authors.length > 3 && ' et al.'}
              {paper.categories.map((cat) => (
                <span class="badge">{cat}</span>
              ))}
              {paper.score !== null && <span class="badge score">{paper.score.toFixed(3)}</span>}
            </p>
            <p class="abstract">{paper.abstract}</p>
          </li>
        ))}
      </ul>
    )
  }

  {
    items !== null && !q && (
      <nav class="pager">
        {page > 1 && <a href={pageLink(page - 1)}>&larr; Newer</a>}
        {items.length === PAGE_SIZE && <a href={pageLink(page + 1)}>Older &rarr;</a>}
      </nav>
    )
  }
</Base>

<style>
  form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  input[type='search'] {
    flex: 1;
  }
  input,
  button {
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    font: inherit;
  }
  button {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    cursor: pointer;
  }
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .feed li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .title {
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.25rem 0;
  }
  .badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
  }
  .badge.score {
    border-color: var(--accent);
    color: var(--accent);
  }
  .abstract {
    margin: 0.25rem 0 0;
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .empty {
    color: var(--muted);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    padding-top: 1rem;
  }
</style>
