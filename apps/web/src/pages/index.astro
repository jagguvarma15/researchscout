---
import { Icon } from 'astro-icon/components';
import SaveButton from '../components/SaveButton.svelte';
import Base from '../layouts/Base.astro';
import { fetchPapers, fetchSaved, formatDate, PAGE_SIZE, type PaperSummary } from '../lib/api';

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const days = params.get('days') ?? '';
const category = params.get('category') ?? '';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

const items = await fetchPapers({ q, days, category, page });

// The API returns papers newest-first; fold them into one group per publication
// day so the feed reads as a timeline.
const groups: { date: string; papers: PaperSummary[] }[] = [];
for (const paper of items ?? []) {
  const date = formatDate(paper.published_at);
  const last = groups[groups.length - 1];
  if (last && last.date === date) last.papers.push(paper);
  else groups.push({ date, papers: [paper] });
}

function formatDayHeading(iso: string): string {
  return new Date(`${iso}T00:00:00Z`)
    .toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    .toUpperCase();
}

const savedPapers: PaperSummary[] = (await fetchSaved()) ?? [];
const savedIds = new Set(savedPapers.map((p) => p.id));

function pageLink(target: number): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.set('page', String(target));
  return `/?${next}`;
}
---

<Base>
  {
    (q || category || days) && (
      <div class="active-search">
        <p class="active-summary">
          {q ? (
            <>
              Results for <strong>“{q}”</strong>
            </>
          ) : (
            'Filtered feed'
          )}
          {items !== null && (
            <span class="active-count">
              {items.length} {items.length === 1 ? 'result' : 'results'}
            </span>
          )}
        </p>
        <form class="active-controls" method="get" action="/">
          {q && <input type="hidden" name="q" value={q} />}
          <input
            class="input filter"
            type="text"
            name="category"
            placeholder="cs.LG"
            aria-label="Category"
            value={category}
            size="8"
          />
          <input
            class="input filter"
            type="number"
            name="days"
            placeholder="days"
            aria-label="Days back"
            value={days}
            min="1"
            max="365"
            size="5"
          />
          <button class="btn btn-ghost" type="submit">Apply</button>
          <a class="btn btn-ghost" href="/">
            <Icon name="lucide:x" aria-hidden="true" />
            Clear
          </a>
        </form>
      </div>
    )
  }

  {
    savedPapers.length > 0 && (
      <section class="reading">
        <div class="reading-head">
          <h2 class="day-heading">Reading list</h2>
          <a class="reading-all" href="/saved">View all</a>
        </div>
        <ul class="reading-items">
          {savedPapers.slice(0, 5).map((paper) => (
            <li>
              <a class="reading-title" href={`/papers/${paper.id}`}>
                {paper.title}
              </a>
              <SaveButton client:visible paperId={paper.id} saved={true} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    items === null && (
      <div class="card empty">
        <Icon name="lucide:cloud-off" aria-hidden="true" />
        <p>The API is unreachable — try again in a moment.</p>
      </div>
    )
  }
  {
    items !== null && items.length === 0 && (
      <div class="card empty">
        <Icon name="lucide:search-x" aria-hidden="true" />
        <p>No papers match that search — widen the filters and scan again.</p>
      </div>
    )
  }

  {
    items !== null &&
      groups.map((group) => (
        <section class="day">
          <h2 class="day-heading">{formatDayHeading(group.date)}</h2>
          <ul class="feed">
            {group.papers.map((paper) => (
              <li class="row">
                <div class="row-head">
                  <a class="title" href={`/papers/${paper.id}`}>
                    {paper.title}
                  </a>
                  <SaveButton client:visible paperId={paper.id} saved={savedIds.has(paper.id)} />
                </div>
                <p class="meta">
                  {paper.authors
                    .slice(0, 3)
                    .map((author) => author.name)
                    .join(', ')}
                  {paper.authors.length > 3 && ' et al.'}
                  {paper.categories.map((cat) => (
                    <span class="badge">{cat}</span>
                  ))}
                  {paper.score !== null && (
                    <span class="badge badge-score">{paper.score.toFixed(3)}</span>
                  )}
                </p>
                <p class="abstract">{paper.abstract}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
  }

  {
    items !== null && !q && (
      <nav class="pager" aria-label="Pagination">
        {page > 1 && (
          <a class="btn btn-ghost" href={pageLink(page - 1)}>
            <Icon name="lucide:chevron-left" aria-hidden="true" />
            Newer
          </a>
        )}
        {items.length === PAGE_SIZE && (
          <a class="btn btn-ghost older" href={pageLink(page + 1)}>
            Older
            <Icon name="lucide:chevron-right" aria-hidden="true" />
          </a>
        )}
      </nav>
    )
  }
</Base>

<style>
  /* Active-search bar: shown only when a query or filter is live — the navbar
     palette owns search entry. */
  .active-search {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-6);
  }
  .active-summary {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: var(--text-md);
  }
  .active-count {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .active-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .active-controls .btn {
    padding: 0.4rem 0.9rem;
  }
  .filter {
    width: 6.5rem;
    padding: 0.45rem 0.6rem;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .filter:focus-visible {
    color: var(--ink);
  }
  .empty p {
    margin: 0;
  }
  .reading {
    margin-bottom: var(--space-6);
  }
  .reading-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .reading-head .day-heading {
    border-bottom: none;
    padding-bottom: 0;
    text-transform: uppercase;
  }
  .reading-all {
    font-size: 0.8rem;
    text-decoration: none;
  }
  .reading-all:hover {
    text-decoration: underline;
  }
  .reading-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reading-items li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }
  .reading-items li:last-child {
    border-bottom: none;
  }
  .reading-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--ink);
    text-decoration: none;
  }
  .reading-title:hover {
    color: var(--accent);
  }
  .day {
    margin-bottom: var(--space-6);
  }
  .day-heading {
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: none;
  }
  .row-head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .title {
    flex: 1;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.4rem 0 0;
  }
  .meta .badge {
    margin-left: 0.5rem;
    vertical-align: 0.1em;
  }
  .abstract {
    max-width: 70ch;
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: var(--space-5);
  }
  .pager .older {
    margin-left: auto;
  }
  @media (max-width: 40rem) {
    .filter {
      flex: 1;
    }
  }
</style>
