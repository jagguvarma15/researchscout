---
import { Icon } from 'astro-icon/components';
import DataAsOf from '../components/DataAsOf.astro';
import EmptyState from '../components/EmptyState.astro';
import PageIntro from '../components/PageIntro.astro';
import Pager from '../components/Pager.astro';
import Base from '../layouts/Base.astro';
import {
  catalogMessage,
  fetchCatalogFreshness,
  fetchModels,
  fetchNotableModels,
  MODEL_PAGE_SIZE,
  MODEL_SORTS,
  type AiModel,
} from '../lib/api';
import { barWidth as computeBar } from '../lib/bars';
import { compact, exponent, weightsLabel } from '../lib/format';
import { morphName } from '../lib/morph';
import { pageLink } from '../lib/paging';

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const organization = params.get('organization') ?? '';
const domain = params.get('domain') ?? '';
const openWeights = params.get('open_weights') ?? '';
const withPaper = params.get('with_paper') === 'true';
const rawSort = params.get('sort') ?? 'released';
const sort = (MODEL_SORTS as readonly string[]).includes(rawSort) ? rawSort : 'released';
// Dates and sizes read high-to-low when you first click them; names read from A.
const DESCENDING_BY_DEFAULT = new Set(['released', 'parameters', 'compute', 'downloads']);
const rawDirection = params.get('dir');
const descending =
  rawDirection === 'asc' ? false : rawDirection === 'desc' ? true : DESCENDING_BY_DEFAULT.has(sort);
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

const [result, notableResult, freshnessResult] = await Promise.all([
  fetchModels({
    q,
    organization,
    domain,
    openWeights,
    withPaper,
    sort,
    direction: descending ? 'desc' : 'asc',
    page,
  }),
  fetchNotableModels(),
  fetchCatalogFreshness(),
]);
const modelsAsOf = freshnessResult.ok ? freshnessResult.data.models_at : null;
// Best-effort: the strip renders when it has rows and stays out of the way otherwise. The
// main table's error card already reports catalogue trouble; a second one would say it twice.
const notable = notableResult.ok ? notableResult.data : [];
const models = result.ok ? result.data.items : null;
const total = result.ok ? result.data.total : 0;
// Kept apart from "no rows": a backend that has never been refreshed and one that is older
// than this page are different problems with different fixes, and saying "unreachable" for
// both is what made this take an evening to work out.
const failure = result.ok ? null : result.failure;

// Relative bars on the currently sorted numeric column only: sorting is what asks the
// distribution question, and bars on every column at once are noise. Compute spans twelve
// orders of magnitude and reads on a log bar, matching its exponent rendering; the others
// are linear against the page's own maximum.
const barValue = (model: AiModel): number | null =>
  sort === 'parameters'
    ? model.parameters
    : sort === 'compute'
      ? model.training_compute_flop
      : sort === 'downloads'
        ? model.hf_downloads
        : null;
const barMax = Math.max(...(models ?? []).map((model) => barValue(model) ?? 0), 0);

function barWidth(model: AiModel): number | null {
  return computeBar(barValue(model), barMax, { log: sort === 'compute' });
}

function sortAria(key: string): 'ascending' | 'descending' | 'none' {
  if (sort !== key) return 'none';
  return descending ? 'descending' : 'ascending';
}

/**
 * Where a column heading goes: to this column, or to the other direction if already on it.
 *
 * The toggle is the point. Without it a second click on the sorted column rebuilt the URL it
 * was already on, so the page did not move and the sort read as broken - which is exactly how
 * it was reported.
 */
function sortLink(key: string): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.set('sort', key);
  const flipped = sort === key ? !descending : DESCENDING_BY_DEFAULT.has(key);
  next.set('dir', flipped ? 'desc' : 'asc');
  next.delete('page');
  return `/models?${next}`;
}

// The table's columns in order. A `key` makes the heading a sort link; the three without one
// are not usefully sortable (a field list, a three-value flag, and a link).
const COLUMNS: { key?: string; label: string; num?: boolean }[] = [
  { key: 'name', label: 'Model' },
  { key: 'organization', label: 'Organisation' },
  { key: 'released', label: 'Released' },
  { label: 'Field' },
  { key: 'parameters', label: 'Parameters', num: true },
  { key: 'compute', label: 'Compute', num: true },
  { label: 'Weights' },
  { key: 'downloads', label: 'Downloads', num: true },
  { label: 'Paper' },
];

// The domains Epoch AI files models under. Listed rather than derived so the filter row is
// stable whatever this page happens to be showing.
const DOMAINS = ['Language', 'Vision', 'Multimodal', 'Speech', 'Image generation', 'Robotics'];

function withParam(name: string, value: string): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  if (value) next.set(name, value);
  else next.delete(name);
  next.delete('page');
  const query = next.toString();
  return query ? `/models?${query}` : '/models';
}

/** Epoch AI files a model under domains; the Hub knows only its task. Either will do. */
function field(model: AiModel): string {
  return model.domains.join(', ') || model.task || '';
}

const pageCount = Math.max(1, Math.ceil(total / MODEL_PAGE_SIZE));
---

<Base title="Models">
  <PageIntro
    title="AI models"
    lede="Language, vision and multimodal models with the facts that let you compare them: who built them, how large, on how much compute, and whether the weights are yours to run. Models whose paper is in this corpus link straight to it."
  />

  <DataAsOf date={modelsAsOf} label="Catalogue data as of" />

  {
    notable.length > 0 && (
      <section class="notable">
        <h2>Recent models from the major labs</h2>
        <p class="lede-sm">
          What the curated providers shipped in the last year, newest first. The full catalogue
          below covers everything and takes filters.
        </p>
        <div class="table-scroll">
          {/* No morph names here: a model in this strip is usually in the main table too,
              and duplicate view-transition names on one page cancel the morph. */}
          <table class="data-table notable-table">
            <thead>
              <tr>
                <th scope="col" class="cell-name">Model</th>
                <th scope="col">Lab</th>
                <th scope="col">Released</th>
                <th scope="col" class="cell-num">Parameters</th>
                <th scope="col">Weights</th>
              </tr>
            </thead>
            <tbody>
              {notable.map((model) => (
                <tr>
                  <th scope="row" class="cell-name">
                    <a href={`/models/${model.id}`}>{model.name}</a>
                  </th>
                  <td class="cell-muted">{model.provider}</td>
                  <td class="cell-muted">{model.published_on ?? ''}</td>
                  <td class="cell-num">{compact(model.parameters)}</td>
                  <td class="cell-muted">
                    {model.open_weights === null ? 'unknown' : model.open_weights ? 'open' : 'closed'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <form class="find" method="get" role="search">
    {/* Every other filter rides along as a hidden field, so searching narrows what is on
        screen rather than resetting it. */}
    {domain && <input type="hidden" name="domain" value={domain} />}
    {organization && <input type="hidden" name="organization" value={organization} />}
    {openWeights && <input type="hidden" name="open_weights" value={openWeights} />}
    {withPaper && <input type="hidden" name="with_paper" value="true" />}
    {sort !== 'released' && <input type="hidden" name="sort" value={sort} />}
    {rawDirection && <input type="hidden" name="dir" value={rawDirection} />}
    <Icon name="lucide:search" aria-hidden="true" />
    <input type="search" name="q" value={q} placeholder="Find a model by name" aria-label="Find a model by name" />
    {q && <a class="clear" href={withParam('q', '')}>Clear</a>}
  </form>

  <div class="filters" role="group" aria-label="Filter models">
    <a class:list={['chip-toggle', { on: !domain }]} href={withParam('domain', '')}>All fields</a>
    {
      DOMAINS.map((name) => (
        <a
          class:list={['chip-toggle', { on: domain === name }]}
          href={withParam('domain', domain === name ? '' : name)}
        >
          {name}
        </a>
      ))
    }
    <span class="spacer"></span>
    <a
      class:list={['chip-toggle', { on: openWeights === 'true' }]}
      href={withParam('open_weights', openWeights === 'true' ? '' : 'true')}
    >
      Open weights
    </a>
    <a
      class:list={['chip-toggle', { on: withPaper }]}
      href={withParam('with_paper', withPaper ? '' : 'true')}
    >
      Has a paper here
    </a>
  </div>

  {
    failure && (
      <EmptyState
        kind="error"
        icon="lucide:cloud-off"
        message={catalogMessage(failure, 'models')}
        action={{ href: Astro.url.pathname + Astro.url.search, label: 'Retry' }}
      />
    )
  }
  {
    models !== null && models.length === 0 && (
      <EmptyState
        icon="lucide:box"
        message={
          q || domain || organization || openWeights || withPaper
            ? 'No models match those filters - widen them.'
            : 'The catalogue is empty. It fills on the daily refresh, or run scout catalog now.'
        }
      />
    )
  }

  {
    models !== null && models.length > 0 && (
      <Fragment>
        <p class="count">
          {total} model{total === 1 ? '' : 's'}
        </p>
        <div class="table-scroll">
          <table class="data-table catalog-table">
            <thead>
              <tr>
                {COLUMNS.map((column) => (
                  <th
                    scope="col"
                    class:list={[{ 'cell-num': column.num }]}
                    aria-sort={column.key ? sortAria(column.key) : undefined}
                  >
                    {column.key ? (
                      <a class="sortable" href={sortLink(column.key)}>
                        {column.label}
                        {sort === column.key && (
                          <Icon
                            name={descending ? 'lucide:chevron-down' : 'lucide:chevron-up'}
                            aria-hidden="true"
                          />
                        )}
                      </a>
                    ) : (
                      column.label
                    )}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {models.map((model) => (
                <tr>
                  <th scope="row" class="cell-name">
                    {/* Its own page rather than straight out to the upstream: that page is
                        where the scores and the paper join live, and the outbound link is on
                        it. A table of external links leaves nothing to come back to. */}
                    <a href={`/models/${model.id}`} transition:name={morphName('model', model.id)}>
                      {model.name}
                    </a>
                  </th>
                  <td class="cell-muted cell-clip" title={model.organization ?? undefined}>
                    {model.organization ?? ''}
                  </td>
                  <td class="cell-muted">{model.publication_date ?? ''}</td>
                  <td class="cell-muted cell-clip" title={field(model) || undefined}>
                    {field(model)}
                  </td>
                  <td
                    class:list={['cell-num', { barcell: sort === 'parameters' }]}
                    title={model.parameters ? String(model.parameters) : undefined}
                  >
                    <span class="bnum">{compact(model.parameters)}</span>
                    {sort === 'parameters' && barWidth(model) !== null && (
                      <span class="dbar" style={`width:${barWidth(model)}%`} />
                    )}
                  </td>
                  <td
                    class:list={['cell-num', { barcell: sort === 'compute' }]}
                    title={model.training_compute_flop ? `${model.training_compute_flop} FLOP` : undefined}
                  >
                    <span class="bnum">{exponent(model.training_compute_flop)}</span>
                    {sort === 'compute' && barWidth(model) !== null && (
                      <span class="dbar" style={`width:${barWidth(model)}%`} />
                    )}
                  </td>
                  <td>
                    <span class:list={['badge', `w-${weightsLabel(model.open_weights)}`]}>
                      {weightsLabel(model.open_weights)}
                    </span>
                  </td>
                  <td class:list={['cell-num', 'cell-muted', { barcell: sort === 'downloads' }]}>
                    <span class="bnum">
                      {model.hf_downloads === null ? '' : model.hf_downloads.toLocaleString('en-US')}
                    </span>
                    {sort === 'downloads' && barWidth(model) !== null && (
                      <span class="dbar" style={`width:${barWidth(model)}%`} />
                    )}
                  </td>
                  <td>
                    {model.paper_id && (
                      <a class="paper-link" href={`/papers/${model.paper_id}`}>
                        <Icon name="lucide:file-text" aria-hidden="true" />
                        Read
                      </a>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Fragment>
    )
  }

  {
    models !== null && pageCount > 1 && (
      <Pager
        variant="prevnext"
        page={page}
        pageCount={pageCount}
        link={(target) => pageLink(Astro.url.searchParams, target, '/models')}
      />
    )
  }

  <p class="credit">
    Model facts from <a href="https://epoch.ai" rel="noopener noreferrer">Epoch AI</a> (CC BY),
    download counts from the
    <a href="https://huggingface.co" rel="noopener noreferrer">Hugging Face Hub</a>. Refreshed
    daily; see <a href="/about">About</a>.
  </p>
</Base>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: var(--space-4);
  }
  /* Pushes the two boolean filters away from the field list, so they read as a different
     question rather than as two more fields. */
  .spacer {
    flex: 1 1 1rem;
  }
  .chip-toggle {
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .chip-toggle:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .chip-toggle.on {
    border-color: transparent;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .count {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .find {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 22rem;
    margin-bottom: var(--space-3);
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--muted);
  }
  .find:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .find input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
  }
  .find .clear {
    flex-shrink: 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  /* The whole heading is the target, so the hit area is the cell rather than the word. */
  .sortable {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .sortable:hover {
    color: var(--accent);
  }
  .sortable :global(svg) {
    width: 0.85em;
    height: 0.85em;
  }
  /* The sorted column, marked off the same attribute a screen reader reads, so the two can
     never disagree about which one it is. */
  th[aria-sort='descending'],
  th[aria-sort='ascending'] {
    color: var(--ink);
  }
  .w-open {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .paper-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .paper-link :global(svg) {
    width: 0.95em;
    height: 0.95em;
  }
  .credit {
    margin-top: var(--space-5);
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .notable {
    margin-bottom: var(--space-6);
  }
  .notable h2 {
    margin: 0 0 0.25rem;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }
  .lede-sm {
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-size: var(--text-sm);
    max-width: 65ch;
  }

  /* Below this a nine-column table is a scroll bar with a table attached. The container still
     scrolls, so nothing is unreachable; the columns that carry the comparison just go first.
     Scoped to the main catalogue table by position - the notable strip above has five columns
     with different meanings, and hiding its by the same ordinals would clip it blind. */
  @media (max-width: 60rem) {
    .catalog-table :global(td:nth-child(6)),
    .catalog-table :global(th:nth-child(6)),
    .catalog-table :global(td:nth-child(8)),
    .catalog-table :global(th:nth-child(8)) {
      display: none;
    }
  }
  /* Finger-sized filters: the chip row and the search field are the page's controls,
       and at phone width their hit areas grow the way the feed's chips do. */
  @media (max-width: 40rem) {
    .chip-toggle {
      padding: 0.5rem 0.85rem;
    }
    .find {
      padding: 0.5rem 0.8rem;
    }
    .find .clear {
      padding: 0.4rem 0.3rem;
      margin: -0.4rem 0;
    }
  }
  @media (max-width: 42rem) {
    .catalog-table :global(td:nth-child(4)),
    .catalog-table :global(th:nth-child(4)),
    .catalog-table :global(td:nth-child(5)),
    .catalog-table :global(th:nth-child(5)) {
      display: none;
    }
    /* The strip keeps Model, Lab, Released - parameters and weights are catalogue detail,
       and a phone reads this table as a headline list. */
    .notable-table :global(td:nth-child(4)),
    .notable-table :global(th:nth-child(4)),
    .notable-table :global(td:nth-child(5)),
    .notable-table :global(th:nth-child(5)) {
      display: none;
    }
  }
</style>
