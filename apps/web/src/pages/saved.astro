---
import { Icon } from 'astro-icon/components';
import SaveButton from '../components/SaveButton.svelte';
import Base from '../layouts/Base.astro';
import { fetchSaved, formatDate, type PaperSummary } from '../lib/api';
import { getAccessToken, SESSION_COOKIE } from '../lib/auth';

const authenticated = Astro.locals.user !== null;
let items: PaperSummary[] | null = null;
if (authenticated) {
  const sid = Astro.cookies.get(SESSION_COOKIE)?.value;
  const token = sid ? await getAccessToken(sid) : null;
  if (token) items = await fetchSaved(token);
}
---

<Base title="Saved papers">
  <h1 class="page-title">Saved papers</h1>

  {
    !authenticated && (
      <div class="card empty">
        <Icon name="lucide:lock" aria-hidden="true" />
        <p>
          <a href="/auth/login?returnTo=/saved">Sign in</a> to keep a reading list.
        </p>
      </div>
    )
  }
  {
    authenticated && items === null && (
      <div class="card empty">
        <Icon name="lucide:cloud-off" aria-hidden="true" />
        <p>The API is unreachable — try again in a moment.</p>
      </div>
    )
  }
  {
    authenticated && items !== null && items.length === 0 && (
      <div class="card empty">
        <Icon name="lucide:bookmark-plus" aria-hidden="true" />
        <p>
          Nothing saved yet — bookmark papers in the <a href="/">feed</a>.
        </p>
      </div>
    )
  }

  {
    authenticated && items !== null && (
      <ul class="feed">
        {items.map((paper) => (
          <li class="row">
            <div class="row-head">
              <a class="title" href={`/papers/${paper.id}`}>
                {paper.title}
              </a>
              <SaveButton client:visible paperId={paper.id} saved={true} {authenticated} />
            </div>
            <p class="meta">
              {formatDate(paper.published_at)}
              {' · '}
              {paper.authors
                .slice(0, 3)
                .map((author) => author.name)
                .join(', ')}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .empty p {
    margin: 0;
  }
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .row:first-child {
    padding-top: 0;
  }
  .row-head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .title {
    flex: 1;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.35rem 0 0;
  }
</style>
