---
import EmptyState from '../components/EmptyState.astro';
import PageIntro from '../components/PageIntro.astro';
import PaperList from '../components/PaperList.astro';
import Base from '../layouts/Base.astro';
import { catalogMessage, fetchSaved } from '../lib/api';

const result = await fetchSaved(Astro.locals.accessToken);
---

<Base title="Saved papers">
  <PageIntro title="Saved papers" />

  {
    !result.ok ? (
      <EmptyState
        kind="error"
        icon="lucide:cloud-off"
        message={catalogMessage(result.failure, 'reading list')}
        action={{ href: '/saved', label: 'Retry' }}
      />
    ) : result.data.length === 0 ? (
      <EmptyState
        icon="lucide:bookmark-plus"
        message="Nothing saved yet."
        hint="Bookmark a paper anywhere and it lands here."
        action={{ href: '/', label: 'Browse the feed' }}
      />
    ) : (
      <PaperList
        papers={result.data}
        savedIds={new Set(result.data.map((paper) => paper.id))}
        density="compact"
      />
    )
  }
</Base>
