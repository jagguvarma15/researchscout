---
import { Icon } from 'astro-icon/components';
import CiteActions from '../../components/CiteActions.svelte';
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import PdfReader from '../../components/PdfReader.svelte';
import SaveButton from '../../components/SaveButton.svelte';
import SignalMark from '../../components/SignalMark.astro';
import Telemetry from '../../components/Telemetry.svelte';
import Base from '../../layouts/Base.astro';
import {
  fetchModels,
  fetchPaper,
  fetchRelated,
  fetchSaved,
  type AiModel,
  type PaperSummary,
} from '../../lib/api';
import { renderMathHTML, stripMath } from '../../lib/math';
import { morphName } from '../../lib/morph';
import { categoryName } from '../../lib/taxonomy';

// Rest param, not a plain [id]: canonical ids like doi:10.1145/nnn.mmm contain slashes.
const id = Astro.params.id ?? '';
const paper = await fetchPaper(id);
if (paper === null) {
  Astro.response.status = 404;
}

let saved = false;
if (paper !== null) {
  const savedResult = await fetchSaved(Astro.locals.accessToken);
  saved = savedResult.ok && savedResult.data.some((p) => p.id === paper.id);
}

// The real neighborhood: citation-graph references and citers plus embedding neighbors,
// one endpoint. The detail response carries the paper's own momentum in score, so the
// title-as-query self-search this page once ran is gone.
let relatedSections: { title: string; items: PaperSummary[] }[] = [];
// Models the catalogue says came out of this paper. Usually none: most papers are not a model
// release, and the section is simply absent when that is so.
let models: AiModel[] = [];
const signalScore: number | null = paper?.score ?? null;
// Momentum totals are small absolute numbers; the page's meters read relative within this
// paper's own neighborhood - itself and its related work.
let signalMax = 1;
if (paper !== null) {
  const [related, catalogue] = await Promise.all([
    fetchRelated(paper.id),
    fetchModels({ paperId: paper.id }),
  ]);
  if (related !== null) {
    relatedSections = [
      { title: 'Cited by', items: related.cited_by },
      { title: 'References', items: related.references },
      { title: 'Similar papers', items: related.similar },
    ].filter((section) => section.items.length > 0);
  }
  const neighborhood = relatedSections.flatMap((section) => section.items);
  signalMax = Math.max(...neighborhood.map((hit) => hit.score ?? 0), signalScore ?? 0) || 1;
  // A failed catalogue read costs this section, never the paper: the reason for the failure
  // belongs on /models, where somebody went looking for models.
  models = catalogue.ok ? catalogue.data.items : [];
}

const orderedCategories =
  paper === null
    ? []
    : [
        ...(paper.primary_category ? [paper.primary_category] : []),
        ...paper.categories.filter((cat) => cat !== paper.primary_category),
      ];

// BibTeX is rendered server-side so the citation stays readable without JavaScript.
function bibtexFor(p: PaperSummary): string {
  const key = p.id.replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  const lines = [
    `@article{${key},`,
    `  title = {${p.title}},`,
    `  author = {${p.authors.map((author) => author.name).join(' and ')}},`,
    `  year = {${p.published_at.slice(0, 4)}},`,
  ];
  if (p.id.startsWith('arxiv:')) lines.push(`  eprint = {${p.id.slice('arxiv:'.length)}},`);
  if (p.url) lines.push(`  url = {${p.url}},`);
  lines.push('}');
  return lines.join('\n');
}

const bibtex = paper === null ? '' : bibtexFor(paper);

const published =
  paper === null
    ? ''
    : new Date(paper.published_at).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC',
      });
---

<Base title={paper ? stripMath(paper.title) : 'Not found'}>
  {
    paper === null ? (
      <Fragment>
        <PageIntro title="Paper not found" />
        <EmptyState
          icon="lucide:file-question"
          message={`Nothing stored under ${id}.`}
          action={{ href: '/', label: 'Back to the feed' }}
        />
      </Fragment>
    ) : (
      <article>
        <div class="head">
          <h1 transition:name={morphName('paper-title', paper.id)} set:html={renderMathHTML(paper.title)} />
          <SaveButton client:load paperId={paper.id} {saved} />
        </div>
        <div class="meta-band">
          <span class="pair"><b>Published</b>{published}</span>
          {paper.venue && (
            <span class="pair">
              <b>Venue</b>
              {paper.venue}
            </span>
          )}
          {paper.citation_count > 0 && (
            <span class="pair">
              <b>Citations</b>
              {paper.citation_count.toLocaleString('en-US')}
            </span>
          )}
          <span class="pair"><b>ID</b><code>{paper.id}</code></span>
        </div>
        <p class="tags cats">
          {orderedCategories.map((cat, index) => (
            <span
              class={index === 0 && paper.primary_category ? 'badge badge-primary' : 'badge'}
              title={categoryName(cat)}
            >
              {cat}
            </span>
          ))}
        </p>
        {paper.comment && <p class="comment">{paper.comment}</p>}
        {signalScore !== null && (
          <div class="sig-block">
            <SignalMark
              score={signalScore}
              max={signalMax}
              label="momentum, relative among related work"
            />
            <span class="sig-legend">
              Signal — momentum from citations and discussion, relative among related work
            </span>
          </div>
        )}
        <p class="links">
          {paper.pdf_url && (
            <button class="btn btn-primary" type="button" data-open-reader>
              <Icon name="lucide:book-open" aria-hidden="true" />
              Read
            </button>
          )}
          {paper.url && (
            <a class="btn btn-ghost" href={paper.url} rel="noopener">
              <Icon name="lucide:external-link" aria-hidden="true" />
              Landing page
            </a>
          )}
          {paper.pdf_url && (
            <a class="btn btn-ghost" href={paper.pdf_url} rel="noopener">
              <Icon name="lucide:file-text" aria-hidden="true" />
              PDF
            </a>
          )}
          <button
            class="btn btn-ghost"
            type="button"
            data-ask-scout
            data-paper-id={paper.id}
            data-paper-title={stripMath(paper.title)}
          >
            <Icon name="lucide:message-circle" aria-hidden="true" />
            Ask Scout
          </button>
          <a class="btn btn-ghost back" href="/">
            <Icon name="lucide:chevron-left" aria-hidden="true" />
            Back to the feed
          </a>
        </p>
        <div class="cite-row">
          <CiteActions client:load bibtex={bibtex} url={Astro.url.href} />
        </div>
        <h2 class="a-label">Abstract</h2>
        <p class="abstract" set:html={renderMathHTML(paper.abstract)} />
        <h2 class="a-label">Authors</h2>
        <p class="authors">
          {paper.authors.map((author, index) => (
            <Fragment>
              {index > 0 && ', '}
              <b>{author.name}</b>
              {author.affiliation && <span class="affil"> ({author.affiliation})</span>}
            </Fragment>
          ))}
        </p>
        {paper.keywords && paper.keywords.length > 0 && (
          <Fragment>
            <h2 class="a-label">Keywords</h2>
            <p class="tags">
              {paper.keywords.map((keyword) => (
                <a class="badge" href={`/?keyword=${encodeURIComponent(keyword)}`}>
                  {keyword}
                </a>
              ))}
            </p>
          </Fragment>
        )}
        {paper.pdf_url && (
          <PdfReader
            client:load
            pdfUrl={paper.pdf_url}
            title={stripMath(paper.title)}
            paperId={paper.id}
            initialOpen={Astro.url.searchParams.get('read') === '1'}
          />
        )}
        <Telemetry client:idle surface="detail" paperId={paper.id} enabled={Astro.locals.user !== null} />
        {models.length > 0 && (
          <section class="related">
            <h2 class="related-title">Models from this paper</h2>
            <ul class="models">
              {models.map((model) => (
                <li>
                  {model.link ? (
                    <a href={model.link} rel="noopener noreferrer nofollow" target="_blank">
                      {model.name}
                    </a>
                  ) : (
                    <span>{model.name}</span>
                  )}
                  {model.organization && <span class="model-org">{model.organization}</span>}
                  {model.hf_downloads !== null && (
                    <span class="badge" title="Hugging Face downloads">
                      {model.hf_downloads.toLocaleString('en-US')}
                    </span>
                  )}
                </li>
              ))}
            </ul>
            <a class="all-models" href="/models">Every model in the catalogue</a>
          </section>
        )}
        {relatedSections.map((section) => (
          <section class="related">
            <h2 class="related-title">{section.title}</h2>
            <ul>
              {section.items.map((hit) => (
                <li>
                  <a
                    class="related-link"
                    href={`/papers/${hit.id}`}
                    set:html={renderMathHTML(hit.title)}
                  />
                  {hit.score !== null && (
                    <SignalMark
                      score={hit.score}
                      max={signalMax}
                      label="momentum, relative among related work"
                    />
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </article>
    )
  }
</Base>

<style>
  .head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  /* The reading surface: serif display title, editorial abstract. The title keeps its
     morph name - a font change does not affect the view transition. */
  h1 {
    flex: 1;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-tight);
    margin: 0;
    text-wrap: balance;
  }
  /* Labeled pairs instead of a run-on dot line: each fact announces itself. */
  .meta-band {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    align-items: baseline;
    margin: 0.9rem 0 0;
    font-size: var(--text-xs);
  }
  .meta-band .pair b {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    margin-right: 0.4rem;
  }
  .meta-band code {
    font-size: 0.75rem;
    background: var(--surface-2);
    border-radius: 6px;
    padding: 0.05rem 0.4rem;
    overflow-wrap: anywhere;
  }
  .cats {
    margin-top: 0.6rem;
  }
  .badge-primary {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .comment {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    font-style: italic;
  }
  .sig-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0.9rem 0 0;
  }
  .sig-legend {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  /* The small uppercase section label, same recipe as the related-section headings. */
  .a-label {
    margin: var(--space-6) 0 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-caps-wide);
    text-transform: uppercase;
  }
  .authors {
    font-size: var(--text-sm);
    margin: 0.9rem 0 0;
  }
  .authors b {
    font-weight: var(--weight-medium);
  }
  .authors .affil {
    color: var(--muted);
  }
  /* The abstract is the lede: serif, a step up, relaxed leading, full ink - set to be
     read, not skimmed. No drop cap; abstracts open with "We propose". Full column width:
     a measure cap here left the page ragged against its own section rules. */
  .abstract {
    white-space: pre-line;
    margin: 0.9rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: var(--leading-relaxed);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.9rem 0 0;
  }
  .tags a {
    text-decoration: none;
  }
  .tags a:hover {
    background: var(--surface-2);
  }
  /* The action bar sits under the meta, before the read - act before you scroll. */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
  }
  .links .back {
    margin-left: auto;
  }
  /* Wrapped to two or three lines on a phone, the buttons breathe better with a hair more
     row gap, and the back link joins the flow instead of floating right. */
  @media (max-width: 40rem) {
    .links {
      gap: 0.7rem 0.6rem;
    }
    .links .back {
      margin-left: 0;
    }
    /* The labeled pairs stack in twos on a phone; a tighter column gap keeps the band
       from reading as separate lines. */
    .meta-band {
      gap: 0.35rem 1rem;
    }
  }
  .cite-row {
    margin-top: 0.75rem;
  }
  .related {
    margin-top: var(--space-6);
  }
  .related-title {
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }
  .related li:last-child {
    border-bottom: none;
  }
  .related-link {
    flex: 1;
    min-width: 0;
    font-weight: 550;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .related-link:hover {
    color: var(--accent);
  }
  /* A model row is a name, who built it, and how used it is - the three things that say
     whether it is worth following. The first takes the space the other two do not need. */
  .models li a,
  .models li > span:first-child {
    flex: 1;
    min-width: 0;
    font-weight: 550;
    font-size: 0.95rem;
  }
  .model-org {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .all-models {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: var(--text-sm);
  }
</style>
