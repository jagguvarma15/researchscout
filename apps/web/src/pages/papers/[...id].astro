---
import { Icon } from 'astro-icon/components';
import CiteActions from '../../components/CiteActions.svelte';
import SaveButton from '../../components/SaveButton.svelte';
import Base from '../../layouts/Base.astro';
import { fetchPaper, fetchPapers, fetchSaved, formatDate, type PaperSummary } from '../../lib/api';
import { getAccessToken, SESSION_COOKIE } from '../../lib/auth';

// Rest param, not a plain [id]: canonical ids like doi:10.1145/nnn.mmm contain slashes.
const id = Astro.params.id ?? '';
const paper = await fetchPaper(id);
if (paper === null) {
  Astro.response.status = 404;
}

const authenticated = Astro.locals.user !== null;
let saved = false;
if (authenticated && paper !== null) {
  const sid = Astro.cookies.get(SESSION_COOKIE)?.value;
  const token = sid ? await getAccessToken(sid) : null;
  if (token) saved = ((await fetchSaved(token)) ?? []).some((p) => p.id === paper.id);
}

// Related papers ride the hybrid search with the title as the query — no new backend.
let related: PaperSummary[] = [];
if (paper !== null) {
  const hits = await fetchPapers({ q: paper.title });
  related = (hits ?? []).filter((hit) => hit.id !== paper.id).slice(0, 4);
}

// BibTeX is rendered server-side so the citation stays readable without JavaScript.
function bibtexFor(p: PaperSummary): string {
  const key = p.id.replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  const lines = [
    `@article{${key},`,
    `  title = {${p.title}},`,
    `  author = {${p.authors.map((author) => author.name).join(' and ')}},`,
    `  year = {${p.published_at.slice(0, 4)}},`,
  ];
  if (p.id.startsWith('arxiv:')) lines.push(`  eprint = {${p.id.slice('arxiv:'.length)}},`);
  if (p.url) lines.push(`  url = {${p.url}},`);
  lines.push('}');
  return lines.join('\n');
}

const bibtex = paper === null ? '' : bibtexFor(paper);
---

<Base title={paper?.title ?? 'Not found'}>
  {
    paper === null ? (
      <div class="card empty">
        <Icon name="lucide:file-question" aria-hidden="true" />
        <div>
          <h1 class="notfound-title">Paper not found</h1>
          <p class="notfound-body">
            Nothing stored under <code>{id}</code>. <a href="/">Back to the feed</a>.
          </p>
        </div>
      </div>
    ) : (
      <article>
        <div class="head">
          <h1>{paper.title}</h1>
          <SaveButton client:load paperId={paper.id} {saved} {authenticated} />
        </div>
        <p class="meta">
          {formatDate(paper.published_at)}
          {paper.venue && ` · ${paper.venue}`}
          {' · '}
          <code>{paper.id}</code>
          {paper.categories.map((cat) => (
            <span class="badge">{cat}</span>
          ))}
        </p>
        <p class="authors">
          {paper.authors
            .map((author) =>
              author.affiliation ? `${author.name} (${author.affiliation})` : author.name,
            )
            .join(', ')}
        </p>
        <p class="abstract">{paper.abstract}</p>
        <p class="links">
          {paper.url && (
            <a class="btn btn-ghost" href={paper.url} rel="noopener">
              <Icon name="lucide:external-link" aria-hidden="true" />
              Landing page
            </a>
          )}
          {paper.pdf_url && (
            <a class="btn btn-ghost" href={paper.pdf_url} rel="noopener">
              <Icon name="lucide:file-text" aria-hidden="true" />
              PDF
            </a>
          )}
          <a class="btn btn-ghost back" href="/">
            <Icon name="lucide:chevron-left" aria-hidden="true" />
            Back to the feed
          </a>
        </p>
        <div class="cite-row">
          <CiteActions client:load bibtex={bibtex} url={Astro.url.href} />
        </div>
        {related.length > 0 && (
          <section class="related">
            <h2 class="related-title">Related papers</h2>
            <ul>
              {related.map((hit) => (
                <li>
                  <a class="related-link" href={`/papers/${hit.id}`}>
                    {hit.title}
                  </a>
                  {hit.score !== null && (
                    <span class="badge badge-score">{hit.score.toFixed(3)}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>
    )
  }
</Base>

<style>
  .notfound-title {
    font-size: var(--text-lg);
    margin: 0 0 0.25rem;
  }
  .notfound-body {
    margin: 0;
  }
  .head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  h1 {
    flex: 1;
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.6rem 0 0;
  }
  .meta code {
    font-size: 0.8rem;
    background: var(--surface-2);
    border-radius: 6px;
    padding: 0.05rem 0.4rem;
    overflow-wrap: anywhere;
  }
  .meta .badge {
    margin-left: 0.5rem;
    vertical-align: 0.1em;
  }
  .authors {
    max-width: 70ch;
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0.6rem 0 0;
  }
  .abstract {
    max-width: 70ch;
    white-space: pre-line;
    margin: 1.1rem 0 0;
    line-height: 1.65;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .links .back {
    margin-left: auto;
  }
  .cite-row {
    margin-top: 0.75rem;
  }
  .related {
    margin-top: var(--space-6);
  }
  .related-title {
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }
  .related li:last-child {
    border-bottom: none;
  }
  .related-link {
    flex: 1;
    min-width: 0;
    font-weight: 550;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .related-link:hover {
    color: var(--accent);
  }
</style>
