---
import { Icon } from 'astro-icon/components';
import CiteActions from '../../components/CiteActions.svelte';
import PdfReader from '../../components/PdfReader.svelte';
import SaveButton from '../../components/SaveButton.svelte';
import Telemetry from '../../components/Telemetry.svelte';
import Base from '../../layouts/Base.astro';
import {
  fetchModels,
  fetchPaper,
  fetchPapers,
  fetchSaved,
  formatDate,
  type AiModel,
  type PaperSummary,
} from '../../lib/api';
import { renderMathHTML, stripMath } from '../../lib/math';
import { categoryName } from '../../lib/taxonomy';

// Rest param, not a plain [id]: canonical ids like doi:10.1145/nnn.mmm contain slashes.
const id = Astro.params.id ?? '';
const paper = await fetchPaper(id);
if (paper === null) {
  Astro.response.status = 404;
}

let saved = false;
if (paper !== null) {
  saved = ((await fetchSaved(Astro.locals.accessToken)) ?? []).some((p) => p.id === paper.id);
}

// Related papers ride the hybrid search with the title as the query — no new backend.
let related: PaperSummary[] = [];
// Models the catalogue says came out of this paper. Usually none: most papers are not a model
// release, and the section is simply absent when that is so.
let models: AiModel[] = [];
if (paper !== null) {
  const [hits, catalogue] = await Promise.all([
    fetchPapers({ q: paper.title }),
    fetchModels({ paperId: paper.id }),
  ]);
  related = (hits?.items ?? []).filter((hit) => hit.id !== paper.id).slice(0, 4);
  models = catalogue?.items ?? [];
}

const orderedCategories =
  paper === null
    ? []
    : [
        ...(paper.primary_category ? [paper.primary_category] : []),
        ...paper.categories.filter((cat) => cat !== paper.primary_category),
      ];

// BibTeX is rendered server-side so the citation stays readable without JavaScript.
function bibtexFor(p: PaperSummary): string {
  const key = p.id.replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  const lines = [
    `@article{${key},`,
    `  title = {${p.title}},`,
    `  author = {${p.authors.map((author) => author.name).join(' and ')}},`,
    `  year = {${p.published_at.slice(0, 4)}},`,
  ];
  if (p.id.startsWith('arxiv:')) lines.push(`  eprint = {${p.id.slice('arxiv:'.length)}},`);
  if (p.url) lines.push(`  url = {${p.url}},`);
  lines.push('}');
  return lines.join('\n');
}

const bibtex = paper === null ? '' : bibtexFor(paper);
---

<Base title={paper ? stripMath(paper.title) : 'Not found'}>
  {
    paper === null ? (
      <div class="card empty">
        <Icon name="lucide:file-question" aria-hidden="true" />
        <div>
          <h1 class="notfound-title">Paper not found</h1>
          <p class="notfound-body">
            Nothing stored under <code>{id}</code>. <a href="/">Back to the feed</a>.
          </p>
        </div>
      </div>
    ) : (
      <article>
        <div class="head">
          <h1 set:html={renderMathHTML(paper.title)} />
          <SaveButton client:load paperId={paper.id} {saved} />
        </div>
        <p class="meta">
          {formatDate(paper.published_at)}
          {paper.venue && ` · ${paper.venue}`}
          {paper.citation_count > 0 &&
            ` · ${paper.citation_count} citation${paper.citation_count === 1 ? '' : 's'}`}
          {' · '}
          <code>{paper.id}</code>
          {orderedCategories.map((cat, index) => (
            <span
              class={index === 0 && paper.primary_category ? 'badge badge-primary' : 'badge'}
              title={categoryName(cat)}
            >
              {cat}
            </span>
          ))}
        </p>
        <p class="authors">
          {paper.authors
            .map((author) =>
              author.affiliation ? `${author.name} (${author.affiliation})` : author.name,
            )
            .join(', ')}
        </p>
        {paper.comment && <p class="comment">{paper.comment}</p>}
        <p class="abstract" set:html={renderMathHTML(paper.abstract)} />
        {
          paper.keywords && paper.keywords.length > 0 && (
            <p class="tags">
              {paper.keywords.map((keyword) => (
                <a class="badge" href={`/?q=${encodeURIComponent(keyword)}`}>
                  {keyword}
                </a>
              ))}
            </p>
          )
        }
        <p class="links">
          {paper.pdf_url && (
            <button class="btn btn-primary" type="button" data-open-reader>
              <Icon name="lucide:book-open" aria-hidden="true" />
              Read
            </button>
          )}
          {paper.url && (
            <a class="btn btn-ghost" href={paper.url} rel="noopener">
              <Icon name="lucide:external-link" aria-hidden="true" />
              Landing page
            </a>
          )}
          {paper.pdf_url && (
            <a class="btn btn-ghost" href={paper.pdf_url} rel="noopener">
              <Icon name="lucide:file-text" aria-hidden="true" />
              PDF
            </a>
          )}
          <a class="btn btn-ghost back" href="/">
            <Icon name="lucide:chevron-left" aria-hidden="true" />
            Back to the feed
          </a>
        </p>
        <div class="cite-row">
          <CiteActions client:load bibtex={bibtex} url={Astro.url.href} />
        </div>
        {paper.pdf_url && (
          <PdfReader
            client:load
            pdfUrl={paper.pdf_url}
            title={stripMath(paper.title)}
            paperId={paper.id}
            initialOpen={Astro.url.searchParams.get('read') === '1'}
          />
        )}
        <Telemetry client:idle surface="detail" paperId={paper.id} enabled={Astro.locals.user !== null} />
        {models.length > 0 && (
          <section class="related">
            <h2 class="related-title">Models from this paper</h2>
            <ul class="models">
              {models.map((model) => (
                <li>
                  {model.link ? (
                    <a href={model.link} rel="noopener noreferrer nofollow" target="_blank">
                      {model.name}
                    </a>
                  ) : (
                    <span>{model.name}</span>
                  )}
                  {model.organization && <span class="model-org">{model.organization}</span>}
                  {model.hf_downloads !== null && (
                    <span class="badge" title="Hugging Face downloads">
                      {model.hf_downloads.toLocaleString('en-US')}
                    </span>
                  )}
                </li>
              ))}
            </ul>
            <a class="all-models" href="/models">Every model in the catalogue</a>
          </section>
        )}
        {related.length > 0 && (
          <section class="related">
            <h2 class="related-title">Related papers</h2>
            <ul>
              {related.map((hit) => (
                <li>
                  <a
                    class="related-link"
                    href={`/papers/${hit.id}`}
                    set:html={renderMathHTML(hit.title)}
                  />
                  {hit.score !== null && (
                    <span class="badge badge-score">{hit.score.toFixed(3)}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>
    )
  }
</Base>

<style>
  .notfound-title {
    font-size: var(--text-lg);
    margin: 0 0 0.25rem;
  }
  .notfound-body {
    margin: 0;
  }
  .head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  h1 {
    flex: 1;
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.6rem 0 0;
  }
  .meta code {
    font-size: 0.8rem;
    background: var(--surface-2);
    border-radius: 6px;
    padding: 0.05rem 0.4rem;
    overflow-wrap: anywhere;
  }
  .meta .badge {
    margin-left: 0.5rem;
    vertical-align: 0.1em;
  }
  .badge-primary {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .comment {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    font-style: italic;
  }
  .authors {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0.6rem 0 0;
  }
  .abstract {
    white-space: pre-line;
    margin: 1.1rem 0 0;
    line-height: 1.65;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.9rem 0 0;
  }
  .tags a {
    text-decoration: none;
  }
  .tags a:hover {
    background: var(--surface-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .links .back {
    margin-left: auto;
  }
  .cite-row {
    margin-top: 0.75rem;
  }
  .related {
    margin-top: var(--space-6);
  }
  .related-title {
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }
  .related li:last-child {
    border-bottom: none;
  }
  .related-link {
    flex: 1;
    min-width: 0;
    font-weight: 550;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .related-link:hover {
    color: var(--accent);
  }
  /* A model row is a name, who built it, and how used it is - the three things that say
     whether it is worth following. The first takes the space the other two do not need. */
  .models li a,
  .models li > span:first-child {
    flex: 1;
    min-width: 0;
    font-weight: 550;
    font-size: 0.95rem;
  }
  .model-org {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .all-models {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: var(--text-sm);
  }
</style>
