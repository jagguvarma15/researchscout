---
// The topic page: members carry their field and publish date (joined on the detail read) and
// render as a ranked list in the digest register. Each history build links into the feed for
// its window through the shared chart.
import { Icon } from 'astro-icon/components';
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import SignalMark from '../../components/SignalMark.astro';
import TrendBadge from '../../components/TrendBadge.astro';
import TrendChart from '../../components/TrendChart.astro';
import Base from '../../layouts/Base.astro';
import { catalogMessage, fetchTopic, formatDate } from '../../lib/api';
import { renderMathHTML } from '../../lib/math';
import { windowHref } from '../../lib/frontier';

const rawId = Astro.params.id ?? '';
const topicId = /^\d+$/.test(rawId) ? Number(rawId) : null;
const result = topicId === null ? null : await fetchTopic(topicId);
const topic = result?.ok ? result.data : null;
// A missing id and a genuine 404 are "not found" (a real 404 status); any other failure is the
// API being unreachable, which renders an error with a retry rather than claiming the topic
// does not exist - the two were indistinguishable before.
const failure = result && !result.ok && result.failure.status !== 404 ? result.failure : null;
const notFound = topic === null && failure === null;
if (notFound) {
  Astro.response.status = 404;
}

const values = topic ? topic.history.map((point) => point.size) : [];
const firstBuilt = topic?.history[0]?.built_at ?? null;
const lastBuilt = topic?.history[topic.history.length - 1]?.built_at ?? null;
const memberMax = topic ? Math.max(...topic.papers.map((paper) => paper.score), 0) : 0;

// Each build carries the link into the feed for its window, plus a tooltip and its own label;
// the shared chart places the dots from the same geometry it draws the line with.
const buildPoints = topic
  ? topic.history.map((point) => ({
      href: windowHref(point.built_at),
      title: `${point.size} papers - ${formatDate(point.built_at)}`,
      ariaLabel: `${point.size} papers at the ${formatDate(point.built_at)} build - open the feed for that window`,
    }))
  : [];
---

<Base title={topic?.label ?? (failure ? 'Topic unavailable' : 'Not found')}>
  {
    failure ? (
      <Fragment>
        <PageIntro title="Topic unavailable" />
        <EmptyState
          kind="error"
          icon="lucide:cloud-off"
          message={catalogMessage(failure, 'this topic')}
          action={{ href: `/topics/${rawId}`, label: 'Retry' }}
        />
      </Fragment>
    ) : topic === null ? (
      <Fragment>
        <PageIntro title="Topic not found" />
        <EmptyState
          icon="lucide:file-question"
          message={`No topic stored under ${rawId}.`}
          action={{ href: '/topics', label: 'Back to the trends' }}
        />
      </Fragment>
    ) : (
      <article>
        <h1 class="t-label">{topic.label}</h1>
        <p class="t-badges">
          <TrendBadge trend={topic.trend} />
          <span class="badge" title="Breakthrough momentum, summed over members">
            {topic.score.toFixed(1)}
          </span>
          <span class="badge">
            {topic.size} paper{topic.size === 1 ? '' : 's'}
          </span>
        </p>
        {topic.history.length >= 2 && (
          <figure class="history">
            <TrendChart
              mode="line"
              values={values}
              width={640}
              height={120}
              pad={8}
              baseline
              pointStyle="quiet"
              dotRadius={5}
              points={buildPoints}
              label={`Cluster size across ${topic.history.length} builds - each point opens the feed for its window`}
              titleText={`${values.join(', ')} papers across the last ${topic.history.length} builds`}
            />
            {firstBuilt && lastBuilt && (
              <figcaption class="chart-caption">
                <span>{formatDate(firstBuilt)}</span>
                <span>{formatDate(lastBuilt)}</span>
              </figcaption>
            )}
          </figure>
        )}
        {topic.summary && <p class="t-summary">{topic.summary}</p>}
        <h2 class="members-title">Members, momentum first</h2>
        <ol class="members">
          {topic.papers.map((paper) => (
            <li>
              <a href={`/papers/${paper.paper_id}`} set:html={renderMathHTML(paper.title)} />
              {(paper.primary_category || paper.published_at) && (
                <span class="member-meta">
                  {paper.primary_category && <span class="badge">{paper.primary_category}</span>}
                  {paper.published_at && <span class="badge">{formatDate(paper.published_at)}</span>}
                </span>
              )}
              <SignalMark
                score={paper.score}
                max={memberMax}
                label="momentum, relative within this topic"
              />
            </li>
          ))}
        </ol>
        <p class="back">
          <a class="btn btn-ghost" href="/topics">
            <Icon name="lucide:chevron-left" aria-hidden="true" />
            Back to the trends
          </a>
        </p>
      </article>
    )
  }
</Base>

<style>
  .t-label {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: var(--track-tight);
    line-height: var(--leading-tight);
  }
  .t-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
  }
  .history {
    margin: var(--space-5) 0 0;
    max-width: 40rem;
  }
  .chart-caption {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: var(--text-xs);
    margin-top: 0.3rem;
  }
  .t-summary {
    margin: var(--space-4) 0 0;
    max-width: 60ch;
  }
  .members-title {
    margin: var(--space-6) 0 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-caps-wide);
    text-transform: uppercase;
  }
  .members {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .members li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }
  .members a {
    flex: 1;
    min-width: 12rem;
    font-weight: var(--weight-medium);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }
  .members a:hover {
    color: var(--accent);
  }
  /* A member's field and publish date, joined on the detail read. */
  .member-meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .back {
    margin: var(--space-5) 0 0;
  }
  @media (max-width: 40rem) {
    /* Give the title the full row so the meta chips and the meter wrap comfortably below it. */
    .members a {
      min-width: 100%;
    }
  }
</style>
