---
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import Base from '../../layouts/Base.astro';
import { catalogMessage, fetchTopics } from '../../lib/api';
import { renderMathHTML } from '../../lib/math';

const result = await fetchTopics();
---

<Base title="Trends">
  <PageIntro
    title="Emerging topics"
    lede="Clusters of recent papers, ranked by how fast their signals are climbing."
  />

  {
    !result.ok ? (
      <EmptyState
        kind="error"
        icon="lucide:cloud-off"
        message={catalogMessage(result.failure, 'topics')}
        action={{ href: '/topics', label: 'Retry' }}
      />
    ) : result.data.length === 0 ? (
      <EmptyState
        icon="lucide:hourglass"
        message="No topics yet."
        hint="They appear after the next clustering sweep, or run: scout topics build"
      />
    ) : (
      <ul class="topics">
        {result.data.map((topic) => (
          <li class="card topic">
            <div class="topic-head">
              <h2 class="topic-label">{topic.label}</h2>
              {topic.trend && (
                <span
                  class={`badge trend-${topic.trend}`}
                  title="Size trend across builds"
                >
                  {topic.trend}
                </span>
              )}
              <span class="badge badge-score" title="Breakthrough momentum">
                {topic.score.toFixed(1)}
              </span>
            </div>
            {topic.summary && <p class="topic-summary">{topic.summary}</p>}
            <p class="topic-meta">
              {topic.size} paper{topic.size === 1 ? '' : 's'}
            </p>
            <ul class="papers">
              {topic.papers.map((paper) => (
                <li>
                  <a href={`/papers/${paper.paper_id}`} set:html={renderMathHTML(paper.title)} />
                  <span class="badge badge-score" title="Breakthrough momentum">
                    {paper.score.toFixed(1)}
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .topic {
    padding: 1.1rem 1.25rem;
  }
  .topic-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .topic-label {
    margin: 0;
    flex: 1;
    font-size: 1.1rem;
    line-height: 1.3;
  }
  /* Variants over the global .badge - the local re-declaration of the badge shape itself
     used to shadow the shared class. */
  .topic-head .badge {
    flex: none;
  }
  .trend-rising,
  .trend-new {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .trend-fading {
    opacity: 0.7;
  }
  .topic-summary {
    margin: 0.4rem 0 0;
    color: var(--ink);
  }
  .topic-meta {
    margin: 0.35rem 0 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .papers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .papers li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .papers a {
    color: var(--ink);
    text-decoration: none;
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .papers a:hover {
    color: var(--accent);
  }
</style>
