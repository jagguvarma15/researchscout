---
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import SignalMark from '../../components/SignalMark.astro';
import TrendBadge from '../../components/TrendBadge.astro';
import Base from '../../layouts/Base.astro';
import { catalogMessage, fetchTopics } from '../../lib/api';
import { renderMathHTML } from '../../lib/math';
import { sparklineGeometry } from '../../lib/sparkline';

const result = await fetchTopics();

// Server-rendered controls: the trend chips narrow, the sort pills reorder, and both live
// in the URL so a filtered view is shareable like every other list here.
const params = Astro.url.searchParams;
const TREND_KEYS = ['new', 'rising', 'steady', 'fading'] as const;
const trendParam = params.get('trend') ?? '';
const trendFilter = (TREND_KEYS as readonly string[]).includes(trendParam) ? trendParam : '';
const sortParam = params.get('sort') === 'size' ? 'size' : 'score';

function controlHref(trend: string, sort: string): string {
  const next = new URLSearchParams();
  if (trend) next.set('trend', trend);
  if (sort !== 'score') next.set('sort', sort);
  const query = next.toString();
  return query ? `/topics?${query}` : '/topics';
}

let topics = result.ok
  ? result.data.map((topic) => ({
      ...topic,
      spark: sparklineGeometry(topic.history.map((point) => point.size)),
      memberMax: Math.max(...topic.papers.map((paper) => paper.score), 0),
    }))
  : [];
const totalTopics = topics.length;
if (trendFilter) topics = topics.filter((topic) => topic.trend === trendFilter);
if (sortParam === 'size') topics = [...topics].sort((a, b) => b.size - a.size);
---

<Base title="Trends">
  <PageIntro
    title="Emerging topics"
    lede="Clusters of recent papers, ranked by how fast their signals are climbing."
  />

  {
    result.ok && totalTopics > 0 && (
      <div class="controls">
        <span class="controls-group" role="group" aria-label="Filter by trend">
          <a class:list={['pill', { on: !trendFilter }]} href={controlHref('', sortParam)} aria-current={!trendFilter ? 'page' : undefined}>
            All
          </a>
          {TREND_KEYS.map((key) => (
            <a
              class:list={['pill', { on: trendFilter === key }]}
              href={controlHref(key, sortParam)}
              aria-current={trendFilter === key ? 'page' : undefined}
            >
              {key[0].toUpperCase() + key.slice(1)}
            </a>
          ))}
        </span>
        <span class="controls-group" role="group" aria-label="Order topics">
          <a class:list={['pill', { on: sortParam === 'score' }]} href={controlHref(trendFilter, 'score')} aria-current={sortParam === 'score' ? 'page' : undefined}>
            By momentum
          </a>
          <a class:list={['pill', { on: sortParam === 'size' }]} href={controlHref(trendFilter, 'size')} aria-current={sortParam === 'size' ? 'page' : undefined}>
            By size
          </a>
        </span>
      </div>
    )
  }

  {
    !result.ok ? (
      <EmptyState
        kind="error"
        icon="lucide:cloud-off"
        message={catalogMessage(result.failure, 'topics')}
        action={{ href: '/topics', label: 'Retry' }}
      />
    ) : topics.length === 0 ? (
      <EmptyState
        icon="lucide:hourglass"
        message={trendFilter ? `No ${trendFilter} topics right now.` : 'No topics yet.'}
        hint={
          trendFilter
            ? 'Trends shift with each nightly clustering sweep.'
            : 'They appear after the next clustering sweep, or run: scout topics build'
        }
        action={trendFilter ? { href: '/topics', label: 'Every topic' } : undefined}
      />
    ) : (
      <ul class="topics">
        {topics.map((topic) => (
          <li class="card topic">
            <div class="topic-head">
              <h2 class="topic-label">
                <a href={`/topics/${topic.id}`}>{topic.label}</a>
              </h2>
              {topic.spark && (
                <svg
                  class="spark"
                  width="100"
                  height="28"
                  viewBox="0 0 100 28"
                  role="img"
                  aria-label={`Cluster size across ${topic.history.length} builds`}
                >
                  <title>
                    {topic.history.map((point) => point.size).join(', ')} papers across the
                    last {topic.history.length} builds
                  </title>
                  <path d={topic.spark.area} />
                  <polyline points={topic.spark.line} />
                  <circle cx={topic.spark.end.x} cy={topic.spark.end.y} r="4" />
                </svg>
              )}
            </div>
            <p class="topic-badges">
              <TrendBadge trend={topic.trend} />
              <span class="badge" title="Breakthrough momentum, summed over members">
                {topic.score.toFixed(1)}
              </span>
              <span class="badge">
                {topic.size} paper{topic.size === 1 ? '' : 's'}
              </span>
            </p>
            {topic.summary && <p class="topic-summary">{topic.summary}</p>}
            <ul class="papers">
              {topic.papers.map((paper) => (
                <li>
                  <a href={`/papers/${paper.paper_id}`} set:html={renderMathHTML(paper.title)} />
                  <SignalMark
                    score={paper.score}
                    max={topic.memberMax}
                    label="momentum, relative within this topic"
                  />
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  /* The filter and order pills, in the shared pill register with an accent-on active. */
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.2rem;
    margin-bottom: var(--space-4);
  }
  .controls-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .controls .pill {
    text-decoration: none;
    color: var(--muted);
  }
  .controls .pill:hover {
    color: var(--ink);
  }
  .controls .pill.on {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(24rem, 1fr));
  }
  @media (max-width: 40rem) {
    .topics {
      grid-template-columns: 1fr;
    }
  }
  .topic {
    padding: 1.1rem 1.25rem;
    /* Grid items default to min-width auto, so one nowrap member title would push the
       whole card past its column. */
    min-width: 0;
  }
  .topic-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .topic-label {
    margin: 0;
    flex: 1;
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-tight);
    line-height: var(--leading-snug);
  }
  .topic-label a {
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .topic-label a:hover {
    color: var(--accent);
  }
  /* The size history behind the trend word: line, wash, and the latest build's dot. */
  .spark {
    flex: none;
  }
  .spark polyline {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .spark path {
    fill: var(--accent);
    opacity: 0.08;
  }
  .spark circle {
    fill: var(--accent);
    stroke: var(--surface-2);
    stroke-width: 2;
  }
  .topic-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0.4rem 0 0;
  }
  .topic-summary {
    margin: 0.5rem 0 0.6rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .papers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .papers li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    /* Grid items again: the nowrap title feeds the row's min-content even though the
       anchor itself clips, so the row must be allowed to shrink to its track. */
    min-width: 0;
  }
  .papers a {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink);
    font-size: var(--text-sm);
    text-decoration: none;
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .papers a:hover {
    color: var(--accent);
  }
</style>
