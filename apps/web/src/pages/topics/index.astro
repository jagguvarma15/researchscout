---
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import SignalMark from '../../components/SignalMark.astro';
import TrendBadge from '../../components/TrendBadge.astro';
import Base from '../../layouts/Base.astro';
import { catalogMessage, fetchTopics } from '../../lib/api';
import { renderMathHTML } from '../../lib/math';
import { sparklineGeometry } from '../../lib/sparkline';

const result = await fetchTopics();

const topics = result.ok
  ? result.data.map((topic) => ({
      ...topic,
      spark: sparklineGeometry(topic.history.map((point) => point.size)),
      memberMax: Math.max(...topic.papers.map((paper) => paper.score), 0),
    }))
  : [];
---

<Base title="Trends">
  <PageIntro
    title="Emerging topics"
    lede="Clusters of recent papers, ranked by how fast their signals are climbing."
  />

  {
    !result.ok ? (
      <EmptyState
        kind="error"
        icon="lucide:cloud-off"
        message={catalogMessage(result.failure, 'topics')}
        action={{ href: '/topics', label: 'Retry' }}
      />
    ) : topics.length === 0 ? (
      <EmptyState
        icon="lucide:hourglass"
        message="No topics yet."
        hint="They appear after the next clustering sweep, or run: scout topics build"
      />
    ) : (
      <ul class="topics">
        {topics.map((topic) => (
          <li class="card topic">
            <div class="topic-head">
              <h2 class="topic-label">
                <a href={`/topics/${topic.id}`}>{topic.label}</a>
              </h2>
              {topic.spark && (
                <svg
                  class="spark"
                  width="100"
                  height="28"
                  viewBox="0 0 100 28"
                  role="img"
                  aria-label={`Cluster size across ${topic.history.length} builds`}
                >
                  <title>
                    {topic.history.map((point) => point.size).join(', ')} papers across the
                    last {topic.history.length} builds
                  </title>
                  <path d={topic.spark.area} />
                  <polyline points={topic.spark.line} />
                  <circle cx={topic.spark.end.x} cy={topic.spark.end.y} r="4" />
                </svg>
              )}
            </div>
            <p class="topic-badges">
              <TrendBadge trend={topic.trend} />
              <span class="badge" title="Breakthrough momentum, summed over members">
                {topic.score.toFixed(1)}
              </span>
              <span class="badge">
                {topic.size} paper{topic.size === 1 ? '' : 's'}
              </span>
            </p>
            {topic.summary && <p class="topic-summary">{topic.summary}</p>}
            <ul class="papers">
              {topic.papers.map((paper) => (
                <li>
                  <a href={`/papers/${paper.paper_id}`} set:html={renderMathHTML(paper.title)} />
                  <SignalMark
                    score={paper.score}
                    max={topic.memberMax}
                    label="momentum, relative within this topic"
                  />
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(24rem, 1fr));
  }
  @media (max-width: 40rem) {
    .topics {
      grid-template-columns: 1fr;
    }
  }
  .topic {
    padding: 1.1rem 1.25rem;
  }
  .topic-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .topic-label {
    margin: 0;
    flex: 1;
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-tight);
    line-height: var(--leading-snug);
  }
  .topic-label a {
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .topic-label a:hover {
    color: var(--accent);
  }
  /* The size history behind the trend word: line, wash, and the latest build's dot. */
  .spark {
    flex: none;
  }
  .spark polyline {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .spark path {
    fill: var(--accent);
    opacity: 0.08;
  }
  .spark circle {
    fill: var(--accent);
    stroke: var(--surface-2);
    stroke-width: 2;
  }
  .topic-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0.4rem 0 0;
  }
  .topic-summary {
    margin: 0.5rem 0 0.6rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .papers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .papers li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .papers a {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink);
    font-size: var(--text-sm);
    text-decoration: none;
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .papers a:hover {
    color: var(--accent);
  }
</style>
