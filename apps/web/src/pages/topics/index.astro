---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import { fetchTopics } from '../../lib/api';
import { renderMathHTML } from '../../lib/math';

const topics = await fetchTopics();
---

<Base title="Trends">
  <h1 class="page-title">Emerging topics</h1>
  <p class="lede">Clusters of recent papers, ranked by how fast their signals are climbing.</p>

  {
    topics === null && (
      <div class="card empty is-error">
        <Icon name="lucide:cloud-off" aria-hidden="true" />
        <p>The API is unreachable — try again in a moment.</p>
      </div>
    )
  }
  {
    topics !== null && topics.length === 0 && (
      <div class="card empty">
        <Icon name="lucide:hourglass" aria-hidden="true" />
        <p>
          No topics yet — they appear after the next clustering sweep, or run{' '}
          <code>scout topics build</code>.
        </p>
      </div>
    )
  }

  {
    topics !== null && topics.length > 0 && (
      <ul class="topics">
        {topics.map((topic) => (
          <li class="card topic">
            <div class="topic-head">
              <h2 class="topic-label">{topic.label}</h2>
              {topic.trend && (
                <span class={`badge trend trend-${topic.trend}`} title="Size trend across builds">
                  {topic.trend}
                </span>
              )}
              <span class="badge" title="Breakthrough momentum">
                {topic.score.toFixed(1)}
              </span>
            </div>
            {topic.summary && <p class="topic-summary">{topic.summary}</p>}
            <p class="topic-meta">
              {topic.size} paper{topic.size === 1 ? '' : 's'}
            </p>
            <ul class="papers">
              {topic.papers.map((paper) => (
                <li>
                  <a href={`/papers/${paper.paper_id}`} set:html={renderMathHTML(paper.title)} />
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .topic {
    padding: 1.1rem 1.25rem;
  }
  .topic-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .topic-label {
    margin: 0;
    flex: 1;
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .badge {
    flex: none;
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .trend-rising,
  .trend-new {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .trend-fading {
    opacity: 0.7;
  }
  .topic-summary {
    margin: 0.4rem 0 0;
    color: var(--ink);
  }
  .topic-meta {
    margin: 0.35rem 0 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .papers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .papers a {
    color: var(--ink);
    text-decoration: none;
    line-height: 1.4;
  }
  .papers a:hover {
    color: var(--accent);
  }
</style>
