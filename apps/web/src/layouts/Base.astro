---
import '@fontsource-variable/inter/index.css';
import '../styles/global.css';

import { Icon } from 'astro-icon/components';
import AvatarMenu from '../components/AvatarMenu.svelte';
import ChatDrawer from '../components/ChatDrawer.svelte';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — ResearchScout` : 'ResearchScout';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner container">
        <a class="brand" href="/">
          <span class="brand-mark">
            <Icon name="lucide:radar" aria-hidden="true" />
          </span>
          <span class="brand-word">ResearchScout</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a class="btn btn-ghost" href="/digests">Digests</a>
          {
            Astro.locals.user ? (
              <>
                <a class="btn btn-ghost" href="/saved">
                  <Icon name="lucide:bookmark" aria-hidden="true" />
                  Saved
                </a>
                <AvatarMenu client:load username={Astro.locals.user.username} />
              </>
            ) : (
              <a class="btn btn-primary" href="/auth/login">
                <Icon name="lucide:log-in" aria-hidden="true" />
                Sign in
              </a>
            )
          }
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        Papers from arXiv and friends, scored by freshness and signals.
      </div>
    </footer>
    <ChatDrawer client:load authenticated={Astro.locals.user !== null} />
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #fff;
  }
  .brand-mark svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .site-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-nav .btn {
    padding: 0.35rem 0.85rem;
  }
  main {
    padding-top: var(--space-6);
    padding-bottom: 4rem;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer .container {
    padding-top: 1.1rem;
    padding-bottom: 2rem;
  }
  @media (max-width: 26rem) {
    .site-header-inner {
      gap: 0.5rem;
    }
    .site-nav {
      gap: 0.35rem;
    }
    .site-nav .btn {
      padding: 0.35rem 0.6rem;
    }
    .brand-word {
      display: none;
    }
  }
</style>
