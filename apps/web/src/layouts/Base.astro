---
import '@fontsource-variable/inter/index.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

import { Icon } from 'astro-icon/components';
import AvatarMenu from '../components/AvatarMenu.svelte';
import ChatDrawer from '../components/ChatDrawer.svelte';
import CommandPalette from '../components/CommandPalette.svelte';
import StaleBanner from '../components/StaleBanner.svelte';
import TermsGate from '../components/TermsGate.svelte';
import ThemeToggle from '../components/ThemeToggle.svelte';
import { fetchAccount } from '../lib/api';
import { THEME_SCRIPT } from '../lib/theme-script.js';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — ResearchScout` : 'ResearchScout';

const user = Astro.locals.user;
// Only signed-in people can owe an acceptance, and asking the API here (rather than from the
// browser) means the dialog is either in the first paint or absent - never a flash.
const account = user ? await fetchAccount(Astro.locals.accessToken) : null;
const termsOutstanding = account !== null && !account.terms_accepted;
// When this page was built. A public page can be served from the edge cache long after, and
// the banner below is how the reader finds out.
const renderedAt = new Date().toISOString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Both files carry the brand mark below (.brand-mark); the ico covers browsers
         that will not take an SVG icon. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="16x16 32x32 64x64" />
    <title>{pageTitle}</title>
    <script is:inline set:html={THEME_SCRIPT} />
  </head>
  <body>
    <StaleBanner client:idle renderedAt={renderedAt} />
    <header class="site-header">
      <div class="site-header-inner container">
        <a class="brand" href="/">
          <span class="brand-mark">
            <Icon name="lucide:radar" aria-hidden="true" />
          </span>
          <span class="brand-word">ResearchScout</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <button
            class="search-trigger"
            type="button"
            data-open-palette
            aria-label="Search papers (Cmd+K)"
            title="Search papers (Cmd+K)"
          >
            <Icon name="lucide:search" aria-hidden="true" />
            <span class="search-trigger-label">Search papers…</span>
            <kbd class="search-trigger-kbd" aria-hidden="true">⌘K</kbd>
          </button>
          <ThemeToggle client:load />
          <a class="btn btn-ghost" href="/for-you">For you</a>
          <a class="btn btn-ghost" href="/topics">Trends</a>
          <a class="btn btn-ghost" href="/digests">Digests</a>
          <a class="btn btn-ghost" href="/saved">
            <Icon name="lucide:bookmark" aria-hidden="true" />
            Reading list
          </a>
          <a class="btn btn-ghost" href="/about">About</a>
          {
            user ? (
              <AvatarMenu client:load username={user.username} />
            ) : (
              <a class="btn btn-primary" href="/login">Sign in</a>
            )
          }
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-text">
          <p>Papers from arXiv and friends, scored by freshness and signals.</p>
          <p class="footer-legal">
            Copyright (c) 2026 Jagadesh Varma. MIT licensed. Metadata from arXiv under CC0; data
            from Semantic Scholar.
          </p>
        </div>
        <p class="footer-links">
          <a href="/about">About</a>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
        </p>
      </div>
    </footer>
    <ChatDrawer client:load />
    <CommandPalette client:load />
    {termsOutstanding && account && <TermsGate client:load version={account.terms_required} />}
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg-translucent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: var(--radius-sm);
    /* One of the two restrained gradient touches (with the chat FAB). */
    background: var(--accent-grad, var(--accent));
    color: var(--accent-contrast);
  }
  .brand-mark svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .site-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-nav .btn {
    padding: 0.35rem 0.85rem;
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 13rem;
    padding: 0.4rem 0.55rem 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: var(--text-sm);
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .search-trigger:hover {
    background: var(--surface-2);
    border-color: var(--line-strong);
  }
  .search-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .search-trigger-label {
    flex: 1;
  }
  .search-trigger-kbd {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--muted);
    font-family: inherit;
    font-size: 0.7rem;
  }
  @media (max-width: 52rem) {
    .search-trigger {
      min-width: 0;
      padding: 0.45rem;
    }
    .search-trigger-label,
    .search-trigger-kbd {
      display: none;
    }
  }
  main {
    padding-top: var(--space-6);
    padding-bottom: 4rem;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer .container {
    padding-top: 1.1rem;
    padding-bottom: 2rem;
  }
  /* Text on the left, links on the right, stacking on narrow screens. */
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
  }
  .footer-inner p {
    margin: 0;
  }
  /* Scoped past `.footer-inner p` above, which would otherwise win on specificity. */
  .footer-inner .footer-legal {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .footer-inner .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    /* Clear of the chat button, which is fixed in the bottom right corner and would otherwise
       sit on top of the last link. */
    margin-left: auto;
    margin-right: 4.5rem;
    text-align: right;
  }
  .footer-legal a {
    white-space: nowrap;
  }
  @media (max-width: 48rem) {
    .site-header-inner {
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    /* Without this the nav runs off the right edge and takes the whole page with it:
       wrapping the header row alone does not wrap the row of links inside it. */
    .site-nav {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.35rem;
    }
  }
  @media (max-width: 30rem) {
    .site-nav .btn {
      padding: 0.35rem 0.6rem;
    }
    .brand-word {
      display: none;
    }
  }
</style>
