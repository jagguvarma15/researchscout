---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/newsreader/opsz.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';
import AvatarMenu from '../components/AvatarMenu.svelte';
import FooterStatus from '../components/FooterStatus.svelte';
import Omnibox from '../components/Omnibox.svelte';
import SettingsDrawer from '../components/SettingsDrawer.svelte';
import ShortcutsHelp from '../components/ShortcutsHelp.svelte';
import SideRail from '../components/SideRail.svelte';
import StaleBanner from '../components/StaleBanner.svelte';
import TermsGate from '../components/TermsGate.svelte';
import ThemeToggle from '../components/ThemeToggle.svelte';
import { fetchAccount, type Account } from '../lib/api';
import { ownerTag } from '../lib/owner';
import { THEME_SCRIPT } from '../lib/theme-script.js';

// CSS anchors. Astro's client build deletes the styles of Svelte components that never
// render during SSR - the chat thread is `{#if open}` behind the omnibox, so ScoutPanel,
// ChatMessage, and WebHitCard shipped to production with no styles at all
// (withastro/astro#9093; the fix in #16823 has not reached the 7.x line as of 7.2.0, and a
// bare import is not enough - the pruning keys on rendered-ness). The invisible server-only
// render at the end of body keeps their CSS in the build; it hydrates nothing and costs a
// few hundred hidden bytes. scripts/verify-styles.mjs fails the build if any of these ever
// goes missing again; drop all of this when the upstream fix ships.
import AvatarArt from '../components/AvatarArt.svelte';
import ChatMessage from '../components/ChatMessage.svelte';
import ScoutPanel from '../components/ScoutPanel.svelte';
import WebHitCard from '../components/WebHitCard.svelte';
import type { Message, WebHit } from '../lib/chat-types';

const anchorMessage: Message = { role: 'user', text: 'anchor', phase: 'done' };
const anchorHit: WebHit = {
  provider: 'arxiv',
  title: 'anchor',
  authors: [],
  year: null,
  snippet: '',
  arxiv_id: null,
  url: null,
  already_known: false,
  paper_id: null,
};
const noop = () => {};

interface Props {
  title?: string;
  /* A page that already fetched the account for its own content (the profile) passes it
     down so the shell does not ask the API a second time. undefined means "not fetched",
     so a page can also hand over an explicit null. */
  account?: Account | null;
}

const { title, account: accountFromPage } = Astro.props;
const pageTitle = title ? `${title} — ResearchScout` : 'ResearchScout';

const user = Astro.locals.user;
// Only signed-in people can owe an acceptance, and asking the API here (rather than from the
// browser) means the dialog is either in the first paint or absent - never a flash.
const account =
  accountFromPage !== undefined
    ? accountFromPage
    : user
      ? await fetchAccount(Astro.locals.accessToken)
      : null;
const termsOutstanding = account !== null && !account.terms_accepted;
// Stamped on <html> so client-side storage (the Scout transcript) can scope itself to the
// signed-in account without ever seeing the sub; signed-out renders carry no tag.
const owner = ownerTag(user?.sub);
// When this page was built. A public page can be served from the edge cache long after, and
// the banner below is how the reader finds out.
const renderedAt = new Date().toISOString();
---

<!doctype html>
<html lang="en" data-owner={owner || undefined}>
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover hands over the safe-area insets on notched phones; the overlays
        that pad with env(safe-area-inset-*) are inert without it. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191713" media="(prefers-color-scheme: dark)" />
    <!-- Both files carry the brand mark below (.brand-mark); the ico covers browsers
         that will not take an SVG icon, the PNGs cover install surfaces. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="16x16 32x32 64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{pageTitle}</title>
    <script is:inline set:html={THEME_SCRIPT} />
    {/* Navigation swaps the page rather than reloading the document, so the header, the rail
        and the theme stay put instead of flashing white between every click. The reader
        needs no opt-out: it tears itself down in onDestroy when a swap removes it. */}
    <ClientRouter />
    <script>
      // Bundled, not inline: neither needs a pre-paint guarantee, so both stay out of
      // the hashed inline script. Module scripts run once per full load; the document
      // listeners inside survive every swap.
      import { initNavDirection } from '../lib/nav-direction';
      import { initErrorReporting } from '../lib/sentry-client';

      initNavDirection();
      initErrorReporting();
    </script>
  </head>
  <body>
    {/* The first focusable element on every page: a keyboard visitor otherwise tabs
        through the header, the omnibox, the theme toggle, the account menu and the whole
        rail before reaching content. Hidden by transform rather than display so it never
        leaves the tab order. */}
    <a class="skip-link" href="#main">Skip to content</a>
    <StaleBanner client:idle renderedAt={renderedAt} />
    {/* Named and unanimated: the frame is identical on both sides of a navigation, and
        holding it still is what makes the content's cross-fade read as a page change
        rather than the whole window blinking. The rail and footer get the same. */}
    <header class="site-header" transition:name="site-header" transition:animate="none">
      <div class="site-header-inner container">
        {/* The label matters at phone widths, where the word is display:none and the icon
            is aria-hidden - without it this link has no name at all. */}
        <a class="brand" href="/" aria-label="ResearchScout">
          <span class="brand-mark">
            <Icon name="lucide:radar" aria-hidden="true" />
          </span>
          <span class="brand-word">ResearchScout</span>
        </a>
        {/* Persisted across navigations. Without it the island is torn down and rebuilt on
            every click, so a half-typed question or an answer still streaming would vanish
            the moment a result was opened. The rail deliberately is not persisted: it takes
            the current path as a prop, and a persisted one would keep marking the page you
            came from. */}
        <Omnibox client:load transition:persist />
        <nav class="site-nav" aria-label="Site">
          <ThemeToggle client:load />
          {
            user ? (
              <AvatarMenu
                client:load
                username={account?.display_name || user.username}
                avatar={account?.avatar ?? null}
              />
            ) : (
              <a class="btn btn-primary signin" href="/login">Sign in</a>
            )
          }
          <button class="rail-trigger btn btn-nav" type="button" data-open-rail aria-label="Menu">
            <Icon name="lucide:menu" aria-hidden="true" />
          </button>
        </nav>
      </div>
    </header>
    <!-- Before the content, not after the footer: it is fixed either way, but a screen
         reader and the tab key both follow the document, and navigation belongs up here. -->
    {/* The transition name makes this wrapper a stacking context, which TRAPS the fixed
        drawer's z-index inside it - at level 0, everything later in the DOM (main, the
        footer) painted OVER the open drawer, which is exactly the "half displayed, half
        mixed with the page" drawer bug. The wrapper itself must carry the drawer's level. */}
    <div class="rail-anchor" transition:name="side-rail" transition:animate="none">
      <SideRail client:load current={Astro.url.pathname} showSignIn={!user} />
    </div>
    {/* tabindex lets the skip link land real focus here, not just the sequential
        starting point; main draws no ring (the global :focus-visible rule targets
        controls, not landmarks). */}
    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" transition:name="site-footer" transition:animate="none">
      <div class="container footer-inner">
        <div class="footer-text">
          <p>Papers from arXiv and friends, scored by freshness and signals.</p>
          <p class="footer-legal">
            Copyright (c) 2026 Jagadesh Varma. MIT licensed. Metadata from arXiv under CC0; data
            from Semantic Scholar.
          </p>
          <FooterStatus client:idle />
        </div>
        <p class="footer-links">
          <a href="/about">About</a>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
        </p>
      </div>
    </footer>
    {termsOutstanding && account && <TermsGate client:load version={account.terms_required} />}
    {/* Direct children of body, outside every transition:name wrapper - a name creates a
        stacking context that would trap these fixed overlays under later siblings. */}
    <SettingsDrawer client:load />
    <ShortcutsHelp client:load />
    {/* The CSS anchors from the frontmatter: server-rendered, hidden, never hydrated.
        AvatarArt joins them because it renders inside AvatarMenu only for signed-in
        accounts that picked one - exactly the sometimes-never-SSR'd shape the pruning
        bug eats, and its styles must live in this shared chunk for every page's header.
        The other five verify-styles sentinels (Omnibox, SideRail, SettingsDrawer,
        ShortcutsHelp here; AvatarPicker on the profile page) need no anchor: each is
        unconditionally invoked on every render of its page, which is the same guarantee.
        Anchoring an always-rendered island would only double its markup and its ARIA
        ids. If one of them ever moves behind a condition, add it here that day. */}
    <div hidden aria-hidden="true">
      <ScoutPanel onactivity={noop} />
      <ChatMessage
        message={anchorMessage}
        busy={false}
        last={false}
        onsummarize={noop}
        onwebsearch={noop}
        onimport={noop}
      />
      <WebHitCard hit={anchorHit} onimport={noop} />
      <AvatarArt slug="captain" />
    </div>
  </body>
</html>

<style>
  /* Parked above the viewport until focused; fixed at the nav bar's level so nothing
     paints over it when it appears. */
  .skip-link {
    position: fixed;
    top: calc(env(safe-area-inset-top) + 0.5rem);
    left: 0.5rem;
    z-index: var(--z-nav);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 550;
    text-decoration: none;
    box-shadow: var(--shadow-md);
    transform: translateY(calc(-100% - 2rem));
  }
  .skip-link:focus-visible {
    transform: none;
  }
  .site-header {
    position: sticky;
    top: 0;
    /* Above the rail's anchor (10 on wide screens), so the avatar menu - trapped in this
       stacking context (backdrop-filter creates it; the omnibox panel cannot escape it
       either) - paints over the rail band it opens into. */
    z-index: var(--z-header);
    background: var(--bg-translucent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    /* Live only where the page extends under system UI (installed mode, notches); zero in
       a normal browser. --nav-height carries the same inset so dependents stay in step. */
    padding-top: env(safe-area-inset-top);
  }
  /* Three columns rather than a row: the two outer ones are equal, so the field lands in the
     middle of the window instead of wherever the brand happens to end. The outer columns
     never shrink below their contents, so the field gives way first on a narrow window.
     Height is pinned rather than left to the content, because --nav-height is where the rail
     starts and a token that only approximates the header is a token that will drift. */
  .site-header-inner {
    display: grid;
    grid-template-columns: 1fr minmax(0, 44rem) 1fr;
    align-items: center;
    gap: 0.75rem;
    /* The base height, not var(--nav-height): the token already includes the safe-area
       inset that the header carries as padding-top, so using it here would count the inset
       twice. inset + this + the 1px border is exactly --nav-height. */
    min-height: calc(3.75rem - 1px);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: var(--radius-sm);
    /* One of the two restrained gradient touches (with the chat FAB). */
    background: var(--accent-grad, var(--accent));
    color: var(--accent-contrast);
  }
  .brand-mark svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  /* Hard against the right edge: About, the theme switch and the account are where you
     reach for them, not trailing the search field. */
  .site-nav {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .site-nav .btn {
    padding: 0.35rem 0.85rem;
  }
  /* The rail is a rail on wide screens and a menu below 64rem; this opens the second one.
     Scoped under .site-nav so the square padding outranks the .site-nav .btn pill padding
     above - unscoped, that rule won and shipped the hamburger as a wide pill crowding the
     Sign in button. */
  .site-nav .rail-trigger {
    display: none;
    padding: 0.4rem;
  }
  /* The transition name makes this wrapper a stacking context, so the wrapper itself must
     carry the rail's level - anything inside is trapped. Two tiers: on wide screens it
     sits between the page (auto) and the header (20), because the avatar menu lives in the
     header's context and must paint over the rail it opens onto. Below 64rem it takes the
     drawer's level (38, backdrop 37 inside) or the open drawer falls under later siblings -
     the original "half mixed with the page" bug. */
  .rail-anchor {
    position: relative;
    z-index: var(--z-rail-anchor);
  }
  @media (max-width: 64rem) {
    .rail-anchor {
      z-index: var(--z-drawer);
    }
  }
  main {
    padding-top: var(--space-6);
    padding-bottom: 4rem;
  }
  /* Content and footer both reserve the rail, which is fixed and overlays the right edge
     of the page from the header down. */
  main,
  .site-footer .container {
    padding-right: calc(var(--gutter) + var(--rail-width));
  }
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer .container {
    padding-top: 1.1rem;
    padding-bottom: 2rem;
  }
  /* Text on the left, links on the right, stacking on narrow screens. */
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
  }
  .footer-inner p {
    margin: 0;
  }
  /* Scoped past `.footer-inner p` above, which would otherwise win on specificity. */
  .footer-inner .footer-legal {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .footer-inner .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-left: auto;
    text-align: right;
  }
  /* Stacked under the text on a phone, the links read as part of the same column; keeping
     them pushed right made the stack look misaligned rather than deliberate. */
  @media (max-width: 40rem) {
    .footer-inner .footer-links {
      margin-left: 0;
      text-align: left;
    }
  }
  .footer-legal a {
    white-space: nowrap;
  }
  @media (max-width: 64rem) {
    /* Below here the rail is a menu rather than a column, so nothing is reserved for it. */
    main,
    .site-footer .container {
      padding-right: var(--gutter);
    }
    .site-nav .rail-trigger {
      display: inline-flex;
    }
    /* Signed-out account entry moves into the drawer whenever the hamburger is present:
       the two side by side crowded the header, and the search field paid for it. */
    .site-nav .signin {
      display: none;
    }
  }
  @media (max-width: 40rem) {
    .site-header-inner {
      gap: 0.5rem;
    }
    .site-nav .btn {
      padding: 0.35rem 0.6rem;
    }
    /* The hamburger keeps its square padding at every width. */
    .site-nav .rail-trigger {
      padding: 0.4rem;
    }
    .brand-word {
      display: none;
    }
  }
</style>
