---
interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — ResearchScout` : 'ResearchScout';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">ResearchScout</a>
      <span class="tagline">a radar for AI/ML research</span>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>Papers from arXiv and friends, scored by freshness and signals.</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1a1c1e;
    --muted: #6a7076;
    --accent: #0f62fe;
    --line: #e3e6e8;
    --bg: #ffffff;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0 auto;
    max-width: 46rem;
    padding: 0 1.25rem;
    color: var(--ink);
    background: var(--bg);
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      'Segoe UI',
      sans-serif;
    line-height: 1.55;
  }
  header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.5rem 0 1rem;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: none;
  }
  .tagline {
    color: var(--muted);
    font-size: 0.9rem;
  }
  main {
    padding: 1.5rem 0 3rem;
  }
  footer {
    border-top: 1px solid var(--line);
    padding: 1rem 0 2rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  a {
    color: var(--accent);
  }
</style>
