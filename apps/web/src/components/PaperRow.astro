---
// The one paper row, moved verbatim from the feed - the feed's markup is the definition,
// and every other list of papers renders this same component with page-specific trimmings:
// a save button when the page knows saved state, a dismiss affordance on the feed only,
// and anything extra (a reason chip, a rank) through the extra slot.
//
// Contracts that must survive any edit here:
// - data-paper-id and data-rank are what Telemetry.svelte reads for impressions and
//   dismissals.
// - The title's transition:name is what lets it morph into the paper page's heading; the
//   morph prop exists because a page that can show the same paper twice (the feed's
//   reading-list preview) must leave the second instance unnamed or the duplicate cancels
//   the morph.
// - The scroll reveal carries BOTH reduced-motion opt-outs: the media wrap for the OS
//   switch, and the explicit :global(html[data-motion='reduced']) rule for the site
//   switch - the universal .01ms guard cannot still a scroll-driven animation.
// - The .going rules are the dismiss collapse Telemetry sequences; the reveal goes off by
//   name while a row is leaving or its fill would beat the collapse transition.
import { Icon } from 'astro-icon/components';

import SaveButton from './SaveButton.svelte';
import { type PaperSummary } from '../lib/api';
import { renderMathHTML } from '../lib/math';
import { morphName } from '../lib/morph';
import { categoryName } from '../lib/taxonomy';

interface Props {
  paper: PaperSummary;
  /* When defined, the row renders a save button with this initial state. */
  saved?: boolean;
  /* Feed position for impression telemetry. */
  rank?: number;
  /* Title morph on navigation; off when the page may show this paper twice. */
  morph?: boolean;
  /* The feed's dismiss affordance (Telemetry wires [data-dismiss]). */
  dismissible?: boolean;
  /* compact renders the tighter row regardless of the reader's density preference -
     the reading list defaults to it because a queue wants more items per screen. */
  density?: 'full' | 'compact';
}

const {
  paper,
  saved,
  rank,
  morph = true,
  dismissible = false,
  density = 'full',
} = Astro.props;

// Venue when known, otherwise the arXiv comment ("14 pages, accepted at ...").
const note = paper.venue ?? paper.comment;

function truncate(text: string, max = 60): string {
  return text.length > max ? `${text.slice(0, max - 1)}…` : text;
}

const primary = paper.primary_category;
const restCats = paper.categories.filter((cat) => cat !== primary);
const badges = { primary, rest: restCats.slice(0, 3), more: Math.max(0, restCats.length - 3) };

// Human-readable keywords when enrichment has run; the category codes are the fallback,
// so the row carries one chip strip either way, never two.
const keywords = (paper.keywords ?? []).slice(0, 3);

const signal =
  paper.score !== null
    ? { pct: Math.round(Math.min(Math.max(paper.score, 0), 1) * 100), text: paper.score.toFixed(2) }
    : null;
---

<li
  class:list={['row', { compact: density === 'compact' }]}
  data-paper-id={paper.id}
  data-rank={rank}
>
  <div class="row-head">
    {
      morph ? (
        <a
          class="title"
          href={`/papers/${paper.id}`}
          transition:name={morphName('paper-title', paper.id)}
          set:html={renderMathHTML(paper.title)}
        />
      ) : (
        <a class="title" href={`/papers/${paper.id}`} set:html={renderMathHTML(paper.title)} />
      )
    }
    {saved !== undefined && <SaveButton client:visible paperId={paper.id} saved={saved} />}
  </div>
  <p class="meta">
    {
      paper.authors
        .slice(0, 3)
        .map((author) => author.name)
        .join(', ')
    }
    {paper.authors.length > 3 && ' et al.'}
    {
      note && (
        <span class="note" title={note}>
          {' · '}
          {truncate(note)}
        </span>
      )
    }
    {
      paper.citation_count > 0 && (
        <span class="cites">
          {' · '}
          {paper.citation_count} citation{paper.citation_count === 1 ? '' : 's'}
        </span>
      )
    }
  </p>
  <p class="tags">
    {
      signal && (
        <span
          class="sig"
          title={`Signal ${signal.text} — momentum from citations and discussion, 0 to 1`}
        >
          <span class="meter" aria-hidden="true"><i style={`width:${signal.pct}%`}></i></span>
          <span class="val">{signal.text}</span>
        </span>
      )
    }
    {
      badges.primary && (
        <span class="badge badge-primary" title={categoryName(badges.primary)}>
          {badges.primary}
        </span>
      )
    }
    {keywords.map((word) => <span class="kw">{word}</span>)}
    {
      keywords.length === 0 &&
        badges.rest.map((cat) => (
          <span class="badge" title={categoryName(cat)}>
            {cat}
          </span>
        ))
    }
    {keywords.length === 0 && badges.more > 0 && <span class="badge">+{badges.more}</span>}
    <slot name="extra" />
    {
      paper.pdf_url && (
        <a class="quick" href={`/papers/${paper.id}?read=1`}>
          <Icon name="lucide:book-open" aria-hidden="true" />
          Read
        </a>
      )
    }
    {
      dismissible && (
        <button class="dismiss" type="button" data-dismiss aria-label="Dismiss">
          Dismiss
        </button>
      )
    }
  </p>
  <p class="abstract" set:html={renderMathHTML(paper.abstract)} />
</li>

<style>
  /* Bled slightly into the gutter so the hover fill reads as the row, not as a box drawn
     inside it. The separator is a pseudo-element rather than a border because a border
     would follow the rounded corners of that fill. */
  .row {
    position: relative;
    padding: 0.85rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: var(--radius-sm);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .row:hover {
    background: var(--surface-2);
  }
  .row::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0;
    height: 1px;
    background: var(--line);
  }
  .row:last-child::after {
    display: none;
  }
  /* Rows rise into place as they scroll into view - scroll-driven, so the browser owns
     every frame and there is no script. Progressive: browsers without the timeline render
     the list static. Rows already past their range at load hold the settled values via
     the both fill. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .row {
        animation: row-reveal var(--ease-out) both;
        /* After the shorthand on purpose: the shorthand resets the timeline. */
        animation-timeline: view();
        animation-range: entry 0% entry 35%;
      }
      @keyframes row-reveal {
        from {
          opacity: 0.2;
          transform: translateY(8px);
        }
      }
    }
  }
  /* The reveal must never outrank the dismiss collapse: a timeline animation stays
     active, and animations beat transitions for opacity and transform - so it goes off by
     name when a row is leaving. */
  .row.going {
    animation: none;
  }
  /* The universal .01ms guard cannot still a scroll-driven animation - duration does not
     drive it - so the site switch turns it off explicitly; the media wrap above covers
     the OS switch. */
  :global(html[data-motion='reduced']) .row {
    animation: none;
  }
  /* Leaving slides and collapses, so the list closes over the gap instead of jumping.
     Telemetry fixes the row's height inline before this class lands - which is what lets
     height transition to zero - and detaches the node only once the collapse has run.
     Under reduced motion the removal is synchronous and none of this plays. */
  .row.going {
    opacity: 0;
    transform: translateX(1.5rem);
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      height var(--dur-slow) var(--ease-out),
      padding var(--dur-slow) var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .row.going {
      transition: none;
    }
  }
  .row-head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  /* The title wins the row by contrast: a step up and tighter, while everything under it
     drops to the caption size - hierarchy from difference, not from size alone. */
  .title {
    flex: 1;
    font-weight: var(--weight-semibold);
    font-size: 1.08rem;
    letter-spacing: var(--track-tight);
    line-height: var(--leading-snug);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .title:hover {
    color: var(--accent);
  }
  /* During a directional page slide the per-title morph names would pin every title in
     place while the root moves; lib/nav-direction holds the attribute across both
     snapshots so the titles ride the slide instead. */
  :global(html[data-paging]) .title {
    view-transition-name: none;
  }
  .meta {
    color: var(--muted);
    font-size: var(--text-xs);
    margin: 0.4rem 0 0;
  }
  .note,
  .cites {
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0.45rem 0 0;
  }
  .badge-primary {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  /* Extracted keywords read as subject matter, not classification codes: chip shape,
     ink text, no border. */
  .kw {
    display: inline-block;
    padding: 0.12rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--surface-2);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  /* The signal mark itself is the global .sig shape; only the compact rule below is
     this component's. */
  /* Pushed to the far end of the tag row, away from the category badges, with the two
     actions spaced enough not to read as one control. */
  .quick {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    padding-right: 0.4rem;
    color: var(--muted);
    font-size: 0.8rem;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .quick:hover {
    color: var(--accent);
  }
  .quick:active {
    transform: scale(0.96);
  }
  .quick :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }
  .dismiss {
    border: none;
    background: none;
    padding: 0;
    color: var(--muted);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .dismiss:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  /* Capped measure, per the layout rule that long-form text caps its own: at a wide window
     the column runs past 1100px, and a two-line abstract that wide is a scan, not a read. */
  .abstract {
    margin: 0.4rem 0 0;
    max-width: 105ch;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Compact rows: tighter spacing and a one-line abstract, so a screen holds more of the
     day. Two ways in, same look: the reader's site-wide preference (html[data-density],
     chosen in the settings drawer - :global because the attribute lives on <html>,
     outside this component's scope) and the page's own density prop (the reading list
     defaults to compact). */
  :global(html[data-density='compact']) .row,
  .row.compact {
    padding: 0.5rem 0.75rem;
  }
  :global(html[data-density='compact']) .title,
  .compact .title {
    font-size: 0.98rem;
  }
  :global(html[data-density='compact']) .meta,
  :global(html[data-density='compact']) .tags,
  :global(html[data-density='compact']) .abstract,
  .compact .meta,
  .compact .tags,
  .compact .abstract {
    margin-top: 0.25rem;
  }
  :global(html[data-density='compact']) .abstract,
  .compact .abstract {
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }
  /* Compact keeps the meter and drops its numeric twin - the shape carries the reading. */
  :global(html[data-density='compact']) .sig .val,
  .compact .sig .val {
    display: none;
  }
  @media (max-width: 40rem) {
    /* The quick link would otherwise be pushed onto a line of its own by the badges. */
    .quick {
      margin-left: 0;
    }
    /* Finger-sized targets without moving the type: padding grows the hit area and the
       negative margins hand the space back to the row. */
    .quick,
    .dismiss {
      padding: 0.55rem 0.45rem;
      margin-top: -0.55rem;
      margin-bottom: -0.55rem;
    }
    /* A smaller slide: the transform extends the root's scrollable overflow while it
       plays, and a phone has no slack to absorb it. */
    .row.going {
      transform: translateX(0.75rem);
    }
  }
</style>
