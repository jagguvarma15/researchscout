---
// The topic trend as glyph plus word - never color alone. New and rising read in the
// accent family; steady is a plain badge; fading dims and points down. Renders nothing
// when the build has no continuity verdict yet.
interface Props {
  trend: string | null;
}

const { trend } = Astro.props;
const arrow =
  trend === 'rising'
    ? 'M1 11 L7 5 M7 5 L7 9 M7 5 L3 5'
    : trend === 'fading'
      ? 'M1 1 L7 7 M7 7 L7 3 M7 7 L3 7'
      : null;
---

{
  trend && (
    <span class={`trend trend-${trend}`} title="Size trend across builds">
      {arrow && (
        <svg viewBox="0 0 12 12" aria-hidden="true">
          <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" />
        </svg>
      )}
      {trend}
    </span>
  )
}

<style>
  .trend {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.05rem 0.55rem;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .trend svg {
    width: 11px;
    height: 11px;
  }
  .trend-rising,
  .trend-new {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .trend-steady,
  .trend-fading {
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .trend-fading {
    opacity: 0.7;
  }
</style>
